  "decisions": [
    {
      "id": "standing",
      "question": "Is the action reviewable and does this person have standing?",
      "hit_policy": "FIRST",
      "inputs": [
        {
          "name": "action_type",
          "label": "Administrator action",
          "type": "string"
        },
        {
          "name": "person_role",
          "label": "Person's role",
          "type": "string"
        },
        {
          "name": "aggrieved",
          "label": "Aggrieved?",
          "type": "boolean"
        }
      ],
      "outputs": [
        {
          "name": "reviewable",
          "label": "Reviewable",
          "type": "boolean"
        },
        {
          "name": "has_standing",
          "label": "Has standing",
          "type": "boolean"
        }
      ],
      "rules": [
        {
          "when": [
            "\"disapproval\",\"conditional_approval\",\"variance_disapproval\",\"status_determination\",\"general_permit_decision\",\"enforcement_decision\",\"failure_to_act\"",
            "\"applicant\",\"permitted_operator\",\"general_permit_subject\"",
            "true"
          ],
          "then": [
            "true",
            "true"
          ],
          "source": {
            "section": "17-211",
            "subsection": "B",
            "quote": "who is aggrieved by any action or inaction under subsections (A)(i) through (vii) has standing to seek review"
          }
        },
        {
          "when": [
            "\"approval_downstream_issue\"",
            "\"downstream_owner\"",
            "true"
          ],
          "then": [
            "true",
            "true"
          ],
          "source": {
            "section": "17-211",
            "subsection": "B",
            "quote": "Any downstream owner who is aggrieved by an action under subsection (A)(viii) has standing to seek review under this section."
          }
        },
        {
          "when": [
            "not(\"other\")",
            "-",
            "-"
          ],
          "then": [
            "true",
            "false"
          ],
          "source": {
            "section": "17-211",
            "subsection": "A",
            "quote": "Any of the following actions by the administrator may be reviewed"
          }
        },
        {
          "when": [
            "-",
            "-",
            "-"
          ],
          "then": [
            "false",
            "false"
          ],
          "source": {
            "section": "17-211",
            "subsection": "A",
            "quote": "Any of the following actions by the administrator may be reviewed"
          }
        }
      ]
    }
  ],

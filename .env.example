# Copy to .env and fill in what you use.  Everything is optional.

# Port for the dashboard
LEXFLOW_PORT=8000
# A name for this machine; stored with every row you share through Turso
LEXFLOW_ORIGIN=my-laptop

# Local models.  Inside Docker the default is the bundled Ollama service (profile "llm").
# On a Mac, run Ollama natively for GPU speed and point the container at it:
# OLLAMA_URL=http://host.docker.internal:11434
# Two different model families; bigger is better if you have the memory (e.g. qwen3:8b + gemma3:12b)
LEXFLOW_MODEL_A=qwen3:1.7b
LEXFLOW_MODEL_B=gemma3:1b

# Decision models (Ollama's /v1/systemone; docs/design/decision-models.md).  All optional.
# LEXFLOW_DECIDE=0                      # 1 turns on the live uses (local step kinds); 0 (default) keeps the rules alone
# LEXFLOW_DECIDE_URL=http://ollama:11434  # the Ollama that serves decisions (tev1 needs >= 0.40.4); default OLLAMA_URL
# LEXFLOW_DECIDE_MODEL=tev1:0.8b        # the decision model to ask (the first tev1/nimble tag pulled, if not this one)
# LEXFLOW_DECIDE_FALLBACK=qwen3:1.7b    # the chat model that answers the same questions when no decision model is pulled

# The compute pool (docs/compute.md): more than one Ollama.  Unset = one Ollama at OLLAMA_URL, no pool.
# name=url, then |options: threads=N (num_thread), max=N (calls at once; 1 on a CPU node), status=URL (the node's
# host-status JSON), embed (this node embeds), models=a+b (wanted there), tags=a+b, priority=0..100, part_time.
# URLs must be compose service names, localhost, 100.64.0.0/10, 10.231.0.0/16, fd7a:115c:a1e0::/48, *.ts.net or
# *.mesh.lexipedia.xyz; anything else is refused.  Three nodes this box can reach today: the compose Ollama, the
# second (0.40.4, decision models) server, and shop on the tailnet (Ollama 0.40.6; no models pulled yet: pull them
# from the Compute page).
# LEXFLOW_LLM_NODES=local=http://ollama:11434|embed, ollama2=http://lexflow-ollama2:11434|max=1, shop=http://100.98.35.19:11434|threads=7|max=1|models=qwen3:8b+nomic-embed-text
# LEXFLOW_EMBED_URL=http://ollama:11434   # the one node that embeds (default: the node marked |embed, else the first)
# LEXFLOW_LLM_WAIT=900                    # seconds a call waits for a free slot before the job fails
# LEXFLOW_LLM_POLL=15                     # seconds between health checks of an online node
# LEXFLOW_LLM_FANOUT=4                    # most worker threads a batch fans out over the pool
# The overlay as the node list instead of the line above (docs/design/open-overlay.md §3.5): netbird | headscale | none
# LEXFLOW_OVERLAY=none
# LEXFLOW_OVERLAY_URL=https://net.lexipedia.xyz:8443
# LEXFLOW_OVERLAY_TOKEN=...               # a read-only service user's token; the server reads GET /api/peers, nothing else
# LEXFLOW_OVERLAY_COMPUTE_GROUP=compute
# LEXFLOW_OVERLAY_RANGE=10.231.0.0/16
# LEXFLOW_OVERLAY_POLL=60

# Sharing.  Turso cloud: create a database and a token with the Turso CLI
#   turso db create lexflow && turso db show lexflow --url && turso db tokens create lexflow
# TURSO_DATABASE_URL=libsql://lexflow-<your-org>.turso.io
# TURSO_AUTH_TOKEN=...
# Or the bundled libSQL server (docker compose --profile shared up -d):
# TURSO_DATABASE_URL=http://libsql:8080
# It is published on this machine only (127.0.0.1:8081).  Whoever can write the shared database can change what a
# pull brings into every copy, so never let networks you do not trust reach it.  To share it on a network you
# control, set LIBSQL_BIND to that network's interface address and give the server a key: SQLD_AUTH_JWT_KEY is the
# Ed25519 public key (URL-safe base64) that checks the JWT each copy sends as TURSO_AUTH_TOKEN (set it here and
# uncomment its line under the libsql service in docker-compose.yml).
# LIBSQL_BIND=127.0.0.1
# LIBSQL_PORT=8081
# SQLD_AUTH_JWT_KEY=...

# Publishing to Lexipedia (a DokuWiki bot account; the wiki needs remote=1 and remoteuser=@bots)
# DOKUWIKI_URL=https://lexipedia.xyz
# DOKUWIKI_TOKEN=...
# or, for lexipedia.xyz, just: LEXIPEDIA_TOKEN=...
# Where readers report an error: an e-mail address or a URL, shown on lexflow:method.  Every page links that page,
# so the publish step writes nothing until this is set to a real address.  The example below is refused as it stands,
# like any address on a reserved name (example.com/.org/.net, .example, .invalid, .test, .localhost, .local,
# localhost, an IP address): replace it with the address readers should write to.
# LEXFLOW_CORRECTIONS=corrections@example.org

# SearXNG (docker compose --profile search up -d)
# SEARXNG_URL=http://searxng:8080
# SEARXNG_SECRET=<64 random characters>

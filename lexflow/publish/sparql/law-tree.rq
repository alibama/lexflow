PREFIX lx: <https://lexipedia.wikibase.cloud/entity/>
PREFIX lxt: <https://lexipedia.wikibase.cloud/prop/direct/>
PREFIX lxp: <https://lexipedia.wikibase.cloud/prop/>
PREFIX lxps: <https://lexipedia.wikibase.cloud/prop/statement/>
PREFIX lxpq: <https://lexipedia.wikibase.cloud/prop/qualifier/>
PREFIX lxpr: <https://lexipedia.wikibase.cloud/prop/reference/>
PREFIX lxn: <https://lexipedia.wikibase.cloud/prop/direct-normalized/>
PREFIX wikibase: <http://wikiba.se/ontology#>
PREFIX schema: <http://schema.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
# question: the ancestors of Va. Code § 2.2-3704 up to the code, with their unit levels (any law or unit too: section=lexflow:unit:jpn:405ac0000000088)
# params: section=lexflow:statute:va:2.2-3704
# status: 15 Oct 2026: local 5 rows (code, title, subtitle, part, chapter); live 0 (the part-of chain waits for pass 2)
SELECT ?ancestor ?ancestorLabel ?level ?sort ?heading WHERE {
  VALUES ?section { lx:{Q:lexflow:statute:va:2.2-3704} }
  ?section lxt:{P:part of}+ ?ancestor .
  ?ancestor rdfs:label ?ancestorLabel .
  FILTER(lang(?ancestorLabel) = "en")
  OPTIONAL { ?ancestor lxt:{P:unit level} ?lv . ?lv rdfs:label ?level . FILTER(lang(?level) = "en") }
  OPTIONAL { ?ancestor lxt:{P:sort key} ?sort }
  OPTIONAL { ?ancestor lxt:{P:heading text} ?heading }
}
ORDER BY ?sort

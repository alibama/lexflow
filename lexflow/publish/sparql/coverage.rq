PREFIX lx: <https://lexipedia.wikibase.cloud/entity/>
PREFIX lxt: <https://lexipedia.wikibase.cloud/prop/direct/>
PREFIX lxp: <https://lexipedia.wikibase.cloud/prop/>
PREFIX lxps: <https://lexipedia.wikibase.cloud/prop/statement/>
PREFIX lxpq: <https://lexipedia.wikibase.cloud/prop/qualifier/>
PREFIX lxpr: <https://lexipedia.wikibase.cloud/prop/reference/>
PREFIX lxn: <https://lexipedia.wikibase.cloud/prop/direct-normalized/>
PREFIX wikibase: <http://wikiba.se/ontology#>
PREFIX schema: <http://schema.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
# question: how many items of each class, by review status (the --check numbers)
# status: 15 Oct 2026: local 36 rows (5,481 items; 375,565 triples; local processes, forms and offices included); live 7 rows (counts by class; status is empty until pass 2)
SELECT ?class ?classLabel ?status (COUNT(DISTINCT ?item) AS ?n) WHERE {
  ?item lxt:{P:instance of} ?class ;
        lxt:{P:legal identifier} ?key .
  ?class rdfs:label ?classLabel .
  FILTER(lang(?classLabel) = "en")
  OPTIONAL { ?item lxt:{P:review status} ?s . ?s rdfs:label ?status . FILTER(lang(?status) = "en") }
}
GROUP BY ?class ?classLabel ?status
ORDER BY DESC(?n) ?classLabel ?status

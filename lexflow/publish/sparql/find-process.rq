PREFIX lx: <https://lexipedia.wikibase.cloud/entity/>
PREFIX lxt: <https://lexipedia.wikibase.cloud/prop/direct/>
PREFIX lxp: <https://lexipedia.wikibase.cloud/prop/>
PREFIX lxps: <https://lexipedia.wikibase.cloud/prop/statement/>
PREFIX lxpq: <https://lexipedia.wikibase.cloud/prop/qualifier/>
PREFIX lxpr: <https://lexipedia.wikibase.cloud/prop/reference/>
PREFIX lxn: <https://lexipedia.wikibase.cloud/prop/direct-normalized/>
PREFIX wikibase: <http://wikiba.se/ontology#>
PREFIX schema: <http://schema.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
# question: find a process by words in its label, aliases or plain-language question (CONTAINS; on the live service SERVICE wikibase:mwapi with Search is the faster form)
# params: text=records
# status: 15 Oct 2026: local 85 rows (labels, aliases and questions, local processes included); live 23 rows (labels only until pass 2)
SELECT DISTINCT ?process ?processLabel ?jurisdictionLabel ?matched WHERE {
  VALUES ?text { "records" }
  ?process lxt:{P:instance of} lx:{Q:legal process} ;
           rdfs:label ?processLabel .
  FILTER(lang(?processLabel) = "en")
  ?process rdfs:label|skos:altLabel|lxt:{P:question asked} ?matched .
  FILTER(CONTAINS(LCASE(STR(?matched)), LCASE(?text)))
  OPTIONAL { ?process lxt:{P:applies to jurisdiction} ?j . ?j rdfs:label ?jurisdictionLabel . FILTER(lang(?jurisdictionLabel) = "en") }
}
ORDER BY ?jurisdictionLabel ?processLabel
LIMIT 200

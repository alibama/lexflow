PREFIX lx: <https://lexipedia.wikibase.cloud/entity/>
PREFIX lxt: <https://lexipedia.wikibase.cloud/prop/direct/>
PREFIX lxp: <https://lexipedia.wikibase.cloud/prop/>
PREFIX lxps: <https://lexipedia.wikibase.cloud/prop/statement/>
PREFIX lxpq: <https://lexipedia.wikibase.cloud/prop/qualifier/>
PREFIX lxpr: <https://lexipedia.wikibase.cloud/prop/reference/>
PREFIX lxn: <https://lexipedia.wikibase.cloud/prop/direct-normalized/>
PREFIX wikibase: <http://wikiba.se/ontology#>
PREFIX schema: <http://schema.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
# question: processes by topic and audience, with their plain-language question and review status
# params: topic=lexflow:vocab:topic:public-records, audience=
# status: 15 Oct 2026: local 58 rows (41 state models and 17 researched local processes on public records); live 0 (topic, audience and review status wait for pass 2)
SELECT ?process ?processLabel ?jurisdictionLabel ?topicLabel ?audienceLabel ?question ?status WHERE {
  VALUES ?topic { lx:{Q:lexflow:vocab:topic:public-records} }
  VALUES ?audience { UNDEF }
  ?process lxt:{P:topic} ?topic ;
           rdfs:label ?processLabel .
  FILTER(lang(?processLabel) = "en")
  ?topic rdfs:label ?topicLabel . FILTER(lang(?topicLabel) = "en")
  OPTIONAL { ?process lxt:{P:audience} ?audience . ?audience rdfs:label ?audienceLabel . FILTER(lang(?audienceLabel) = "en") }
  OPTIONAL { ?process lxt:{P:applies to jurisdiction} ?j . ?j rdfs:label ?jurisdictionLabel . FILTER(lang(?jurisdictionLabel) = "en") }
  OPTIONAL { ?process lxt:{P:question asked} ?question }
  OPTIONAL { ?process lxt:{P:review status} ?s . ?s rdfs:label ?status . FILTER(lang(?status) = "en") }
}
ORDER BY ?jurisdictionLabel ?processLabel

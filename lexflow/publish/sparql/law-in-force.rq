PREFIX lx: <https://lexipedia.wikibase.cloud/entity/>
PREFIX lxt: <https://lexipedia.wikibase.cloud/prop/direct/>
PREFIX lxp: <https://lexipedia.wikibase.cloud/prop/>
PREFIX lxps: <https://lexipedia.wikibase.cloud/prop/statement/>
PREFIX lxpq: <https://lexipedia.wikibase.cloud/prop/qualifier/>
PREFIX lxpr: <https://lexipedia.wikibase.cloud/prop/reference/>
PREFIX lxn: <https://lexipedia.wikibase.cloud/prop/direct-normalized/>
PREFIX wikibase: <http://wikiba.se/ontology#>
PREFIX schema: <http://schema.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
# question: the sections of a chapter in force on a given date (no effective dates means always in force)
# params: unit=lexflow:unit:va:t2.2-sii-pb-c37, date=2026-10-15
# status: 15 Oct 2026: local 11 rows (every section of the chapter the build holds); live 0 (units and effective dates wait for pass 2)
SELECT ?section ?sectionLabel ?from ?until ?sort WHERE {
  VALUES ?unit { lx:{Q:lexflow:unit:va:t2.2-sii-pb-c37} }
  VALUES ?date { "2026-10-15T00:00:00Z"^^xsd:dateTime }
  ?section lxt:{P:part of} ?unit ;
           lxt:{P:instance of} lx:{Q:statute or legal provision} ;
           rdfs:label ?sectionLabel .
  FILTER(lang(?sectionLabel) = "en")
  OPTIONAL { ?section lxt:{P:effective date} ?from }
  OPTIONAL { ?section lxt:{P:effective until} ?until }
  OPTIONAL { ?section lxt:{P:sort key} ?sort }
  FILTER(!BOUND(?from) || ?from <= ?date)
  FILTER(!BOUND(?until) || ?until > ?date)
}
ORDER BY ?sort ?sectionLabel

        </inputEntry>
        <outputEntry id="nr10_out0">
          <text>false</text>
        </outputEntry>
        <outputEntry id="nr10_out1">
          <text>null</text>
        </outputEntry>
        <outputEntry id="nr10_out2">
          <text>"-"</text>
        </outputEntry>
        <outputEntry id="nr10_out3">
          <text>"No numeric limit in ch. 16 for this context (review)"</text>
        </outputEntry>
        <annotationEntry>
          <text>-</text>
        </annotationEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="d_vehicle_limit" name="Motor vehicle sound limit">
    <description>Grounded in Charlottesville City Code § 16-9(a)</description>
    <extensionElements>
      <lex:grounding>
        <lex:source citation="Charlottesville City Code § 16-9(a)" section="16-9" subsection="a" code="Charlottesville City Code" jurisdiction="va/charlottesville" grounding="explicit" url="https://library.municode.com/va/charlottesville/codes/code_of_ordinances">
          <lex:quote>when measured at a distance of fifty (50) feet or more, exceeds the level set forth in the following table:</lex:quote>
        </lex:source>
      </lex:grounding>
    </extensionElements>
    <question>What is the maximum sound level for this vehicle on this road (measured at 50 feet or more)?</question>
    <decisionTable id="d_vehicle_limit_table" hitPolicy="UNIQUE">
      <input id="vi_class" label="Vehicle class">
        <inputExpression id="vi_class_expr" typeRef="string">
          <text>vehicle_class</text>
        </inputExpression>
        <inputValues id="vi_class_values">
          <text>"heavy_6000_plus","motorcycle","other"</text>
        </inputValues>
      </input>
      <input id="vi_speed" label="Speed limit (mph)">
        <inputExpression id="vi_speed_expr" typeRef="number">
          <text>speed_limit_mph</text>
        </inputExpression>
      </input>
      <input id="vi_interstate" label="Interstate motor carrier?">
        <inputExpression id="vi_interstate_expr" typeRef="boolean">
          <text>interstate_carrier</text>
        </inputExpression>
      </input>
      <output id="vo_applies" label="Limit applies" name="limit_applies" typeRef="boolean"/>
      <output id="vo_dba" label="Limit dB(A)" name="limit_dba" typeRef="number"/>
      <annotation name="Source"/>
      <rule id="vr1">
        <description>Charlottesville City Code § 16-9(b)</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Charlottesville City Code § 16-9(b)" section="16-9" subsection="b" code="Charlottesville City Code" jurisdiction="va/charlottesville" grounding="explicit" url="https://library.municode.com/va/charlottesville/codes/code_of_ordinances">
              <lex:quote>This section shall not apply to any motor carrier vehicle engaged in interstate commerce.</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="vr1_in0">
          <text>-</text>
        </inputEntry>
        <inputEntry id="vr1_in1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="vr1_in2">
          <text>true</text>
        </inputEntry>
        <outputEntry id="vr1_out0">
          <text>false</text>
        </outputEntry>
        <outputEntry id="vr1_out1">
          <text>null</text>
        </outputEntry>
        <annotationEntry>
          <text>Charlottesville City Code § 16-9(b)</text>
        </annotationEntry>
      </rule>
      <rule id="vr2">
        <description>Charlottesville City Code § 16-9(a)</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Charlottesville City Code § 16-9(a)" section="16-9" subsection="a" code="Charlottesville City Code" jurisdiction="va/charlottesville" grounding="explicit" url="https://library.municode.com/va/charlottesville/codes/code_of_ordinances"/>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="vr2_in0">
          <text>"heavy_6000_plus"</text>
        </inputEntry>
        <inputEntry id="vr2_in1">
          <text>&lt;= 35</text>
        </inputEntry>
        <inputEntry id="vr2_in2">
          <text>false</text>
        </inputEntry>
        <outputEntry id="vr2_out0">
          <text>true</text>
        </outputEntry>
        <outputEntry id="vr2_out1">
          <text>86</text>
        </outputEntry>
        <annotationEntry>
          <text>Charlottesville City Code § 16-9(a)</text>
        </annotationEntry>
      </rule>
      <rule id="vr3">
        <description>Charlottesville City Code § 16-9(a)</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Charlottesville City Code § 16-9(a)" section="16-9" subsection="a" code="Charlottesville City Code" jurisdiction="va/charlottesville" grounding="explicit" url="https://library.municode.com/va/charlottesville/codes/code_of_ordinances"/>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="vr3_in0">
          <text>"heavy_6000_plus"</text>
        </inputEntry>
        <inputEntry id="vr3_in1">
          <text>&gt; 35</text>
        </inputEntry>
        <inputEntry id="vr3_in2">
          <text>false</text>
        </inputEntry>
        <outputEntry id="vr3_out0">
          <text>true</text>
        </outputEntry>
        <outputEntry id="vr3_out1">
          <text>90</text>
        </outputEntry>
        <annotationEntry>
          <text>Charlottesville City Code § 16-9(a)</text>
        </annotationEntry>
      </rule>
      <rule id="vr4">
        <description>Charlottesville City Code § 16-9(a)</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Charlottesville City Code § 16-9(a)" section="16-9" subsection="a" code="Charlottesville City Code" jurisdiction="va/charlottesville" grounding="explicit" url="https://library.municode.com/va/charlottesville/codes/code_of_ordinances"/>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="vr4_in0">
          <text>"motorcycle"</text>
        </inputEntry>
        <inputEntry id="vr4_in1">
          <text>&lt;= 35</text>
        </inputEntry>
        <inputEntry id="vr4_in2">
          <text>false</text>
        </inputEntry>
        <outputEntry id="vr4_out0">
          <text>true</text>
        </outputEntry>
        <outputEntry id="vr4_out1">
          <text>82</text>
        </outputEntry>
        <annotationEntry>
          <text>Charlottesville City Code § 16-9(a)</text>
        </annotationEntry>
      </rule>
      <rule id="vr5">
        <description>Charlottesville City Code § 16-9(a)</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Charlottesville City Code § 16-9(a)" section="16-9" subsection="a" code="Charlottesville City Code" jurisdiction="va/charlottesville" grounding="explicit" url="https://library.municode.com/va/charlottesville/codes/code_of_ordinances"/>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="vr5_in0">
          <text>"motorcycle"</text>
        </inputEntry>
        <inputEntry id="vr5_in1">
          <text>&gt; 35</text>
        </inputEntry>
        <inputEntry id="vr5_in2">
          <text>false</text>
        </inputEntry>
        <outputEntry id="vr5_out0">

<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:lex="https://lexipedia.xyz/ns/lex/1.0" xmlns:spiffworkflow="http://spiffworkflow.org/bpmn/schema/1.0/core" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="defs_va_albemarle_17_211" name="Review of administrator's action; judicial review (VESMP)" targetNamespace="https://lexipedia.xyz/ns/process/va_albemarle_17_211" exporter="lexflow" exporterVersion="0.3.0">
  <bpmn:message id="msg_request_for_hearing" name="Request for hearing"/>
  <bpmn:message id="msg_written_decision" name="Written decision"/>
  <bpmn:message id="msg_petition_for_appeal" name="Petition for appeal"/>
  <bpmn:message id="msg_notice_of_appeal" name="Notice of appeal"/>
  <bpmn:message id="msg_notice_of_action" name="Notice of action"/>
  <bpmn:message id="msg_grounds_for_appeal" name="Grounds for appeal"/>
  <bpmn:message id="msg_extension_request" name="Extension request"/>
  <bpmn:message id="msg_hearing_record" name="Hearing record"/>
  <bpmn:collaboration id="collab_va_albemarle_17_211" name="Review of administrator's action; judicial review (VESMP)">
    <bpmn:documentation textFormat="text/plain">How a person aggrieved by a VESMP administrator decision gets a County hearing and then judicial review: 30-day filing windows, a soft 30-day hearing target, and appeal to circuit court.</bpmn:documentation>
    <bpmn:extensionElements>
      <lex:model id="va-albemarle-17-211" jurisdiction="va/albemarle_county" jurisdictionName="Albemarle County, Virginia" jurisdictionQid="Q488653" reviewStatus="machine-checked" method="gold-manual">
        <lex:gap>Subsection E is absent from the LOCUS chunks (letters jump D to F); the written decision is presupposed by subsection F.</lex:gap>
        <lex:gap>Who determines standing is not stated (assigned to the hearing officer).</lex:gap>
        <lex:gap>Consequence of an untimely request is not stated.</lex:gap>
        <lex:actor id="appellant" name="Aggrieved person (appellant)" kind="private-party"/>
        <lex:actor id="county" name="Albemarle County" kind="public-body" wikidata="Q488653"/>
        <lex:actor id="administrator" name="VESMP administrator" kind="official"/>
        <lex:actor id="clerk" name="Clerk of the Board of Supervisors" kind="official"/>
        <lex:actor id="hearing_officer" name="Director of Community Development (hearing officer)" kind="official"/>
        <lex:actor id="circuit_court" name="Circuit court" kind="court"/>
      </lex:model>
    </bpmn:extensionElements>
    <bpmn:participant id="p_appellant" name="Appellant (aggrieved person)" processRef="proc_appellant">
      <bpmn:extensionElements>
        <lex:actor ref="appellant"/>
      </bpmn:extensionElements>
    </bpmn:participant>
    <bpmn:participant id="p_county" name="Albemarle County (VESMP authority)" processRef="proc_county">
      <bpmn:extensionElements>
        <lex:actor ref="county" wikidata="Q488653"/>
      </bpmn:extensionElements>
    </bpmn:participant>
    <bpmn:participant id="p_court" name="Circuit court">
      <bpmn:extensionElements>
        <lex:actor ref="circuit_court"/>
      </bpmn:extensionElements>
    </bpmn:participant>
    <bpmn:messageFlow id="m1" name="Notice of action" sourceRef="c_notify" targetRef="p_appellant" messageRef="msg_notice_of_action"/>
    <bpmn:messageFlow id="m2" name="Request for hearing" sourceRef="a_file" targetRef="c_request" messageRef="msg_request_for_hearing"/>
    <bpmn:messageFlow id="m3" name="Grounds" sourceRef="p_appellant" targetRef="c_await_grounds" messageRef="msg_grounds_for_appeal"/>
    <bpmn:messageFlow id="m4" name="Extension request" sourceRef="p_appellant" targetRef="ph_ext" messageRef="msg_extension_request"/>
    <bpmn:messageFlow id="m5" name="Written decision" sourceRef="c_decide" targetRef="a_wait" messageRef="msg_written_decision"/>
    <bpmn:messageFlow id="m6" name="Petition for appeal" sourceRef="a_appeal" targetRef="p_court" messageRef="msg_petition_for_appeal"/>
    <bpmn:messageFlow id="m7" name="Notice of appeal" sourceRef="a_notify" targetRef="c_jr_notice" messageRef="msg_notice_of_appeal"/>
    <bpmn:messageFlow id="m8" name="Hearing record" sourceRef="c_transmit" targetRef="p_court" messageRef="msg_hearing_record"/>
  </bpmn:collaboration>
  <bpmn:process id="proc_appellant" name="Appellant" isExecutable="true">
    <bpmn:startEvent id="a_start" name="Aggrieved by action or inaction">
      <bpmn:documentation textFormat="text/plain">Albemarle County Code § 17-211: “Any person aggrieved by an action or inaction of the administrator may request that the County review the action or inaction”</bpmn:documentation>
      <bpmn:extensionElements>
        <lex:grounding>
          <lex:source citation="Albemarle County Code § 17-211" section="17-211" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="explicit" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
            <lex:quote>Any person aggrieved by an action or inaction of the administrator may request that the County review the action or inaction</lex:quote>
          </lex:source>
        </lex:grounding>
      </bpmn:extensionElements>
      <bpmn:outgoing>a1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="a_decide" name="Decide whether to ask for County review">
      <bpmn:documentation textFormat="text/plain">Albemarle County Code § 17-211(C): “may request in writing that the County conduct a hearing”</bpmn:documentation>
      <bpmn:extensionElements>
        <lex:grounding>
          <lex:source citation="Albemarle County Code § 17-211(C)" section="17-211" subsection="C" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="explicit" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
            <lex:quote>may request in writing that the County conduct a hearing</lex:quote>
          </lex:source>
        </lex:grounding>
        <lex:norm modality="permission" bearer="appellant"/>
      </bpmn:extensionElements>
      <bpmn:incoming>a1</bpmn:incoming>
      <bpmn:outgoing>a2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="a_window" name="30-day window closes" attachedToRef="a_decide" cancelActivity="true">
      <bpmn:documentation textFormat="text/plain">Albemarle County Code § 17-211(C)(1): “Within 30 days after the date of notice of the action”
Albemarle County Code § 17-211(C)(2): “Within 30 days after the date by which the administrator was required to act but failed to do so”
Albemarle County Code § 17-211(C)(3): “Within 30 days after the date of the administrator's approval of the ESM plan or land-disturbance permit”</bpmn:documentation>
      <bpmn:extensionElements>
        <lex:grounding>
          <lex:source citation="Albemarle County Code § 17-211(C)(1)" section="17-211" subsection="C.1" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="explicit" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
            <lex:quote>Within 30 days after the date of notice of the action</lex:quote>
          </lex:source>
          <lex:source citation="Albemarle County Code § 17-211(C)(2)" section="17-211" subsection="C.2" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="explicit" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
            <lex:quote>Within 30 days after the date by which the administrator was required to act but failed to do so</lex:quote>
          </lex:source>
          <lex:source citation="Albemarle County Code § 17-211(C)(3)" section="17-211" subsection="C.3" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="explicit" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
            <lex:quote>Within 30 days after the date of the administrator's approval of the ESM plan or land-disturbance permit</lex:quote>
          </lex:source>
        </lex:grounding>
        <lex:deadline kind="duration" value="P30D" anchor="notice date / required-action date / approval date" strict="true"/>
      </bpmn:extensionElements>
      <bpmn:outgoing>a5</bpmn:outgoing>
      <bpmn:timerEventDefinition id="a_window_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="a_lapsed" name="County review lapsed">
      <bpmn:documentation textFormat="text/plain">Albemarle County Code § 17-211(C) [implied]: “provided that the request is filed with the clerk of the board of supervisors”</bpmn:documentation>
      <bpmn:extensionElements>
        <lex:grounding>
          <lex:source citation="Albemarle County Code § 17-211(C)" section="17-211" subsection="C" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="implied" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
            <lex:quote>provided that the request is filed with the clerk of the board of supervisors</lex:quote>
          </lex:source>
        </lex:grounding>
      </bpmn:extensionElements>
      <bpmn:incoming>a5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="a_gw" name="Request review?" default="a4" gatewayDirection="Diverging">
      <bpmn:incoming>a2</bpmn:incoming>
      <bpmn:outgoing>a3</bpmn:outgoing>
      <bpmn:outgoing>a4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="a_no" name="No review requested">
      <bpmn:incoming>a4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="a_file" name="File written request stating grounds" messageRef="msg_request_for_hearing">
      <bpmn:documentation textFormat="text/plain">Albemarle County Code § 17-211(C): “provided that the request is filed with the clerk of the board of supervisors”
Albemarle County Code § 17-211(C): “The request must specify the grounds for the appeal.”</bpmn:documentation>
      <bpmn:extensionElements>
        <lex:grounding>
          <lex:source citation="Albemarle County Code § 17-211(C)" section="17-211" subsection="C" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="explicit" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
            <lex:quote>provided that the request is filed with the clerk of the board of supervisors</lex:quote>
          </lex:source>
          <lex:source citation="Albemarle County Code § 17-211(C)" section="17-211" subsection="C" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="explicit" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
            <lex:quote>The request must specify the grounds for the appeal.</lex:quote>
          </lex:source>
        </lex:grounding>
        <lex:norm modality="permission" bearer="appellant"/>
      </bpmn:extensionElements>
      <bpmn:incoming>a3</bpmn:incoming>
      <bpmn:outgoing>a6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="a_wait" name="Written decision received">
      <bpmn:documentation textFormat="text/plain">Albemarle County Code § 17-211(F) [implied]: “the hearing officer's written decision”</bpmn:documentation>
      <bpmn:extensionElements>
        <lex:grounding>
          <lex:source citation="Albemarle County Code § 17-211(F)" section="17-211" subsection="F" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="implied" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
            <lex:quote>the hearing officer's written decision</lex:quote>
            <lex:note>Subsection E is absent from the LOCUS chunks (letters jump D to F); the written decision is presupposed by subsection F.</lex:note>
          </lex:source>
        </lex:grounding>
      </bpmn:extensionElements>
      <bpmn:incoming>a6</bpmn:incoming>
      <bpmn:outgoing>a7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="a_wait_def" messageRef="msg_written_decision"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="a_decide_jr" name="Decide whether to seek judicial review">
      <bpmn:documentation textFormat="text/plain">Albemarle County Code § 17-211(F): “A final decision by the hearing officer under this section may be subject to judicial review”</bpmn:documentation>
      <bpmn:extensionElements>
        <lex:grounding>
          <lex:source citation="Albemarle County Code § 17-211(F)" section="17-211" subsection="F" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="explicit" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
            <lex:quote>A final decision by the hearing officer under this section may be subject to judicial review</lex:quote>
          </lex:source>
        </lex:grounding>
        <lex:norm modality="right" bearer="appellant"/>
      </bpmn:extensionElements>
      <bpmn:incoming>a7</bpmn:incoming>
      <bpmn:outgoing>a8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="a_jr_window" name="30 days after decision" attachedToRef="a_decide_jr" cancelActivity="true">
      <bpmn:documentation textFormat="text/plain">Albemarle County Code § 17-211(F): “within 30 days after the date of the hearing officer's written decision”
Va. Code § 62.1-44.15:46: “within 30 days from the date of any written decision adversely affecting the rights, duties, or privileges”</bpmn:documentation>
      <bpmn:extensionElements>
        <lex:grounding>
          <lex:source citation="Albemarle County Code § 17-211(F)" section="17-211" subsection="F" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="explicit" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
            <lex:quote>within 30 days after the date of the hearing officer's written decision</lex:quote>
          </lex:source>
          <lex:source citation="Va. Code § 62.1-44.15:46" section="62.1-44.15:46" code="Code of Virginia" jurisdiction="va" grounding="explicit" url="https://law.lis.virginia.gov/vacode/62.1-44.15:46/">
            <lex:quote>within 30 days from the date of any written decision adversely affecting the rights, duties, or privileges</lex:quote>
          </lex:source>
        </lex:grounding>
        <lex:deadline kind="duration" value="P30D" anchor="date of the hearing officer's written decision" strict="true"/>
      </bpmn:extensionElements>
      <bpmn:outgoing>a14</bpmn:outgoing>
      <bpmn:timerEventDefinition id="a_jr_window_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="a_time_barred" name="Judicial review time-barred">
      <bpmn:documentation textFormat="text/plain">Albemarle County Code § 17-211(F) [implied]: “provided that an appeal is filed by the person aggrieved in the circuit court within 30 days after the date of the hearing officer's written decision”</bpmn:documentation>
      <bpmn:extensionElements>
        <lex:grounding>
          <lex:source citation="Albemarle County Code § 17-211(F)" section="17-211" subsection="F" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="implied" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
            <lex:quote>provided that an appeal is filed by the person aggrieved in the circuit court within 30 days after the date of the hearing officer's written decision</lex:quote>
          </lex:source>
        </lex:grounding>
      </bpmn:extensionElements>
      <bpmn:incoming>a14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="a_gw2" name="Seek judicial review?" default="a10" gatewayDirection="Diverging">
      <bpmn:incoming>a8</bpmn:incoming>
      <bpmn:outgoing>a9</bpmn:outgoing>
      <bpmn:outgoing>a10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="a_accept" name="Decision accepted">
      <bpmn:incoming>a10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="a_appeal" name="File appeal in circuit court" messageRef="msg_petition_for_appeal">
      <bpmn:documentation textFormat="text/plain">Albemarle County Code § 17-211(F): “provided that an appeal is filed by the person aggrieved in the circuit court within 30 days after the date of the hearing officer's written decision”</bpmn:documentation>
      <bpmn:extensionElements>
        <lex:grounding>
          <lex:source citation="Albemarle County Code § 17-211(F)" section="17-211" subsection="F" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="explicit" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
            <lex:quote>provided that an appeal is filed by the person aggrieved in the circuit court within 30 days after the date of the hearing officer's written decision</lex:quote>
          </lex:source>
        </lex:grounding>
      </bpmn:extensionElements>
      <bpmn:incoming>a9</bpmn:incoming>
      <bpmn:outgoing>a11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="a_notify" name="Notify the County of the appeal" messageRef="msg_notice_of_appeal">
      <bpmn:documentation textFormat="text/plain">Albemarle County Code § 17-211(D)(4) [assumed]: “The recording of the hearing will be transcribed only if judicial review of the decision is sought under subsection (F).”</bpmn:documentation>
      <bpmn:extensionElements>
        <lex:grounding>
          <lex:source citation="Albemarle County Code § 17-211(D)(4)" section="17-211" subsection="D.4" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="assumed" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
            <lex:quote>The recording of the hearing will be transcribed only if judicial review of the decision is sought under subsection (F).</lex:quote>
            <lex:note>How the County learns of the appeal (service of process) is outside § 17-211.</lex:note>
          </lex:source>
        </lex:grounding>
      </bpmn:extensionElements>
      <bpmn:incoming>a11</bpmn:incoming>
      <bpmn:outgoing>a12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:callActivity id="a_jr" name="Judicial review (Va. Code § 62.1-44.15:46)" calledElement="va_62_1_44_15_46_judicial_review">
      <bpmn:documentation textFormat="text/plain">Albemarle County Code § 17-211(F): “Judicial review will be conducted as provided in Virginia Code § 62.1-44.15:46.”
Va. Code § 62.1-44.15:46: “A final decision by a locality, when serving as a VESMP authority, shall be subject to judicial review”</bpmn:documentation>
      <bpmn:extensionElements>
        <lex:grounding>
          <lex:source citation="Albemarle County Code § 17-211(F)" section="17-211" subsection="F" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="explicit" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
            <lex:quote>Judicial review will be conducted as provided in Virginia Code § 62.1-44.15:46.</lex:quote>
          </lex:source>
          <lex:source citation="Va. Code § 62.1-44.15:46" section="62.1-44.15:46" code="Code of Virginia" jurisdiction="va" grounding="explicit" url="https://law.lis.virginia.gov/vacode/62.1-44.15:46/">
            <lex:quote>A final decision by a locality, when serving as a VESMP authority, shall be subject to judicial review</lex:quote>
          </lex:source>
        </lex:grounding>
      </bpmn:extensionElements>
      <bpmn:incoming>a12</bpmn:incoming>
      <bpmn:outgoing>a13</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="a_end" name="Judicial review concluded">
      <bpmn:incoming>a13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="a1" sourceRef="a_start" targetRef="a_decide"/>
    <bpmn:sequenceFlow id="a2" sourceRef="a_decide" targetRef="a_gw"/>
    <bpmn:sequenceFlow id="a3" name="Yes" sourceRef="a_gw" targetRef="a_file">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">request_review</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="a4" name="No" sourceRef="a_gw" targetRef="a_no"/>
    <bpmn:sequenceFlow id="a5" sourceRef="a_window" targetRef="a_lapsed"/>
    <bpmn:sequenceFlow id="a6" sourceRef="a_file" targetRef="a_wait"/>
    <bpmn:sequenceFlow id="a7" sourceRef="a_wait" targetRef="a_decide_jr"/>
    <bpmn:sequenceFlow id="a8" sourceRef="a_decide_jr" targetRef="a_gw2"/>
    <bpmn:sequenceFlow id="a9" name="Yes" sourceRef="a_gw2" targetRef="a_appeal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">seek_judicial_review</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="a10" name="No" sourceRef="a_gw2" targetRef="a_accept"/>
    <bpmn:sequenceFlow id="a11" sourceRef="a_appeal" targetRef="a_notify"/>
    <bpmn:sequenceFlow id="a12" sourceRef="a_notify" targetRef="a_jr"/>
    <bpmn:sequenceFlow id="a13" sourceRef="a_jr" targetRef="a_end"/>
    <bpmn:sequenceFlow id="a14" sourceRef="a_jr_window" targetRef="a_time_barred"/>
  </bpmn:process>
  <bpmn:process id="proc_county" name="Albemarle County: review of administrator's action" isExecutable="true">
    <bpmn:documentation textFormat="text/plain">Albemarle County Code § 17-211 (VESMP appeals).</bpmn:documentation>
    <bpmn:laneSet id="proc_county_lanes">
      <bpmn:lane id="ln_admin" name="VESMP administrator">
        <bpmn:extensionElements>
          <lex:actor ref="administrator"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>c_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_notify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ln_clerk" name="Clerk of the Board of Supervisors">
        <bpmn:extensionElements>
          <lex:actor ref="clerk"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>c_await_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_window</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_lapsed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_grounds_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_await_grounds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_grounds_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_after_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_jr_notice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_transcribe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_transmit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_jr_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_jr_window</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_final</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="ln_ho" name="Hearing officer (Dir. of Community Development)">
        <bpmn:extensionElements>
          <lex:actor ref="hearing_officer"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>c_review_rules</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_standing_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_dismiss</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_phase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_target</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_target_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_decide</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="c_start" name="Reviewable action or failure to act">
      <bpmn:documentation textFormat="text/plain">Albemarle County Code § 17-211(A): “Any of the following actions by the administrator may be reviewed”</bpmn:documentation>
      <bpmn:extensionElements>
        <lex:grounding>
          <lex:source citation="Albemarle County Code § 17-211(A)" section="17-211" subsection="A" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="explicit" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
            <lex:quote>Any of the following actions by the administrator may be reviewed</lex:quote>
          </lex:source>
        </lex:grounding>
      </bpmn:extensionElements>
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="c_notify" name="Give notice of the action" messageRef="msg_notice_of_action">
      <bpmn:documentation textFormat="text/plain">Albemarle County Code § 17-211(C)(1) [implied]: “Within 30 days after the date of notice of the action”</bpmn:documentation>
      <bpmn:extensionElements>
        <lex:grounding>
          <lex:source citation="Albemarle County Code § 17-211(C)(1)" section="17-211" subsection="C.1" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="implied" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
            <lex:quote>Within 30 days after the date of notice of the action</lex:quote>
            <lex:note>Notice is presupposed by the C.1 filing window; notice rules are outside this section.</lex:note>
          </lex:source>
        </lex:grounding>
      </bpmn:extensionElements>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="c_await_request" name="Request within 30 days?" instantiate="false" eventGatewayType="Exclusive" gatewayDirection="Diverging">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="c_request" name="Request for hearing filed">
      <bpmn:documentation textFormat="text/plain">Albemarle County Code § 17-211(C): “may request in writing that the County conduct a hearing, provided that the request is filed with the clerk of the board of supervisors”</bpmn:documentation>
      <bpmn:extensionElements>
        <lex:grounding>
          <lex:source citation="Albemarle County Code § 17-211(C)" section="17-211" subsection="C" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="explicit" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
            <lex:quote>may request in writing that the County conduct a hearing, provided that the request is filed with the clerk of the board of supervisors</lex:quote>
          </lex:source>
        </lex:grounding>
      </bpmn:extensionElements>
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="c_request_def" messageRef="msg_request_for_hearing"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="c_window" name="30 days pass, no request">
      <bpmn:documentation textFormat="text/plain">Albemarle County Code § 17-211(C)(1): “Within 30 days after the date of notice of the action”
Albemarle County Code § 17-211(C)(2): “Within 30 days after the date by which the administrator was required to act but failed to do so”
Albemarle County Code § 17-211(C)(3): “Within 30 days after the date of the administrator's approval of the ESM plan or land-disturbance permit”</bpmn:documentation>
      <bpmn:extensionElements>
        <lex:grounding>
          <lex:source citation="Albemarle County Code § 17-211(C)(1)" section="17-211" subsection="C.1" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="explicit" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
            <lex:quote>Within 30 days after the date of notice of the action</lex:quote>
          </lex:source>
          <lex:source citation="Albemarle County Code § 17-211(C)(2)" section="17-211" subsection="C.2" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="explicit" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
            <lex:quote>Within 30 days after the date by which the administrator was required to act but failed to do so</lex:quote>
          </lex:source>
          <lex:source citation="Albemarle County Code § 17-211(C)(3)" section="17-211" subsection="C.3" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="explicit" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
            <lex:quote>Within 30 days after the date of the administrator's approval of the ESM plan or land-disturbance permit</lex:quote>
          </lex:source>
        </lex:grounding>
        <lex:deadline kind="duration" value="P30D" anchor="notice date / required-action date / approval date" strict="true"/>
      </bpmn:extensionElements>
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
      <bpmn:timerEventDefinition id="c_window_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="c_lapsed" name="Review unavailable (untimely)">
      <bpmn:documentation textFormat="text/plain">Albemarle County Code § 17-211(C) [implied]: “provided that the request is filed with the clerk of the board of supervisors”</bpmn:documentation>
      <bpmn:extensionElements>
        <lex:grounding>
          <lex:source citation="Albemarle County Code § 17-211(C)" section="17-211" subsection="C" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="implied" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
            <lex:quote>provided that the request is filed with the clerk of the board of supervisors</lex:quote>
            <lex:note>The section states the window but not the consequence of missing it.</lex:note>
          </lex:source>
        </lex:grounding>
      </bpmn:extensionElements>
      <bpmn:incoming>f5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="c_grounds_gw" name="Request states grounds?" default="f8" gatewayDirection="Diverging">
      <bpmn:documentation textFormat="text/plain">Albemarle County Code § 17-211(C): “The request must specify the grounds for the appeal.”</bpmn:documentation>
      <bpmn:extensionElements>
        <lex:grounding>
          <lex:source citation="Albemarle County Code § 17-211(C)" section="17-211" subsection="C" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="explicit" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
            <lex:quote>The request must specify the grounds for the appeal.</lex:quote>
          </lex:source>
        </lex:grounding>
      </bpmn:extensionElements>
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="c_await_grounds" name="Grounds supplied">
      <bpmn:documentation textFormat="text/plain">Albemarle County Code § 17-211(C): “The 30-day period within which the hearing is held will not begin unless and until the request specifies the grounds for the appeal.”</bpmn:documentation>
      <bpmn:extensionElements>
        <lex:grounding>
          <lex:source citation="Albemarle County Code § 17-211(C)" section="17-211" subsection="C" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="explicit" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
            <lex:quote>The 30-day period within which the hearing is held will not begin unless and until the request specifies the grounds for the appeal.</lex:quote>
          </lex:source>
        </lex:grounding>
      </bpmn:extensionElements>
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="c_await_grounds_def" messageRef="msg_grounds_for_appeal"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="c_grounds_join" gatewayDirection="Converging">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="c_review_rules" name="Determine reviewability and standing" camunda:decisionRef="d_review_standing">
      <bpmn:documentation textFormat="text/plain">Who decides standing is not stated in § 17-211; placed with the hearing officer (assumption).
Albemarle County Code § 17-211(A): “Any of the following actions by the administrator may be reviewed”
Albemarle County Code § 17-211(B): “has standing to seek review under this section”</bpmn:documentation>
      <bpmn:extensionElements>
        <lex:grounding>
          <lex:source citation="Albemarle County Code § 17-211(A)" section="17-211" subsection="A" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="explicit" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
            <lex:quote>Any of the following actions by the administrator may be reviewed</lex:quote>
          </lex:source>
          <lex:source citation="Albemarle County Code § 17-211(B)" section="17-211" subsection="B" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="explicit" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
            <lex:quote>has standing to seek review under this section</lex:quote>
          </lex:source>
        </lex:grounding>
        <spiffworkflow:calledDecisionId>d_review_standing</spiffworkflow:calledDecisionId>
      </bpmn:extensionElements>
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="c_standing_gw" name="Reviewable and has standing?" default="f13" gatewayDirection="Diverging">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="c_dismiss" name="Not reviewable or no standing">
      <bpmn:documentation textFormat="text/plain">Albemarle County Code § 17-211(B) [implied]: “has standing to seek review under this section”</bpmn:documentation>
      <bpmn:extensionElements>
        <lex:grounding>
          <lex:source citation="Albemarle County Code § 17-211(B)" section="17-211" subsection="B" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="implied" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
            <lex:quote>has standing to seek review under this section</lex:quote>
            <lex:note>Disposition of requests without standing is not specified.</lex:note>
          </lex:source>
        </lex:grounding>
      </bpmn:extensionElements>
      <bpmn:incoming>f13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="c_phase" name="Hold hearing (30-day target)">
      <bpmn:documentation textFormat="text/plain">Albemarle County Code § 17-211(D)(2): “The hearing will be held within 30 days after receipt of the petition requesting a hearing.”</bpmn:documentation>
      <bpmn:extensionElements>
        <lex:grounding>
          <lex:source citation="Albemarle County Code § 17-211(D)(2)" section="17-211" subsection="D.2" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="explicit" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
            <lex:quote>The hearing will be held within 30 days after receipt of the petition requesting a hearing.</lex:quote>
          </lex:source>
        </lex:grounding>
      </bpmn:extensionElements>
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
      <bpmn:startEvent id="ph_start" name="Petition with grounds received">
        <bpmn:outgoing>pf1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="ph_schedule" name="Set a date both parties can attend">
        <bpmn:documentation textFormat="text/plain">Albemarle County Code § 17-211(D)(2): “The hearing will be held on a date and at a time at which both the appellant and the administrator may be present.”</bpmn:documentation>
        <bpmn:extensionElements>
          <lex:grounding>
            <lex:source citation="Albemarle County Code § 17-211(D)(2)" section="17-211" subsection="D.2" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="explicit" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
              <lex:quote>The hearing will be held on a date and at a time at which both the appellant and the administrator may be present.</lex:quote>
            </lex:source>
          </lex:grounding>
          <lex:norm modality="obligation" bearer="hearing_officer"/>
        </bpmn:extensionElements>
        <bpmn:incoming>pf1</bpmn:incoming>
        <bpmn:outgoing>pf2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:boundaryEvent id="ph_ext" name="Appellant asks for extension" attachedToRef="ph_schedule" cancelActivity="false">
        <bpmn:documentation textFormat="text/plain">Albemarle County Code § 17-211(D)(2): “At the request of the appellant, the hearing officer may extend the hearing date beyond the 30-day period.”</bpmn:documentation>
        <bpmn:extensionElements>
          <lex:grounding>
            <lex:source citation="Albemarle County Code § 17-211(D)(2)" section="17-211" subsection="D.2" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="explicit" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
              <lex:quote>At the request of the appellant, the hearing officer may extend the hearing date beyond the 30-day period.</lex:quote>
            </lex:source>
          </lex:grounding>
        </bpmn:extensionElements>
        <bpmn:outgoing>pf4</bpmn:outgoing>
        <bpmn:messageEventDefinition id="ph_ext_def" messageRef="msg_extension_request"/>
      </bpmn:boundaryEvent>
      <bpmn:userTask id="ph_extend" name="Decide whether to extend the date">
        <bpmn:documentation textFormat="text/plain">Albemarle County Code § 17-211(D)(2): “the hearing officer may extend the hearing date beyond the 30-day period”</bpmn:documentation>
        <bpmn:extensionElements>
          <lex:grounding>
            <lex:source citation="Albemarle County Code § 17-211(D)(2)" section="17-211" subsection="D.2" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="explicit" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
              <lex:quote>the hearing officer may extend the hearing date beyond the 30-day period</lex:quote>
            </lex:source>
          </lex:grounding>
          <lex:norm modality="permission" bearer="hearing_officer"/>
        </bpmn:extensionElements>
        <bpmn:incoming>pf4</bpmn:incoming>
        <bpmn:outgoing>pf5</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="ph_ext_end" name="Extension decided">
        <bpmn:incoming>pf5</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:subProcess id="ph_hearing" name="Conduct hearing">
        <bpmn:documentation textFormat="text/plain">Albemarle County Code § 17-211(D)(1): “The hearing before the County will be conducted by the Director of Community Development, who will act as the hearing officer for the County.”</bpmn:documentation>
        <bpmn:extensionElements>
          <lex:grounding>
            <lex:source citation="Albemarle County Code § 17-211(D)(1)" section="17-211" subsection="D.1" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="explicit" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
              <lex:quote>The hearing before the County will be conducted by the Director of Community Development, who will act as the hearing officer for the County.</lex:quote>
            </lex:source>
          </lex:grounding>
        </bpmn:extensionElements>
        <bpmn:incoming>pf2</bpmn:incoming>
        <bpmn:outgoing>pf3</bpmn:outgoing>
        <bpmn:startEvent id="h_start" name="Hearing opens">
          <bpmn:outgoing>hf1</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:userTask id="h_evidence" name="Take evidence from owner, administrator, others">
          <bpmn:documentation textFormat="text/plain">Albemarle County Code § 17-211(D)(3): “evidence presented by the owner, the administrator, and any other person as the hearing officer deems to be necessary for a complete review of the matter”</bpmn:documentation>
          <bpmn:extensionElements>
            <lex:grounding>
              <lex:source citation="Albemarle County Code § 17-211(D)(3)" section="17-211" subsection="D.3" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="explicit" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
                <lex:quote>evidence presented by the owner, the administrator, and any other person as the hearing officer deems to be necessary for a complete review of the matter</lex:quote>
              </lex:source>
            </lex:grounding>
          </bpmn:extensionElements>
          <bpmn:incoming>hf1</bpmn:incoming>
          <bpmn:outgoing>hf2</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:userTask id="h_consider" name="Consider relevant law and evidence">
          <bpmn:documentation textFormat="text/plain">Albemarle County Code § 17-211(D)(3): “the hearing officer will consider relevant and material laws and evidence”</bpmn:documentation>
          <bpmn:extensionElements>
            <lex:grounding>
              <lex:source citation="Albemarle County Code § 17-211(D)(3)" section="17-211" subsection="D.3" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="explicit" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
                <lex:quote>the hearing officer will consider relevant and material laws and evidence</lex:quote>
              </lex:source>
            </lex:grounding>
            <lex:norm modality="obligation" bearer="hearing_officer"/>
          </bpmn:extensionElements>
          <bpmn:incoming>hf2</bpmn:incoming>
          <bpmn:outgoing>hf3</bpmn:outgoing>
        </bpmn:userTask>
        <bpmn:task id="h_record" name="Compile the hearing record">
          <bpmn:documentation textFormat="text/plain">Albemarle County Code § 17-211(D)(4): “The record of the hearing will be composed of relevant files, a recording of the hearing, and other writings.”</bpmn:documentation>
          <bpmn:extensionElements>
            <lex:grounding>
              <lex:source citation="Albemarle County Code § 17-211(D)(4)" section="17-211" subsection="D.4" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="explicit" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
                <lex:quote>The record of the hearing will be composed of relevant files, a recording of the hearing, and other writings.</lex:quote>
              </lex:source>
            </lex:grounding>
          </bpmn:extensionElements>
          <bpmn:incoming>hf3</bpmn:incoming>
          <bpmn:outgoing>hf4</bpmn:outgoing>
          <bpmn:dataOutputAssociation id="h_record_doa_0">
            <bpmn:targetRef>hearing_record_in_ph_hearing</bpmn:targetRef>
          </bpmn:dataOutputAssociation>
        </bpmn:task>
        <bpmn:endEvent id="h_end" name="Hearing closed">
          <bpmn:incoming>hf4</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="hf1" sourceRef="h_start" targetRef="h_evidence"/>
        <bpmn:sequenceFlow id="hf2" sourceRef="h_evidence" targetRef="h_consider"/>
        <bpmn:sequenceFlow id="hf3" sourceRef="h_consider" targetRef="h_record"/>
        <bpmn:sequenceFlow id="hf4" sourceRef="h_record" targetRef="h_end"/>
        <bpmn:dataObjectReference id="hearing_record_in_ph_hearing" name="Hearing record (files, recording, writings)" dataObjectRef="hearing_record_obj"/>
      </bpmn:subProcess>
      <bpmn:endEvent id="ph_end" name="Hearing held">
        <bpmn:incoming>pf3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="pf1" sourceRef="ph_start" targetRef="ph_schedule"/>
      <bpmn:sequenceFlow id="pf2" sourceRef="ph_schedule" targetRef="ph_hearing"/>
      <bpmn:sequenceFlow id="pf3" sourceRef="ph_hearing" targetRef="ph_end"/>
      <bpmn:sequenceFlow id="pf4" sourceRef="ph_ext" targetRef="ph_extend"/>
      <bpmn:sequenceFlow id="pf5" sourceRef="ph_extend" targetRef="ph_ext_end"/>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="c_target" name="30 days after receipt" attachedToRef="c_phase" cancelActivity="false">
      <bpmn:documentation textFormat="text/plain">Albemarle County Code § 17-211(D)(2): “The hearing will be held within 30 days after receipt of the petition requesting a hearing.”</bpmn:documentation>
      <bpmn:extensionElements>
        <lex:grounding>
          <lex:source citation="Albemarle County Code § 17-211(D)(2)" section="17-211" subsection="D.2" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="explicit" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
            <lex:quote>The hearing will be held within 30 days after receipt of the petition requesting a hearing.</lex:quote>
          </lex:source>
        </lex:grounding>
        <lex:deadline kind="duration" value="P30D" anchor="receipt of the petition (clock starts once grounds are stated)" strict="false"/>
      </bpmn:extensionElements>
      <bpmn:outgoing>f15</bpmn:outgoing>
      <bpmn:timerEventDefinition id="c_target_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="c_target_end" name="Target missed; jurisdiction kept">
      <bpmn:documentation textFormat="text/plain">Albemarle County Code § 17-211(D)(2): “The failure of the hearing officer to conduct the hearing within the 30-day period or any extension thereof does not divest the hearing officer of jurisdiction to consider the appeal.”</bpmn:documentation>
      <bpmn:extensionElements>
        <lex:grounding>
          <lex:source citation="Albemarle County Code § 17-211(D)(2)" section="17-211" subsection="D.2" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="explicit" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
            <lex:quote>The failure of the hearing officer to conduct the hearing within the 30-day period or any extension thereof does not divest the hearing officer of jurisdiction to consider the appeal.</lex:quote>
          </lex:source>
        </lex:grounding>
      </bpmn:extensionElements>
      <bpmn:incoming>f15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="c_decide" name="Issue written decision" messageRef="msg_written_decision">
      <bpmn:documentation textFormat="text/plain">Albemarle County Code § 17-211(F) [implied]: “the hearing officer's written decision”</bpmn:documentation>
      <bpmn:extensionElements>
        <lex:grounding>
          <lex:source citation="Albemarle County Code § 17-211(F)" section="17-211" subsection="F" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="implied" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
            <lex:quote>the hearing officer's written decision</lex:quote>
            <lex:note>Subsection E is absent from the LOCUS chunks (letters jump D to F); the written decision is presupposed by subsection F.</lex:note>
          </lex:source>
        </lex:grounding>
        <lex:norm modality="duty-to-decide" bearer="hearing_officer"/>
      </bpmn:extensionElements>
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
      <bpmn:property id="c_decide_in" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="c_decide_dia_0">
        <bpmn:sourceRef>hearing_record</bpmn:sourceRef>
        <bpmn:targetRef>c_decide_in</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="c_after_gw" name="Judicial review sought?" instantiate="false" eventGatewayType="Exclusive" gatewayDirection="Diverging">
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
      <bpmn:outgoing>f18</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="c_jr_notice" name="Notice of appeal received">
      <bpmn:documentation textFormat="text/plain">Albemarle County Code § 17-211(D)(4) [implied]: “The recording of the hearing will be transcribed only if judicial review of the decision is sought under subsection (F).”</bpmn:documentation>
      <bpmn:extensionElements>
        <lex:grounding>
          <lex:source citation="Albemarle County Code § 17-211(D)(4)" section="17-211" subsection="D.4" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="implied" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
            <lex:quote>The recording of the hearing will be transcribed only if judicial review of the decision is sought under subsection (F).</lex:quote>
          </lex:source>
        </lex:grounding>
      </bpmn:extensionElements>
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
      <bpmn:messageEventDefinition id="c_jr_notice_def" messageRef="msg_notice_of_appeal"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="c_transcribe" name="Transcribe the hearing recording">
      <bpmn:documentation textFormat="text/plain">Albemarle County Code § 17-211(D)(4): “The recording of the hearing will be transcribed only if judicial review of the decision is sought under subsection (F).”</bpmn:documentation>
      <bpmn:extensionElements>
        <lex:grounding>
          <lex:source citation="Albemarle County Code § 17-211(D)(4)" section="17-211" subsection="D.4" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="explicit" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
            <lex:quote>The recording of the hearing will be transcribed only if judicial review of the decision is sought under subsection (F).</lex:quote>
          </lex:source>
        </lex:grounding>
      </bpmn:extensionElements>
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
      <bpmn:property id="c_transcribe_in" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="c_transcribe_dia_0">
        <bpmn:sourceRef>hearing_record</bpmn:sourceRef>
        <bpmn:targetRef>c_transcribe_in</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="c_transcribe_doa_0">
        <bpmn:targetRef>transcript</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:sendTask id="c_transmit" name="Send record to circuit court" messageRef="msg_hearing_record">
      <bpmn:documentation textFormat="text/plain">Albemarle County Code § 17-211(F) [assumed]: “Judicial review will be conducted as provided in Virginia Code § 62.1-44.15:46.”</bpmn:documentation>
      <bpmn:extensionElements>
        <lex:grounding>
          <lex:source citation="Albemarle County Code § 17-211(F)" section="17-211" subsection="F" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="assumed" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
            <lex:quote>Judicial review will be conducted as provided in Virginia Code § 62.1-44.15:46.</lex:quote>
            <lex:note>How the record reaches the court is governed by court rules, not § 17-211.</lex:note>
          </lex:source>
        </lex:grounding>
      </bpmn:extensionElements>
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:outgoing>f21</bpmn:outgoing>
      <bpmn:property id="c_transmit_in" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="c_transmit_dia_0">
        <bpmn:sourceRef>transcript</bpmn:sourceRef>
        <bpmn:targetRef>c_transmit_in</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:sendTask>
    <bpmn:endEvent id="c_jr_end" name="Record before the court">
      <bpmn:incoming>f21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="c_jr_window" name="30 days after decision">
      <bpmn:documentation textFormat="text/plain">Albemarle County Code § 17-211(F): “within 30 days after the date of the hearing officer's written decision”
Va. Code § 62.1-44.15:46: “within 30 days from the date of any written decision adversely affecting the rights, duties, or privileges”</bpmn:documentation>
      <bpmn:extensionElements>
        <lex:grounding>
          <lex:source citation="Albemarle County Code § 17-211(F)" section="17-211" subsection="F" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="explicit" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
            <lex:quote>within 30 days after the date of the hearing officer's written decision</lex:quote>
          </lex:source>
          <lex:source citation="Va. Code § 62.1-44.15:46" section="62.1-44.15:46" code="Code of Virginia" jurisdiction="va" grounding="explicit" url="https://law.lis.virginia.gov/vacode/62.1-44.15:46/">
            <lex:quote>within 30 days from the date of any written decision adversely affecting the rights, duties, or privileges</lex:quote>
          </lex:source>
        </lex:grounding>
        <lex:deadline kind="duration" value="P30D" anchor="date of the hearing officer's written decision" strict="true"/>
      </bpmn:extensionElements>
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f22</bpmn:outgoing>
      <bpmn:timerEventDefinition id="c_jr_window_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="c_final" name="County decision final">
      <bpmn:documentation textFormat="text/plain">Albemarle County Code § 17-211(F) [implied]: “A final decision by the hearing officer under this section may be subject to judicial review”</bpmn:documentation>
      <bpmn:extensionElements>
        <lex:grounding>
          <lex:source citation="Albemarle County Code § 17-211(F)" section="17-211" subsection="F" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="implied" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
            <lex:quote>A final decision by the hearing officer under this section may be subject to judicial review</lex:quote>
          </lex:source>
        </lex:grounding>
      </bpmn:extensionElements>
      <bpmn:incoming>f22</bpmn:incoming>
    </bpmn:endEvent>

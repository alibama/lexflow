      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">grounds_stated</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f8" name="Grounds missing" sourceRef="c_grounds_gw" targetRef="c_await_grounds"/>
    <bpmn:sequenceFlow id="f9" sourceRef="c_await_grounds" targetRef="c_grounds_join"/>
    <bpmn:sequenceFlow id="f10" sourceRef="c_grounds_join" targetRef="c_review_rules"/>
    <bpmn:sequenceFlow id="f11" sourceRef="c_review_rules" targetRef="c_standing_gw"/>
    <bpmn:sequenceFlow id="f12" name="Yes" sourceRef="c_standing_gw" targetRef="c_phase">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">reviewable and has_standing</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f13" name="No" sourceRef="c_standing_gw" targetRef="c_dismiss"/>
    <bpmn:sequenceFlow id="f14" sourceRef="c_phase" targetRef="c_decide"/>
    <bpmn:sequenceFlow id="f15" sourceRef="c_target" targetRef="c_target_end"/>
    <bpmn:sequenceFlow id="f16" sourceRef="c_decide" targetRef="c_after_gw"/>
    <bpmn:sequenceFlow id="f17" sourceRef="c_after_gw" targetRef="c_jr_notice"/>
    <bpmn:sequenceFlow id="f18" sourceRef="c_after_gw" targetRef="c_jr_window"/>
    <bpmn:sequenceFlow id="f19" sourceRef="c_jr_notice" targetRef="c_transcribe"/>
    <bpmn:sequenceFlow id="f20" sourceRef="c_transcribe" targetRef="c_transmit"/>
    <bpmn:sequenceFlow id="f21" sourceRef="c_transmit" targetRef="c_jr_end"/>
    <bpmn:sequenceFlow id="f22" sourceRef="c_jr_window" targetRef="c_final"/>
    <bpmn:dataObject id="hearing_record_obj" name="Hearing record (files, recording, writings)"/>
    <bpmn:dataObjectReference id="hearing_record" name="Hearing record (files, recording, writings)" dataObjectRef="hearing_record_obj">
      <bpmn:documentation textFormat="text/plain">Albemarle County Code § 17-211(D)(4): “The record of the hearing will be composed of relevant files, a recording of the hearing, and other writings.”</bpmn:documentation>
      <bpmn:extensionElements>
        <lex:grounding>
          <lex:source citation="Albemarle County Code § 17-211(D)(4)" section="17-211" subsection="D.4" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="explicit" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
            <lex:quote>The record of the hearing will be composed of relevant files, a recording of the hearing, and other writings.</lex:quote>
          </lex:source>
        </lex:grounding>
      </bpmn:extensionElements>
    </bpmn:dataObjectReference>
    <bpmn:dataObject id="transcript_obj" name="Transcript of hearing recording"/>
    <bpmn:dataObjectReference id="transcript" name="Transcript of hearing recording" dataObjectRef="transcript_obj">
      <bpmn:documentation textFormat="text/plain">Albemarle County Code § 17-211(D)(4): “The recording of the hearing will be transcribed only if judicial review of the decision is sought under subsection (F).”</bpmn:documentation>
      <bpmn:extensionElements>
        <lex:grounding>
          <lex:source citation="Albemarle County Code § 17-211(D)(4)" section="17-211" subsection="D.4" code="Albemarle County Code" jurisdiction="va/albemarle_county" grounding="explicit" url="https://library.municode.com/va/albemarle_county/codes/code_of_ordinances">
            <lex:quote>The recording of the hearing will be transcribed only if judicial review of the decision is sought under subsection (F).</lex:quote>
          </lex:source>
        </lex:grounding>
      </bpmn:extensionElements>
    </bpmn:dataObjectReference>
    <bpmn:textAnnotation id="note_soft">
      <bpmn:text>Soft deadline: missing it does not end the appeal (§ 17-211(D)(2)).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="note_gap">
      <bpmn:text>Subsection E missing from source; decision step inferred from (F).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="note_soft_assoc_0" sourceRef="c_target" targetRef="note_soft" associationDirection="None"/>
    <bpmn:association id="note_gap_assoc_0" sourceRef="c_decide" targetRef="note_gap" associationDirection="None"/>
  </bpmn:process>

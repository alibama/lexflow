          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r8_in7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r8_in8">
          <text>-</text>
        </inputEntry>

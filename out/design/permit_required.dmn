          <text>false</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r21_in16">
          <text>-</text>
        </inputEntry>
        <outputEntry id="d_permit_required_r21_out0">
          <text>"no"</text>
        </outputEntry>
        <outputEntry id="d_permit_required_r21_out1">
          <text>"12-A DCMR 105.2 Building item 8"</text>
        </outputEntry>
        <outputEntry id="d_permit_required_r21_out2">
          <text>"Exempt: a single garden storage shed of 50 sq ft or less and under ten feet high, accessory to a house, with no other exempted shed on the lot. This is for the structure alone: wiring, plumbing, gas or mechanical work with it needs a permit (trade_work)."</text>
        </outputEntry>
        <annotationEntry>
          <text>12-A DCMR 105.2, Building item 8; 12-A DCMR 105.2; 12-B DCMR R101.2: “A single garden storage shed that does not exceed 50 square feet (4.65 m2) in area, is less than ten feet (3048 mm) in overall height, is an accessory structure to a building of Use Group R-3 or to a building under the jurisdiction of the Residential Code, and is erected on a lot with no other exempted storage shed.”</text>
        </annotationEntry>
      </rule>
      <rule id="d_permit_required_r22">
        <description>DC: an item-8 shed in a historic district or on a historically designated property</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="12-A DCMR 105.2.5" section="12-A DCMR 105" subsection="105.2.5" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile={64284980-8CFE-4134-BB96-94FBB25965E0}" corpus="regulations" actId="STATE_DC_DCMR_T12_A_C2017_12_A1_S105_EDConstruction_Codes_Supplement_of_2017">
              <lex:quote>and the work is to occur on the land of or the exterior of buildings or other structures located in historic districts, or of historically designated buildings or other structures, an application for a building permit subject only to historic preservation review pursuant to Section 105.1 shall be required for the following work described in Section 105.2 Building</lex:quote>
            </lex:source>
            <lex:source citation="12-A DCMR 105.2.5" section="12-A DCMR 105" subsection="105.2.5" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile={64284980-8CFE-4134-BB96-94FBB25965E0}" corpus="regulations" actId="STATE_DC_DCMR_T12_A_C2017_12_A1_S105_EDConstruction_Codes_Supplement_of_2017">
              <lex:quote>8. Garden storage shed</lex:quote>
            </lex:source>
            <lex:source citation="12-A DCMR 105.2.5" section="12-A DCMR 105" subsection="105.2.5" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile={64284980-8CFE-4134-BB96-94FBB25965E0}" corpus="regulations" actId="STATE_DC_DCMR_T12_A_C2017_12_A1_S105_EDConstruction_Codes_Supplement_of_2017">
              <lex:quote>The code official shall not issue a permit based on an application subject solely to historic preservation review under this section without the prior review and approval of the Historic Preservation Office.</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>

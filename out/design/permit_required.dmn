    <description>101.7: Chapter 1's administrative provisions (permits among them) replace any differing provisions of the incorporated model codes, so only 108.2's list of exemptions counts in Virginia.</description>
    <extensionElements>
      <lex:reference citation="13VAC5-63-10" state="va" corpus="regulations" kind="regulation" actId="STATE_VA_ADC_13_5_63_10" indexTitle="Chapter 1 Administration; Section 101 General"/>

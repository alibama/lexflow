        </inputEntry>
        <inputEntry id="d_permit_required_r40_in6">
          <text>&lt;= 4</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r40_in7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r40_in8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r40_in9">
          <text>&lt;= 50</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r40_in10">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r40_in11">
          <text>-</text>
        </inputEntry>

          <text>"none"</text>
        </outputEntry>
        <outputEntry id="d_permit_required_r39_out2">
          <text>"No item of 105.2 covers a new freestanding wall, so 105.1 requires a permit."</text>
        </outputEntry>
        <annotationEntry>
          <text>12-A DCMR 105.1 (reading): “Construct, enlarge, alter, repair, move, demolish, raze, or change the occupancy of a building or other structure”</text>
        </annotationEntry>
      </rule>
      <rule id="d_permit_required_r40">
        <description>DC: retaining wall of 4 ft or less disturbing 50 sq ft or less, not historic, not in a Flood Hazard Area</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="12-A DCMR 105.2, Building item 10" section="12-A DCMR 105" subsection="105.2/building/10" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile={64284980-8CFE-4134-BB96-94FBB25965E0}" corpus="regulations" actId="STATE_DC_DCMR_T12_A_C2017_12_A1_S105_EDConstruction_Codes_Supplement_of_2017">
              <lex:quote>Retaining walls that are not over four feet (1219 mm) in height, measured from the bottom of the footing to the top of the wall, only where the area of land disturbance does not exceed 50 square feet (4.65 m2).</lex:quote>
            </lex:source>
            <lex:source citation="12-A DCMR 105.2" section="12-A DCMR 105" subsection="105.2" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile={64284980-8CFE-4134-BB96-94FBB25965E0}" corpus="regulations" actId="STATE_DC_DCMR_T12_A_C2017_12_A1_S105_EDConstruction_Codes_Supplement_of_2017">
              <lex:quote>This Section 105.2 sets forth exemptions from permit requirements, subject to historic and Flood Hazard Area restrictions set forth in Sections 105.2.5 and 105.2.6 respectively.</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_permit_required_r40_in0">
          <text>"dc"</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r40_in1">

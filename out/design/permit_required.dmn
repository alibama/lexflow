      <rule id="d_permit_required_r38">
        <description>DC: fence repair, historic and in a Flood Hazard Area</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="12-A DCMR 105.2.6" section="12-A DCMR 105" subsection="105.2.6" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile={64284980-8CFE-4134-BB96-94FBB25965E0}" corpus="regulations" actId="STATE_DC_DCMR_T12_A_C2017_12_A1_S105_EDConstruction_Codes_Supplement_of_2017">
              <lex:quote>and the work is to occur on premises wholly or partially within a Flood Hazard Area, an application for a permit subject only to review by the Floodplain Administrator shall be required.</lex:quote>
            </lex:source>
            <lex:source citation="12-A DCMR 105.2.5" section="12-A DCMR 105" subsection="105.2.5" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile={64284980-8CFE-4134-BB96-94FBB25965E0}" corpus="regulations" actId="STATE_DC_DCMR_T12_A_C2017_12_A1_S105_EDConstruction_Codes_Supplement_of_2017">
              <lex:quote>4. Repair or replacement of fences, except as deemed an ordinary repair</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>

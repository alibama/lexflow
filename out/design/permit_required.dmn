          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r69_in6">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r69_in7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r69_in8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r69_in9">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r69_in10">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r69_in11">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r69_in12">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r69_in13">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r69_in14">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r69_in15">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r69_in16">
          <text>-</text>
        </inputEntry>
        <outputEntry id="d_permit_required_r69_out0">
          <text>"yes"</text>
        </outputEntry>
        <outputEntry id="d_permit_required_r69_out1">
          <text>"none (trade work)"</text>
        </outputEntry>
        <outputEntry id="d_permit_required_r69_out2">
          <text>"160D-1110(a)(2) to (4) require the permits the Code requires for plumbing, heating or cooling, and electrical work, and the $40,000 exclusion does not reach added or redesigned plumbing or wiring ((c)(2), (c)(3)). That the Code requires the permit is a reading; it would change if the code books exempt the work."</text>
        </outputEntry>
        <annotationEntry>
          <text>N.C. Gen. Stat. § 160D-1110(a)(2); N.C. Gen. Stat. § 160D-1110(a)(3); N.C. Gen. Stat. § 160D-1110(a)(4); N.C. Gen. Stat. § 160D-1110(c)(2); N.C. Gen. Stat. § 160D-1110(c)(3); N.C. Gen. Stat. § 160D-1110(a) (reading): “The installation, extension, or general repair of any plumbing system”</text>
        </annotationEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="d_other_approvals" name="other_approvals" label="What else applies besides the building permit?">
    <description>Approvals the building-permit answer does not replace: zoning, historic district review, floodplain rules, DC public space permits (12-A DCMR 105.2.4) and North Carolina's erosion and sedimentation control plan (G.S. 160D-1110(e)). The same for every project in the model.</description>
    <question>Which other approvals or laws apply to the project, permit or not?</question>
    <variable id="d_other_approvals_var" name="other_approvals"/>
    <informationRequirement id="ir_d_other_approvals__in_jurisdiction">
      <requiredInput href="#in_jurisdiction"/>
    </informationRequirement>
    <informationRequirement id="ir_d_other_approvals__in_historic">
      <requiredInput href="#in_historic"/>
    </informationRequirement>
    <informationRequirement id="ir_d_other_approvals__in_flood_hazard_area">
      <requiredInput href="#in_flood_hazard_area"/>
    </informationRequirement>
    <authorityRequirement id="ar_d_other_approvals__ks_va3697">
      <requiredAuthority href="#ks_va3697"/>
    </authorityRequirement>
    <authorityRequirement id="ar_d_other_approvals__ks_va20">
      <requiredAuthority href="#ks_va20"/>
    </authorityRequirement>
    <authorityRequirement id="ar_d_other_approvals__ks_dc105">
      <requiredAuthority href="#ks_dc105"/>
    </authorityRequirement>
    <authorityRequirement id="ar_d_other_approvals__ks_dc304">
      <requiredAuthority href="#ks_dc304"/>
    </authorityRequirement>
    <authorityRequirement id="ar_d_other_approvals__ks_nc1110">
      <requiredAuthority href="#ks_nc1110"/>
    </authorityRequirement>
    <authorityRequirement id="ar_d_other_approvals__ks_nc947">
      <requiredAuthority href="#ks_nc947"/>
    </authorityRequirement>
    <authorityRequirement id="ar_d_other_approvals__ks_nc143138">
      <requiredAuthority href="#ks_nc143138"/>
    </authorityRequirement>
    <decisionTable id="d_other_approvals_table" hitPolicy="UNIQUE">
      <input id="d_other_approvals_in0" label="Jurisdiction (state or District)">
        <inputExpression id="d_other_approvals_in0_expr" typeRef="string">
          <text>jurisdiction</text>
        </inputExpression>
        <inputValues id="d_other_approvals_in0_values">
          <text>"va","dc","nc"</text>
        </inputValues>
      </input>
      <input id="d_other_approvals_in1" label="In a historic district or historically designated">
        <inputExpression id="d_other_approvals_in1_expr" typeRef="boolean">
          <text>historic</text>
        </inputExpression>
      </input>
      <input id="d_other_approvals_in2" label="In a (special) flood hazard area">
        <inputExpression id="d_other_approvals_in2_expr" typeRef="boolean">
          <text>flood_hazard_area</text>
        </inputExpression>
      </input>
      <output id="d_other_approvals_out0" label="Other approvals and laws" name="also" typeRef="string"/>
      <annotation name="Source"/>
      <rule id="d_other_approvals_r1">
        <description>VA: zoning</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Va. Code § 36-97" section="36-97" subsection="Building regulations" code="Va. Code" jurisdiction="va" grounding="explicit" url="https://law.lis.virginia.gov/vacode/36-97/" corpus="statutes" actId="STATE_VA_T36_C6_A1_S36-97">
              <lex:quote>"Building regulations" does not include zoning ordinances or other land use controls that do not affect the manner of construction or materials to be used in the erection, alteration, or repair of a building or structure.</lex:quote>
            </lex:source>
            <lex:source citation="13VAC5-63-20 B (USBC 102.2)" section="13VAC5-63-20" subsection="B" code="VAC" jurisdiction="va" grounding="explicit" url="https://law.lis.virginia.gov/admincode/title13/agency5/chapter63/section20/" corpus="regulations" actId="STATE_VA_ADC_13_5_63_20">
              <lex:quote>this code shall not supersede proffered conditions accepted as a part of a rezoning application</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_other_approvals_r1_in0">
          <text>"va"</text>
        </inputEntry>
        <inputEntry id="d_other_approvals_r1_in1">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_other_approvals_r1_in2">
          <text>false</text>
        </inputEntry>
        <outputEntry id="d_other_approvals_r1_out0">
          <text>"Local zoning (setbacks, lot coverage, use) still applies: zoning is not a building regulation, so the USBC does not supersede it."</text>
        </outputEntry>
        <annotationEntry>
          <text>Va. Code § 36-97; 13VAC5-63-20 B (USBC 102.2): “"Building regulations" does not include zoning ordinances or other land use controls that do not affect the manner of construction or materials to be used in the erection, alteration, or repair of a building or structure.”</text>
        </annotationEntry>
      </rule>
      <rule id="d_other_approvals_r2">
        <description>VA: zoning and the local historic district</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="13VAC5-63-20 B (USBC 102.2)" section="13VAC5-63-20" subsection="B" code="VAC" jurisdiction="va" grounding="explicit" url="https://law.lis.virginia.gov/admincode/title13/agency5/chapter63/section20/" corpus="regulations" actId="STATE_VA_ADC_13_5_63_20">
              <lex:quote>land use requirements in airport or highway overlay districts, historic districts created pursuant to § 15.2-2306 of the Code of Virginia</lex:quote>
            </lex:source>
            <lex:source citation="Va. Code § 36-97" section="36-97" subsection="Building regulations" code="Va. Code" jurisdiction="va" grounding="explicit" url="https://law.lis.virginia.gov/vacode/36-97/" corpus="statutes" actId="STATE_VA_T36_C6_A1_S36-97">
              <lex:quote>"Building regulations" does not include zoning ordinances or other land use controls that do not affect the manner of construction or materials to be used in the erection, alteration, or repair of a building or structure.</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_other_approvals_r2_in0">
          <text>"va"</text>
        </inputEntry>
        <inputEntry id="d_other_approvals_r2_in1">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_other_approvals_r2_in2">
          <text>false</text>
        </inputEntry>
        <outputEntry id="d_other_approvals_r2_out0">
          <text>"Local zoning, and the locality's historic district review (a district created under Va. Code 15.2-2306), which the USBC does not supersede."</text>
        </outputEntry>
        <annotationEntry>
          <text>13VAC5-63-20 B (USBC 102.2); Va. Code § 36-97: “land use requirements in airport or highway overlay districts, historic districts created pursuant to § 15.2-2306 of the Code of Virginia”</text>
        </annotationEntry>
      </rule>
      <rule id="d_other_approvals_r3">
        <description>VA: zoning and the local floodplain rules</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="13VAC5-63-20 B (USBC 102.2)" section="13VAC5-63-20" subsection="B" code="VAC" jurisdiction="va" grounding="explicit" url="https://law.lis.virginia.gov/admincode/title13/agency5/chapter63/section20/" corpus="regulations" actId="STATE_VA_ADC_13_5_63_20">
              <lex:quote>local flood plain regulations adopted as a condition of participation in the National Flood Insurance Program</lex:quote>
            </lex:source>
            <lex:source citation="Va. Code § 36-97" section="36-97" subsection="Building regulations" code="Va. Code" jurisdiction="va" grounding="explicit" url="https://law.lis.virginia.gov/vacode/36-97/" corpus="statutes" actId="STATE_VA_T36_C6_A1_S36-97">
              <lex:quote>"Building regulations" does not include zoning ordinances or other land use controls that do not affect the manner of construction or materials to be used in the erection, alteration, or repair of a building or structure.</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_other_approvals_r3_in0">
          <text>"va"</text>
        </inputEntry>
        <inputEntry id="d_other_approvals_r3_in1">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_other_approvals_r3_in2">
          <text>true</text>
        </inputEntry>
        <outputEntry id="d_other_approvals_r3_out0">
          <text>"Local zoning, and the locality's floodplain regulations under the National Flood Insurance Program, which the USBC does not supersede."</text>
        </outputEntry>
        <annotationEntry>
          <text>13VAC5-63-20 B (USBC 102.2); Va. Code § 36-97: “local flood plain regulations adopted as a condition of participation in the National Flood Insurance Program”</text>
        </annotationEntry>
      </rule>
      <rule id="d_other_approvals_r4">
        <description>VA: zoning, historic district and floodplain</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="13VAC5-63-20 B (USBC 102.2)" section="13VAC5-63-20" subsection="B" code="VAC" jurisdiction="va" grounding="explicit" url="https://law.lis.virginia.gov/admincode/title13/agency5/chapter63/section20/" corpus="regulations" actId="STATE_VA_ADC_13_5_63_20">
              <lex:quote>land use requirements in airport or highway overlay districts, historic districts created pursuant to § 15.2-2306 of the Code of Virginia</lex:quote>
            </lex:source>
            <lex:source citation="13VAC5-63-20 B (USBC 102.2)" section="13VAC5-63-20" subsection="B" code="VAC" jurisdiction="va" grounding="explicit" url="https://law.lis.virginia.gov/admincode/title13/agency5/chapter63/section20/" corpus="regulations" actId="STATE_VA_ADC_13_5_63_20">
              <lex:quote>local flood plain regulations adopted as a condition of participation in the National Flood Insurance Program</lex:quote>
            </lex:source>
            <lex:source citation="Va. Code § 36-97" section="36-97" subsection="Building regulations" code="Va. Code" jurisdiction="va" grounding="explicit" url="https://law.lis.virginia.gov/vacode/36-97/" corpus="statutes" actId="STATE_VA_T36_C6_A1_S36-97">
              <lex:quote>"Building regulations" does not include zoning ordinances or other land use controls that do not affect the manner of construction or materials to be used in the erection, alteration, or repair of a building or structure.</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_other_approvals_r4_in0">
          <text>"va"</text>
        </inputEntry>
        <inputEntry id="d_other_approvals_r4_in1">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_other_approvals_r4_in2">
          <text>true</text>
        </inputEntry>
        <outputEntry id="d_other_approvals_r4_out0">
          <text>"Local zoning, the locality's historic district review, and its NFIP floodplain regulations."</text>
        </outputEntry>
        <annotationEntry>
          <text>13VAC5-63-20 B (USBC 102.2); Va. Code § 36-97: “land use requirements in airport or highway overlay districts, historic districts created pursuant to § 15.2-2306 of the Code of Virginia”</text>
        </annotationEntry>
      </rule>
      <rule id="d_other_approvals_r5">
        <description>DC: other District law</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="12-A DCMR 105.2" section="12-A DCMR 105" subsection="105.2" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile={64284980-8CFE-4134-BB96-94FBB25965E0}" corpus="regulations" actId="STATE_DC_DCMR_T12_A_C2017_12_A1_S105_EDConstruction_Codes_Supplement_of_2017">
              <lex:quote>Exemptions from permit requirements of the Construction Codes shall not be deemed to grant authorization for any work to be done in any manner in violation of the provisions of the Construction Codes or of any other laws, regulations or ordinances of the District of Columbia.</lex:quote>
            </lex:source>
            <lex:source citation="12-A DCMR 105.2.4" section="12-A DCMR 105" subsection="105.2.4" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile={64284980-8CFE-4134-BB96-94FBB25965E0}" corpus="regulations" actId="STATE_DC_DCMR_T12_A_C2017_12_A1_S105_EDConstruction_Codes_Supplement_of_2017">
              <lex:quote>When the proposed scope of work would qualify to be exempted from permit pursuant to Section 105.2 of this chapter, and the work is to occur wholly or partially on public space, the applicant shall be responsible for obtaining all public space permit(s) that are required by DDOT.</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_other_approvals_r5_in0">
          <text>"dc"</text>
        </inputEntry>
        <inputEntry id="d_other_approvals_r5_in1">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_other_approvals_r5_in2">
          <text>false</text>
        </inputEntry>
        <outputEntry id="d_other_approvals_r5_out0">
          <text>"District zoning and other District law still apply: a permit exemption does not authorise work that violates them. Work wholly or partly on public space: for work exempt from a building permit, the applicant must still obtain the public space permits DDOT requires (12-A DCMR 105.2.4)."</text>
        </outputEntry>
        <annotationEntry>
          <text>12-A DCMR 105.2; 12-A DCMR 105.2.4: “Exemptions from permit requirements of the Construction Codes shall not be deemed to grant authorization for any work to be done in any manner in violation of the provisions of the Construction Codes or of any other laws, regulations or ordinances of the District of Columbia.”</text>
        </annotationEntry>
      </rule>
      <rule id="d_other_approvals_r6">
        <description>DC: historic preservation review</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="10-C DCMR 304.1(h)" section="10-C DCMR 304" subsection="304.1/h" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile=3092545F-0000-C379-A514-3E614E04143B" corpus="regulations" actId="STATE_DC_DCMR_T10_C_C10_C3_S304">
              <lex:quote>Construction or replacement of a retaining wall, fence, deck, patio, garden storage shed, swimming pool, or other site feature</lex:quote>
            </lex:source>
            <lex:source citation="10-C DCMR 304.1(b)" section="10-C DCMR 304" subsection="304.1/b" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile=3092545F-0000-C379-A514-3E614E04143B" corpus="regulations" actId="STATE_DC_DCMR_T10_C_C10_C3_S304">
              <lex:quote>Any addition to the building envelope</lex:quote>
            </lex:source>
            <lex:source citation="10-C DCMR 304.1" section="10-C DCMR 304" subsection="304.1" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile=3092545F-0000-C379-A514-3E614E04143B" corpus="regulations" actId="STATE_DC_DCMR_T10_C_C10_C3_S304">
              <lex:quote>Work considered an alteration under the Act shall include, but is not limited to, any of the following, regardless of whether or not the work is visible from public space</lex:quote>
            </lex:source>
            <lex:source citation="12-A DCMR 105.2" section="12-A DCMR 105" subsection="105.2" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile={64284980-8CFE-4134-BB96-94FBB25965E0}" corpus="regulations" actId="STATE_DC_DCMR_T12_A_C2017_12_A1_S105_EDConstruction_Codes_Supplement_of_2017">
              <lex:quote>Exemptions from permit requirements of the Construction Codes shall not be deemed to grant authorization for any work to be done in any manner in violation of the provisions of the Construction Codes or of any other laws, regulations or ordinances of the District of Columbia.</lex:quote>
            </lex:source>
            <lex:source citation="12-A DCMR 105.2.4" section="12-A DCMR 105" subsection="105.2.4" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile={64284980-8CFE-4134-BB96-94FBB25965E0}" corpus="regulations" actId="STATE_DC_DCMR_T12_A_C2017_12_A1_S105_EDConstruction_Codes_Supplement_of_2017">
              <lex:quote>When the proposed scope of work would qualify to be exempted from permit pursuant to Section 105.2 of this chapter, and the work is to occur wholly or partially on public space, the applicant shall be responsible for obtaining all public space permit(s) that are required by DDOT.</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_other_approvals_r6_in0">
          <text>"dc"</text>
        </inputEntry>
        <inputEntry id="d_other_approvals_r6_in1">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_other_approvals_r6_in2">
          <text>false</text>
        </inputEntry>
        <outputEntry id="d_other_approvals_r6_out0">
          <text>"Historic Preservation Office review: building or replacing a deck, fence, retaining wall, patio, shed or other site feature, and any addition, is an alteration under the preservation Act; other District law applies too. Work wholly or partly on public space: for work exempt from a building permit, the applicant must still obtain the public space permits DDOT requires (12-A DCMR 105.2.4)."</text>
        </outputEntry>
        <annotationEntry>
          <text>10-C DCMR 304.1(h); 10-C DCMR 304.1(b); 10-C DCMR 304.1; 12-A DCMR 105.2; 12-A DCMR 105.2.4: “Construction or replacement of a retaining wall, fence, deck, patio, garden storage shed, swimming pool, or other site feature”</text>
        </annotationEntry>
      </rule>
      <rule id="d_other_approvals_r7">
        <description>DC: floodplain review</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="12-A DCMR 105.2.6" section="12-A DCMR 105" subsection="105.2.6" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile={64284980-8CFE-4134-BB96-94FBB25965E0}" corpus="regulations" actId="STATE_DC_DCMR_T12_A_C2017_12_A1_S105_EDConstruction_Codes_Supplement_of_2017">
              <lex:quote>and the work is to occur on premises wholly or partially within a Flood Hazard Area, an application for a permit subject only to review by the Floodplain Administrator shall be required.</lex:quote>
            </lex:source>
            <lex:source citation="12-A DCMR 105.2" section="12-A DCMR 105" subsection="105.2" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile={64284980-8CFE-4134-BB96-94FBB25965E0}" corpus="regulations" actId="STATE_DC_DCMR_T12_A_C2017_12_A1_S105_EDConstruction_Codes_Supplement_of_2017">
              <lex:quote>Exemptions from permit requirements of the Construction Codes shall not be deemed to grant authorization for any work to be done in any manner in violation of the provisions of the Construction Codes or of any other laws, regulations or ordinances of the District of Columbia.</lex:quote>
            </lex:source>
            <lex:source citation="12-A DCMR 105.2.4" section="12-A DCMR 105" subsection="105.2.4" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile={64284980-8CFE-4134-BB96-94FBB25965E0}" corpus="regulations" actId="STATE_DC_DCMR_T12_A_C2017_12_A1_S105_EDConstruction_Codes_Supplement_of_2017">
              <lex:quote>When the proposed scope of work would qualify to be exempted from permit pursuant to Section 105.2 of this chapter, and the work is to occur wholly or partially on public space, the applicant shall be responsible for obtaining all public space permit(s) that are required by DDOT.</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_other_approvals_r7_in0">
          <text>"dc"</text>
        </inputEntry>
        <inputEntry id="d_other_approvals_r7_in1">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_other_approvals_r7_in2">
          <text>true</text>
        </inputEntry>
        <outputEntry id="d_other_approvals_r7_out0">
          <text>"Floodplain Administrator review (for work otherwise exempt, 12-A DCMR 105.2.6); other District law applies too. Work wholly or partly on public space: for work exempt from a building permit, the applicant must still obtain the public space permits DDOT requires (12-A DCMR 105.2.4)."</text>
        </outputEntry>
        <annotationEntry>
          <text>12-A DCMR 105.2.6; 12-A DCMR 105.2; 12-A DCMR 105.2.4: “and the work is to occur on premises wholly or partially within a Flood Hazard Area, an application for a permit subject only to review by the Floodplain Administrator shall be required.”</text>
        </annotationEntry>
      </rule>
      <rule id="d_other_approvals_r8">
        <description>DC: historic and floodplain review</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="10-C DCMR 304.1(h)" section="10-C DCMR 304" subsection="304.1/h" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile=3092545F-0000-C379-A514-3E614E04143B" corpus="regulations" actId="STATE_DC_DCMR_T10_C_C10_C3_S304">
              <lex:quote>Construction or replacement of a retaining wall, fence, deck, patio, garden storage shed, swimming pool, or other site feature</lex:quote>
            </lex:source>
            <lex:source citation="12-A DCMR 105.2.6" section="12-A DCMR 105" subsection="105.2.6" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile={64284980-8CFE-4134-BB96-94FBB25965E0}" corpus="regulations" actId="STATE_DC_DCMR_T12_A_C2017_12_A1_S105_EDConstruction_Codes_Supplement_of_2017">
              <lex:quote>and the work is to occur on premises wholly or partially within a Flood Hazard Area, an application for a permit subject only to review by the Floodplain Administrator shall be required.</lex:quote>
            </lex:source>
            <lex:source citation="12-A DCMR 105.2" section="12-A DCMR 105" subsection="105.2" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile={64284980-8CFE-4134-BB96-94FBB25965E0}" corpus="regulations" actId="STATE_DC_DCMR_T12_A_C2017_12_A1_S105_EDConstruction_Codes_Supplement_of_2017">
              <lex:quote>Exemptions from permit requirements of the Construction Codes shall not be deemed to grant authorization for any work to be done in any manner in violation of the provisions of the Construction Codes or of any other laws, regulations or ordinances of the District of Columbia.</lex:quote>
            </lex:source>
            <lex:source citation="12-A DCMR 105.2.4" section="12-A DCMR 105" subsection="105.2.4" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile={64284980-8CFE-4134-BB96-94FBB25965E0}" corpus="regulations" actId="STATE_DC_DCMR_T12_A_C2017_12_A1_S105_EDConstruction_Codes_Supplement_of_2017">
              <lex:quote>When the proposed scope of work would qualify to be exempted from permit pursuant to Section 105.2 of this chapter, and the work is to occur wholly or partially on public space, the applicant shall be responsible for obtaining all public space permit(s) that are required by DDOT.</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_other_approvals_r8_in0">
          <text>"dc"</text>
        </inputEntry>
        <inputEntry id="d_other_approvals_r8_in1">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_other_approvals_r8_in2">
          <text>true</text>
        </inputEntry>
        <outputEntry id="d_other_approvals_r8_out0">
          <text>"Historic Preservation Office review (10-C DCMR 304.1) and Floodplain Administrator review (12-A DCMR 105.2.6); other District law applies too. Work wholly or partly on public space: for work exempt from a building permit, the applicant must still obtain the public space permits DDOT requires (12-A DCMR 105.2.4)."</text>
        </outputEntry>
        <annotationEntry>
          <text>10-C DCMR 304.1(h); 12-A DCMR 105.2.6; 12-A DCMR 105.2; 12-A DCMR 105.2.4: “Construction or replacement of a retaining wall, fence, deck, patio, garden storage shed, swimming pool, or other site feature”</text>
        </annotationEntry>
      </rule>
      <rule id="d_other_approvals_r9">
        <description>NC: other State and local law</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="N.C. Gen. Stat. § 160D-1110(a)" section="160D-1110" subsection="a" code="N.C. Gen. Stat." jurisdiction="nc" grounding="explicit" url="https://www.ncleg.gov/EnactedLegislation/Statutes/HTML/BySection/Chapter_160D/GS_160D-1110.html" corpus="statutes" actId="STATE_NC_C160D_S160D-1110">
              <lex:quote>no person shall commence or proceed with any of the following without first securing all permits required by the North Carolina State Building Code and any other State or local laws applicable to any of the following activities</lex:quote>
            </lex:source>
            <lex:source citation="N.C. Gen. Stat. § 160D-1110(e)" section="160D-1110" subsection="e" code="N.C. Gen. Stat." jurisdiction="nc" grounding="explicit" url="https://www.ncleg.gov/EnactedLegislation/Statutes/HTML/BySection/Chapter_160D/GS_160D-1110.html" corpus="statutes" actId="STATE_NC_C160D_S160D-1110">
              <lex:quote>No building permit shall be issued pursuant to subsection (a) of this section or G.S. 160D-1110.1(h) for any land-disturbing activity, as defined in G.S. 113A-52, or for any activity covered by G.S. 113A-57, unless an erosion and sedimentation control plan for the site of the activity or a tract of land including the site of the activity has been approved under Article 4 of Chapter 113A of the General Statutes, the Sedimentation Pollution Control Act.</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_other_approvals_r9_in0">
          <text>"nc"</text>
        </inputEntry>
        <inputEntry id="d_other_approvals_r9_in1">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_other_approvals_r9_in2">
          <text>false</text>
        </inputEntry>
        <outputEntry id="d_other_approvals_r9_out0">
          <text>"Other State and local laws (zoning, erosion control) still apply. A building permit for land-disturbing activity cannot issue until an erosion and sedimentation control plan is approved (160D-1110(e))."</text>
        </outputEntry>
        <annotationEntry>
          <text>N.C. Gen. Stat. § 160D-1110(a); N.C. Gen. Stat. § 160D-1110(e): “no person shall commence or proceed with any of the following without first securing all permits required by the North Carolina State Building Code and any other State or local laws applicable to any of the following activities”</text>
        </annotationEntry>
      </rule>
      <rule id="d_other_approvals_r10">
        <description>NC: certificate of appropriateness</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="N.C. Gen. Stat. § 160D-947(a)" section="160D-947" subsection="a" code="N.C. Gen. Stat." jurisdiction="nc" grounding="explicit" url="https://www.ncleg.gov/EnactedLegislation/Statutes/HTML/BySection/Chapter_160D/GS_160D-947.html" corpus="statutes" actId="STATE_NC_C160D_S160D-947">
              <lex:quote>A certificate of appropriateness is required whether or not a building or other permit is required.</lex:quote>
            </lex:source>
            <lex:source citation="N.C. Gen. Stat. § 160D-947(a)" section="160D-947" subsection="a" code="N.C. Gen. Stat." jurisdiction="nc" grounding="explicit" url="https://www.ncleg.gov/EnactedLegislation/Statutes/HTML/BySection/Chapter_160D/GS_160D-947.html" corpus="statutes" actId="STATE_NC_C160D_S160D-947">
              <lex:quote>no exterior portion of any building or other structure, including masonry walls, fences, light fixtures, steps and pavement, or other appurtenant features</lex:quote>
            </lex:source>
            <lex:source citation="N.C. Gen. Stat. § 160D-1110(a)" section="160D-1110" subsection="a" code="N.C. Gen. Stat." jurisdiction="nc" grounding="explicit" url="https://www.ncleg.gov/EnactedLegislation/Statutes/HTML/BySection/Chapter_160D/GS_160D-1110.html" corpus="statutes" actId="STATE_NC_C160D_S160D-1110">
              <lex:quote>no person shall commence or proceed with any of the following without first securing all permits required by the North Carolina State Building Code and any other State or local laws applicable to any of the following activities</lex:quote>
            </lex:source>
            <lex:source citation="N.C. Gen. Stat. § 160D-1110(e)" section="160D-1110" subsection="e" code="N.C. Gen. Stat." jurisdiction="nc" grounding="explicit" url="https://www.ncleg.gov/EnactedLegislation/Statutes/HTML/BySection/Chapter_160D/GS_160D-1110.html" corpus="statutes" actId="STATE_NC_C160D_S160D-1110">
              <lex:quote>No building permit shall be issued pursuant to subsection (a) of this section or G.S. 160D-1110.1(h) for any land-disturbing activity, as defined in G.S. 113A-52, or for any activity covered by G.S. 113A-57, unless an erosion and sedimentation control plan for the site of the activity or a tract of land including the site of the activity has been approved under Article 4 of Chapter 113A of the General Statutes, the Sedimentation Pollution Control Act.</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_other_approvals_r10_in0">
          <text>"nc"</text>
        </inputEntry>
        <inputEntry id="d_other_approvals_r10_in1">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_other_approvals_r10_in2">
          <text>false</text>
        </inputEntry>
        <outputEntry id="d_other_approvals_r10_out0">
          <text>"A certificate of appropriateness from the preservation commission, whether or not a building permit is required; other State and local laws apply too. A building permit for land-disturbing activity cannot issue until an erosion and sedimentation control plan is approved (160D-1110(e))."</text>
        </outputEntry>
        <annotationEntry>
          <text>N.C. Gen. Stat. § 160D-947(a); N.C. Gen. Stat. § 160D-1110(a); N.C. Gen. Stat. § 160D-1110(e): “A certificate of appropriateness is required whether or not a building or other permit is required.”</text>
        </annotationEntry>
      </rule>
      <rule id="d_other_approvals_r11">
        <description>NC: local floodplain rules</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="N.C. Gen. Stat. § 143-138(e)" section="143-138" subsection="e" code="N.C. Gen. Stat." jurisdiction="nc" grounding="explicit" url="https://www.ncleg.gov/EnactedLegislation/Statutes/HTML/BySection/Chapter_143/GS_143-138.html" corpus="statutes" actId="STATE_NC_C143_S143-138">
              <lex:quote>any political subdivision of the State may adopt a fire prevention code and floodplain management regulations within its jurisdiction</lex:quote>
            </lex:source>
            <lex:source citation="N.C. Gen. Stat. § 160D-1110(a)" section="160D-1110" subsection="a" code="N.C. Gen. Stat." jurisdiction="nc" grounding="explicit" url="https://www.ncleg.gov/EnactedLegislation/Statutes/HTML/BySection/Chapter_160D/GS_160D-1110.html" corpus="statutes" actId="STATE_NC_C160D_S160D-1110">
              <lex:quote>no person shall commence or proceed with any of the following without first securing all permits required by the North Carolina State Building Code and any other State or local laws applicable to any of the following activities</lex:quote>
            </lex:source>
            <lex:source citation="N.C. Gen. Stat. § 160D-1110(e)" section="160D-1110" subsection="e" code="N.C. Gen. Stat." jurisdiction="nc" grounding="explicit" url="https://www.ncleg.gov/EnactedLegislation/Statutes/HTML/BySection/Chapter_160D/GS_160D-1110.html" corpus="statutes" actId="STATE_NC_C160D_S160D-1110">
              <lex:quote>No building permit shall be issued pursuant to subsection (a) of this section or G.S. 160D-1110.1(h) for any land-disturbing activity, as defined in G.S. 113A-52, or for any activity covered by G.S. 113A-57, unless an erosion and sedimentation control plan for the site of the activity or a tract of land including the site of the activity has been approved under Article 4 of Chapter 113A of the General Statutes, the Sedimentation Pollution Control Act.</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_other_approvals_r11_in0">
          <text>"nc"</text>
        </inputEntry>
        <inputEntry id="d_other_approvals_r11_in1">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_other_approvals_r11_in2">
          <text>true</text>
        </inputEntry>
        <outputEntry id="d_other_approvals_r11_out0">
          <text>"The local government's floodplain management regulations; other State and local laws apply too. A building permit for land-disturbing activity cannot issue until an erosion and sedimentation control plan is approved (160D-1110(e))."</text>
        </outputEntry>
        <annotationEntry>
          <text>N.C. Gen. Stat. § 143-138(e); N.C. Gen. Stat. § 160D-1110(a); N.C. Gen. Stat. § 160D-1110(e): “any political subdivision of the State may adopt a fire prevention code and floodplain management regulations within its jurisdiction”</text>
        </annotationEntry>
      </rule>
      <rule id="d_other_approvals_r12">
        <description>NC: certificate of appropriateness and floodplain rules</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="N.C. Gen. Stat. § 160D-947(a)" section="160D-947" subsection="a" code="N.C. Gen. Stat." jurisdiction="nc" grounding="explicit" url="https://www.ncleg.gov/EnactedLegislation/Statutes/HTML/BySection/Chapter_160D/GS_160D-947.html" corpus="statutes" actId="STATE_NC_C160D_S160D-947">
              <lex:quote>A certificate of appropriateness is required whether or not a building or other permit is required.</lex:quote>
            </lex:source>
            <lex:source citation="N.C. Gen. Stat. § 143-138(e)" section="143-138" subsection="e" code="N.C. Gen. Stat." jurisdiction="nc" grounding="explicit" url="https://www.ncleg.gov/EnactedLegislation/Statutes/HTML/BySection/Chapter_143/GS_143-138.html" corpus="statutes" actId="STATE_NC_C143_S143-138">
              <lex:quote>any political subdivision of the State may adopt a fire prevention code and floodplain management regulations within its jurisdiction</lex:quote>
            </lex:source>
            <lex:source citation="N.C. Gen. Stat. § 160D-1110(a)" section="160D-1110" subsection="a" code="N.C. Gen. Stat." jurisdiction="nc" grounding="explicit" url="https://www.ncleg.gov/EnactedLegislation/Statutes/HTML/BySection/Chapter_160D/GS_160D-1110.html" corpus="statutes" actId="STATE_NC_C160D_S160D-1110">
              <lex:quote>no person shall commence or proceed with any of the following without first securing all permits required by the North Carolina State Building Code and any other State or local laws applicable to any of the following activities</lex:quote>
            </lex:source>
            <lex:source citation="N.C. Gen. Stat. § 160D-1110(e)" section="160D-1110" subsection="e" code="N.C. Gen. Stat." jurisdiction="nc" grounding="explicit" url="https://www.ncleg.gov/EnactedLegislation/Statutes/HTML/BySection/Chapter_160D/GS_160D-1110.html" corpus="statutes" actId="STATE_NC_C160D_S160D-1110">
              <lex:quote>No building permit shall be issued pursuant to subsection (a) of this section or G.S. 160D-1110.1(h) for any land-disturbing activity, as defined in G.S. 113A-52, or for any activity covered by G.S. 113A-57, unless an erosion and sedimentation control plan for the site of the activity or a tract of land including the site of the activity has been approved under Article 4 of Chapter 113A of the General Statutes, the Sedimentation Pollution Control Act.</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_other_approvals_r12_in0">
          <text>"nc"</text>
        </inputEntry>
        <inputEntry id="d_other_approvals_r12_in1">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_other_approvals_r12_in2">
          <text>true</text>
        </inputEntry>
        <outputEntry id="d_other_approvals_r12_out0">
          <text>"A certificate of appropriateness, whether or not a permit is required, and the local floodplain management regulations; other State and local laws apply too. A building permit for land-disturbing activity cannot issue until an erosion and sedimentation control plan is approved (160D-1110(e))."</text>
        </outputEntry>
        <annotationEntry>
          <text>N.C. Gen. Stat. § 160D-947(a); N.C. Gen. Stat. § 143-138(e); N.C. Gen. Stat. § 160D-1110(a); N.C. Gen. Stat. § 160D-1110(e): “A certificate of appropriateness is required whether or not a building or other permit is required.”</text>
        </annotationEntry>
      </rule>
    </decisionTable>
  </decision>

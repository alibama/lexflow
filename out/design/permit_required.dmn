          <text>false</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r35_in15">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r35_in16">
          <text>-</text>
        </inputEntry>
        <outputEntry id="d_permit_required_r35_out0">
          <text>"no"</text>
        </outputEntry>
        <outputEntry id="d_permit_required_r35_out1">
          <text>"12-A DCMR 105.2 Building item 4"</text>
        </outputEntry>
        <outputEntry id="d_permit_required_r35_out2">
          <text>"Exempt: repair in kind of an existing fence. This is for the structure alone: wiring, plumbing, gas or mechanical work with it needs a permit (trade_work)."</text>
        </outputEntry>
        <annotationEntry>
          <text>12-A DCMR 105.2, Building item 4; 12-A DCMR 105.2: “Repair in kind of existing fences.”</text>
        </annotationEntry>
      </rule>
      <rule id="d_permit_required_r36">
        <description>DC: fence repair in a historic district</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="12-A DCMR 105.2.5" section="12-A DCMR 105" subsection="105.2.5" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile={64284980-8CFE-4134-BB96-94FBB25965E0}" corpus="regulations" actId="STATE_DC_DCMR_T12_A_C2017_12_A1_S105_EDConstruction_Codes_Supplement_of_2017">
              <lex:quote>4. Repair or replacement of fences, except as deemed an ordinary repair</lex:quote>
            </lex:source>
            <lex:source citation="12-A DCMR 105.2.5" section="12-A DCMR 105" subsection="105.2.5" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile={64284980-8CFE-4134-BB96-94FBB25965E0}" corpus="regulations" actId="STATE_DC_DCMR_T12_A_C2017_12_A1_S105_EDConstruction_Codes_Supplement_of_2017">
              <lex:quote>and the work is to occur on the land of or the exterior of buildings or other structures located in historic districts, or of historically designated buildings or other structures, an application for a building permit subject only to historic preservation review pursuant to Section 105.1 shall be required for the following work described in Section 105.2 Building</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_permit_required_r36_in0">
          <text>"dc"</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r36_in1">

              <lex:quote>Application for a permit may be required by the building official for any items exempted in this section that are located in a special flood hazard area.</lex:quote>
            </lex:source>
            <lex:source citation="13VAC5-63-80 B (USBC 108.2), item 7" section="13VAC5-63-80" subsection="B/7" code="VAC" jurisdiction="va" grounding="explicit" url="https://law.lis.virginia.gov/admincode/title13/agency5/chapter63/section80/" corpus="regulations" actId="STATE_VA_ADC_13_5_63_80">

        </inputEntry>
        <inputEntry id="d_permit_required_r8_in3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r8_in4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r8_in5">
          <text>-</text>
        </inputEntry>

        <extensionElements>
          <lex:grounding>
            <lex:source citation="13VAC5-63-20 D (USBC 102.3), item 7" section="13VAC5-63-20" subsection="D/7" code="VAC" jurisdiction="va" grounding="explicit" url="https://law.lis.virginia.gov/admincode/title13/agency5/chapter63/section20/" corpus="regulations" actId="STATE_VA_ADC_13_5_63_20">
              <lex:quote>Playground or recreational equipment, such as swing sets, sliding boards, climbing bars, jungle gyms, skateboard ramps, and similar equipment.</lex:quote>
            </lex:source>
            <lex:source citation="13VAC5-63-20 D (USBC 102.3)" section="13VAC5-63-20" subsection="D" code="VAC" jurisdiction="va" grounding="explicit" url="https://law.lis.virginia.gov/admincode/title13/agency5/chapter63/section20/" corpus="regulations" actId="STATE_VA_ADC_13_5_63_20">
              <lex:quote>The following are exempt from this code</lex:quote>
            </lex:source>

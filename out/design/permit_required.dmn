        </outputEntry>
        <outputEntry id="d_permit_required_r59_out2">
          <text>"Exempt: swings and other playground equipment accessory to a house. This is for the structure alone: wiring, plumbing, gas or mechanical work with it needs a permit (trade_work)."</text>
        </outputEntry>
        <annotationEntry>
          <text>12-A DCMR 105.2, Building item 12; 12-A DCMR 105.2: “Swings and other playground equipment accessory to detached one- and two-family dwellings and townhouses.”</text>
        </annotationEntry>
      </rule>
      <rule id="d_permit_required_r60">
        <description>DC: playground equipment in a historic district</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="12-A DCMR 105.2, Building item 12" section="12-A DCMR 105" subsection="105.2/building/12" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile={64284980-8CFE-4134-BB96-94FBB25965E0}" corpus="regulations" actId="STATE_DC_DCMR_T12_A_C2017_12_A1_S105_EDConstruction_Codes_Supplement_of_2017">
              <lex:quote>Swings and other playground equipment accessory to detached one- and two-family dwellings and townhouses.</lex:quote>
            </lex:source>
            <lex:source citation="12-A DCMR 105.2.5" section="12-A DCMR 105" subsection="105.2.5" code="DCMR" jurisdiction="dc" grounding="implied" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile={64284980-8CFE-4134-BB96-94FBB25965E0}" corpus="regulations" actId="STATE_DC_DCMR_T12_A_C2017_12_A1_S105_EDConstruction_Codes_Supplement_of_2017">
              <lex:quote>and the work is to occur on the land of or the exterior of buildings or other structures located in historic districts, or of historically designated buildings or other structures, an application for a building permit subject only to historic preservation review pursuant to Section 105.1 shall be required for the following work described in Section 105.2 Building</lex:quote>
              <lex:note>Reading: 105.2.5 lists Building items 1, 4, 5, 7, 8, 9 and 10, not item 12.</lex:note>
            </lex:source>
            <lex:source citation="10-C DCMR 303.1" section="10-C DCMR 303" subsection="303.1" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile=3092545F-0000-C45F-90B0-FDCCA7A2E4C6" corpus="regulations" actId="STATE_DC_DCMR_T10_C_C10_C3_S303">
              <lex:quote>Permits are required for work affecting historic landmarks and historic districts, including demolition, alteration, subdivision, and new construction as described in D.C. Official Code §§ 6-1104 through 6-1107.</lex:quote>
            </lex:source>
            <lex:source citation="10-C DCMR 303.1" section="10-C DCMR 303" subsection="303.1" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile=3092545F-0000-C45F-90B0-FDCCA7A2E4C6" corpus="regulations" actId="STATE_DC_DCMR_T10_C_C10_C3_S303">
              <lex:quote>The requirements for a construction permit are governed by the D.C. Construction Codes (12 DCMR Chapter 1).</lex:quote>
            </lex:source>
            <lex:source citation="10-C DCMR 303.3" section="10-C DCMR 303" subsection="303.3" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile=3092545F-0000-C45F-90B0-FDCCA7A2E4C6" corpus="regulations" actId="STATE_DC_DCMR_T10_C_C10_C3_S303">
              <lex:quote>A separate historic preservation permit or certificate of appropriateness is not required.</lex:quote>
            </lex:source>
            <lex:source citation="10-C DCMR 304.1(h)" section="10-C DCMR 304" subsection="304.1/h" code="DCMR" jurisdiction="dc" grounding="implied" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile=3092545F-0000-C379-A514-3E614E04143B" corpus="regulations" actId="STATE_DC_DCMR_T10_C_C10_C3_S304">
              <lex:quote>Construction or replacement of a retaining wall, fence, deck, patio, garden storage shed, swimming pool, or other site feature</lex:quote>
              <lex:note>Reading: play equipment may be an 'other site feature'.</lex:note>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_permit_required_r60_in0">
          <text>"dc"</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r60_in1">
          <text>"playground_equipment"</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r60_in2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r60_in3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r60_in4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r60_in5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r60_in6">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r60_in7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r60_in8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r60_in9">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r60_in10">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r60_in11">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r60_in12">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r60_in13">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r60_in14">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r60_in15">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r60_in16">
          <text>-</text>
        </inputEntry>
        <outputEntry id="d_permit_required_r60_out0">
          <text>"depends"</text>
        </outputEntry>
        <outputEntry id="d_permit_required_r60_out1">
          <text>"12-A DCMR 105.2 Building item 12"</text>
        </outputEntry>
        <outputEntry id="d_permit_required_r60_out2">
          <text>"105.2.5 does not list item 12, so the building-code exemption stands; but 10-C DCMR 303.1 requires permits for alterations of historic properties, and 304.1(h) counts building a site feature as one, while 303.1 and 303.3 send the permit question back to 12 DCMR Chapter 1. Ask the Historic Preservation Office. This is for the structure alone: wiring, plumbing, gas or mechanical work with it needs a permit (trade_work)."</text>
        </outputEntry>
        <annotationEntry>
          <text>12-A DCMR 105.2, Building item 12; 12-A DCMR 105.2.5 (reading); 10-C DCMR 303.1; 10-C DCMR 303.3; 10-C DCMR 304.1(h) (reading): “Swings and other playground equipment accessory to detached one- and two-family dwellings and townhouses.”</text>
        </annotationEntry>
      </rule>
      <rule id="d_permit_required_r61">
        <description>DC: playground equipment in a Flood Hazard Area</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="12-A DCMR 105.2.6" section="12-A DCMR 105" subsection="105.2.6" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile={64284980-8CFE-4134-BB96-94FBB25965E0}" corpus="regulations" actId="STATE_DC_DCMR_T12_A_C2017_12_A1_S105_EDConstruction_Codes_Supplement_of_2017">
              <lex:quote>and the work is to occur on premises wholly or partially within a Flood Hazard Area, an application for a permit subject only to review by the Floodplain Administrator shall be required.</lex:quote>
            </lex:source>
            <lex:source citation="12-A DCMR 105.2, Building item 12" section="12-A DCMR 105" subsection="105.2/building/12" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile={64284980-8CFE-4134-BB96-94FBB25965E0}" corpus="regulations" actId="STATE_DC_DCMR_T12_A_C2017_12_A1_S105_EDConstruction_Codes_Supplement_of_2017">
              <lex:quote>Swings and other playground equipment accessory to detached one- and two-family dwellings and townhouses.</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_permit_required_r61_in0">
          <text>"dc"</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r61_in1">
          <text>"playground_equipment"</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r61_in2">

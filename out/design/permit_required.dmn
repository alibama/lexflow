      <rule id="d_permit_required_r25">
        <description>DC: shed over 50 sq ft</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="12-A DCMR 105.2, Building item 8" section="12-A DCMR 105" subsection="105.2/building/8" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile={64284980-8CFE-4134-BB96-94FBB25965E0}" corpus="regulations" actId="STATE_DC_DCMR_T12_A_C2017_12_A1_S105_EDConstruction_Codes_Supplement_of_2017">
              <lex:quote>A single garden storage shed that does not exceed 50 square feet (4.65 m2) in area, is less than ten feet (3048 mm) in overall height, is an accessory structure to a building of Use Group R-3 or to a building under the jurisdiction of the Residential Code, and is erected on a lot with no other exempted storage shed.</lex:quote>
            </lex:source>
            <lex:source citation="12-A DCMR 105.1" section="12-A DCMR 105" subsection="105.1" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile={64284980-8CFE-4134-BB96-94FBB25965E0}" corpus="regulations" actId="STATE_DC_DCMR_T12_A_C2017_12_A1_S105_EDConstruction_Codes_Supplement_of_2017">
              <lex:quote>Unless specifically exempted under Section 105.2, an owner or authorized agent who intends to undertake any of the activities set forth in items 1 through 5 below, or to cause any such work to be done shall first make application to the code official and obtain the required permit(s) relevant to the intended work</lex:quote>
            </lex:source>
            <lex:source citation="12-A DCMR 105.1" section="12-A DCMR 105" subsection="105.1" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile={64284980-8CFE-4134-BB96-94FBB25965E0}" corpus="regulations" actId="STATE_DC_DCMR_T12_A_C2017_12_A1_S105_EDConstruction_Codes_Supplement_of_2017">
              <lex:quote>Construct, enlarge, alter, repair, move, demolish, raze, or change the occupancy of a building or other structure</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>

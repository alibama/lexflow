          <text>"none"</text>
        </outputEntry>
        <outputEntry id="d_permit_required_r64_out2">
          <text>"No item of 105.2 exempts farm buildings (item 11 covers only shade cloth structures for horticultural or agricultural purposes), so 105.1 requires a permit. A farm storage shed of 50 sq ft or less is project 'shed' (item 8)."</text>
        </outputEntry>
        <annotationEntry>
          <text>12-A DCMR 105.1 (reading); 12-A DCMR 105.2, Building item 11: “Construct, enlarge, alter, repair, move, demolish, raze, or change the occupancy of a building or other structure”</text>
        </annotationEntry>
      </rule>
      <rule id="d_permit_required_r65">
        <description>DC: electrical, gas, mechanical or plumbing work</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="12-A DCMR 105.1" section="12-A DCMR 105" subsection="105.1" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile={64284980-8CFE-4134-BB96-94FBB25965E0}" corpus="regulations" actId="STATE_DC_DCMR_T12_A_C2017_12_A1_S105_EDConstruction_Codes_Supplement_of_2017">
              <lex:quote>Erect, install, enlarge, alter, repair, remove, convert or replace any electrical, gas, mechanical, or plumbing system, the installation of which is regulated by the Construction Codes, or to cause any such work to be done</lex:quote>
            </lex:source>
            <lex:source citation="12-A DCMR 105.1" section="12-A DCMR 105" subsection="105.1" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile={64284980-8CFE-4134-BB96-94FBB25965E0}" corpus="regulations" actId="STATE_DC_DCMR_T12_A_C2017_12_A1_S105_EDConstruction_Codes_Supplement_of_2017">
              <lex:quote>Unless specifically exempted under Section 105.2, an owner or authorized agent who intends to undertake any of the activities set forth in items 1 through 5 below, or to cause any such work to be done shall first make application to the code official and obtain the required permit(s) relevant to the intended work</lex:quote>
            </lex:source>
            <lex:source citation="12-A DCMR 105.1.1" section="12-A DCMR 105" subsection="105.1.1" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile={64284980-8CFE-4134-BB96-94FBB25965E0}" corpus="regulations" actId="STATE_DC_DCMR_T12_A_C2017_12_A1_S105_EDConstruction_Codes_Supplement_of_2017">
              <lex:quote>Trade permits</lex:quote>
            </lex:source>
            <lex:source citation="12-A DCMR 105.2.2" section="12-A DCMR 105" subsection="105.2.2" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile={64284980-8CFE-4134-BB96-94FBB25965E0}" corpus="regulations" actId="STATE_DC_DCMR_T12_A_C2017_12_A1_S105_EDConstruction_Codes_Supplement_of_2017">
              <lex:quote>Addition to, alteration of, replacement or relocation of any standpipe, water supply, sewer, drainage, drain leader, gas, soil, waste, vent or similar piping, electric wiring or mechanical or other work affecting public health or general safety.</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_permit_required_r65_in0">
          <text>"dc"</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r65_in1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r65_in2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r65_in3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r65_in4">
          <text>-</text>
        </inputEntry>

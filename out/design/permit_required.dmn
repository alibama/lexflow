        <outputEntry id="d_permit_required_r20_out2">
          <text>"An addition is construction that adds walls to a building (108.1 item 1); no item of 108.2 covers it. The same holds for an industrialized (modular) addition: 429.5 applies the code's permit requirements to its site work."</text>
        </outputEntry>
        <annotationEntry>
          <text>13VAC5-63-80 A (USBC 108.1), item 1; 13VAC5-63-20 D (USBC 102.3), item 8 (reading); 13VAC5-63-220 K (USBC 429.5): “Construction or demolition of a building or structure.”</text>
        </annotationEntry>
      </rule>
      <rule id="d_permit_required_r21">
        <description>DC: one garden storage shed of 50 sq ft or less, under 10 ft, not historic, not in a Flood Hazard Area</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="12-A DCMR 105.2, Building item 8" section="12-A DCMR 105" subsection="105.2/building/8" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile={64284980-8CFE-4134-BB96-94FBB25965E0}" corpus="regulations" actId="STATE_DC_DCMR_T12_A_C2017_12_A1_S105_EDConstruction_Codes_Supplement_of_2017">
              <lex:quote>A single garden storage shed that does not exceed 50 square feet (4.65 m2) in area, is less than ten feet (3048 mm) in overall height, is an accessory structure to a building of Use Group R-3 or to a building under the jurisdiction of the Residential Code, and is erected on a lot with no other exempted storage shed.</lex:quote>
            </lex:source>
            <lex:source citation="12-A DCMR 105.2" section="12-A DCMR 105" subsection="105.2" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile={64284980-8CFE-4134-BB96-94FBB25965E0}" corpus="regulations" actId="STATE_DC_DCMR_T12_A_C2017_12_A1_S105_EDConstruction_Codes_Supplement_of_2017">
              <lex:quote>This Section 105.2 sets forth exemptions from permit requirements, subject to historic and Flood Hazard Area restrictions set forth in Sections 105.2.5 and 105.2.6 respectively.</lex:quote>
            </lex:source>
            <lex:source citation="12-B DCMR R101.2" section="12-B DCMR 101" subsection="R101.2" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile={8F32FAD3-B817-49C7-8C53-F4AFFDA1E1FA}" corpus="regulations" actId="STATE_DC_DCMR_T12_B_C2017_12_B1_S101_EDConstruction_Codes_Supplement_of_2017">
              <lex:quote>Administration and enforcement of the Residential Code shall be governed by Chapter 1 of the Building Code, Title 12-A DCMR.</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_permit_required_r21_in0">
          <text>"dc"</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r21_in1">
          <text>"shed"</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r21_in2">
          <text>&lt;= 50</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r21_in3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r21_in4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r21_in5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r21_in6">
          <text>&lt; 10</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r21_in7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r21_in8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r21_in9">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r21_in10">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r21_in11">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r21_in12">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r21_in13">
          <text>false</text>
        </inputEntry>

          <text>"no"</text>
        </outputEntry>
        <outputEntry id="d_permit_required_r52_out1">
          <text>"13VAC5-63-20 D item 11"</text>
        </outputEntry>
        <outputEntry id="d_permit_required_r52_out2">
          <text>"Exempt from the USBC altogether (102.3 item 11): an off-site manufactured freight, moving or storage container placed on the lot, temporarily or permanently, for use as a storage container, whatever its size. A container fitted out for another use is not covered. Local zoning and floodplain rules still apply. This assumes no wiring, plumbing, gas or mechanical work; with such work, ask the building official."</text>
        </outputEntry>
        <annotationEntry>
          <text>13VAC5-63-20 D (USBC 102.3), item 11; 13VAC5-63-20 D (USBC 102.3): “Off-site manufactured intermodal freight containers, moving containers, and storage containers placed on site temporarily or permanently for use as a storage container.”</text>
        </annotationEntry>
      </rule>
      <rule id="d_permit_required_r53">
        <description>VA: farm building or structure, not in a flood plain</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="13VAC5-63-20 D (USBC 102.3), item 9" section="13VAC5-63-20" subsection="D/9" code="VAC" jurisdiction="va" grounding="explicit" url="https://law.lis.virginia.gov/admincode/title13/agency5/chapter63/section20/" corpus="regulations" actId="STATE_VA_ADC_13_5_63_20">
              <lex:quote>Farm buildings and structures, except for a building or a portion of a building located on a farm that is operated as a restaurant as defined in § 35.1-1 of the Code of Virginia and licensed as such by the Virginia State Board of Health pursuant to Chapter 2 (§ 35.1-11 et seq.) of Title 35.1 of the Code of Virginia.</lex:quote>
            </lex:source>
            <lex:source citation="13VAC5-63-200 (USBC 202), Farm building or structure" section="13VAC5-63-200" subsection="A" code="VAC" jurisdiction="va" grounding="explicit" url="https://law.lis.virginia.gov/admincode/title13/agency5/chapter63/section200/" corpus="regulations" actId="STATE_VA_ADC_13_5_63_200">
              <lex:quote>Farm building or structure. A building or structure not used for residential purposes, located on property where farming operations take place, and used primarily for any of the following uses:</lex:quote>
            </lex:source>
            <lex:source citation="13VAC5-63-20 D (USBC 102.3)" section="13VAC5-63-20" subsection="D" code="VAC" jurisdiction="va" grounding="explicit" url="https://law.lis.virginia.gov/admincode/title13/agency5/chapter63/section20/" corpus="regulations" actId="STATE_VA_ADC_13_5_63_20">
              <lex:quote>The following are exempt from this code</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_permit_required_r53_in0">
          <text>"va"</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r53_in1">
          <text>"farm_building"</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r53_in2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r53_in3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r53_in4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r53_in5">
          <text>-</text>
        </inputEntry>

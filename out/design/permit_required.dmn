            </lex:source>
            <lex:source citation="12-A DCMR 105.2.5" section="12-A DCMR 105" subsection="105.2.5" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile={64284980-8CFE-4134-BB96-94FBB25965E0}" corpus="regulations" actId="STATE_DC_DCMR_T12_A_C2017_12_A1_S105_EDConstruction_Codes_Supplement_of_2017">
              <lex:quote>and 10. Retaining walls</lex:quote>

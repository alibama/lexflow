        <outputEntry id="d_permit_required_r32_out2">
          <text>"No item of 105.2 covers decks, so 105.1 requires a permit to construct one."</text>
        </outputEntry>
        <annotationEntry>
          <text>12-A DCMR 105.1 (reading): “Construct, enlarge, alter, repair, move, demolish, raze, or change the occupancy of a building or other structure”</text>
        </annotationEntry>
      </rule>
      <rule id="d_permit_required_r33">
        <description>DC: replacing deck boards or railings, not in a Flood Hazard Area</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="12-A DCMR 105.2.2" section="12-A DCMR 105" subsection="105.2.2" code="DCMR" jurisdiction="dc" grounding="implied" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile={64284980-8CFE-4134-BB96-94FBB25965E0}" corpus="regulations" actId="STATE_DC_DCMR_T12_A_C2017_12_A1_S105_EDConstruction_Codes_Supplement_of_2017">
              <lex:quote>Permits are not required for ordinary repairs to buildings, other structures or equipment.</lex:quote>
              <lex:note>Reading: 105.2.2 says only what ordinary repairs exclude, so whether resurfacing is one is not settled by the text; ask the code official.</lex:note>
            </lex:source>
            <lex:source citation="12-A DCMR 105.2.2" section="12-A DCMR 105" subsection="105.2.2" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile={64284980-8CFE-4134-BB96-94FBB25965E0}" corpus="regulations" actId="STATE_DC_DCMR_T12_A_C2017_12_A1_S105_EDConstruction_Codes_Supplement_of_2017">
              <lex:quote>the removal or cutting of any structural beam or load bearing support</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_permit_required_r33_in0">
          <text>"dc"</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r33_in1">
          <text>"deck_resurfacing"</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r33_in2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r33_in3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r33_in4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r33_in5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r33_in6">
          <text>-</text>
        </inputEntry>

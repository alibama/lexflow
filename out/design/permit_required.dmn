  <knowledgeSource id="ks_va220" name="13VAC5-63-220 (USBC Chapter 4 amendments, Section 429)" locationURI="https://law.lis.virginia.gov/admincode/title13/agency5/chapter63/section220/">
    <description>Section 429.5: the code's permit requirements apply to the site work for an industrialized building, which 102.3 item 8 otherwise exempts.</description>
    <extensionElements>
      <lex:reference citation="13VAC5-63-220" state="va" corpus="regulations" kind="regulation" actId="STATE_VA_ADC_13_5_63_220" indexTitle="Chapter 4 Special detailed requirements based on use and occupancy"/>

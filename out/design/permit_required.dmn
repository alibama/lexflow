          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r39_in3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r39_in4">
          <text>-</text>
        </inputEntry>

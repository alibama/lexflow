      <rule id="d_permit_required_r47">
        <description>NC: new deck or deck framing</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="N.C. Gen. Stat. § 160D-1110(c)(1)" section="160D-1110" subsection="c/1" code="N.C. Gen. Stat." jurisdiction="nc" grounding="implied" url="https://www.ncleg.gov/EnactedLegislation/Statutes/HTML/BySection/Chapter_160D/GS_160D-1110.html" corpus="statutes" actId="STATE_NC_C160D_S160D-1110">
              <lex:quote>The addition, repair, or replacement of load-bearing structures.</lex:quote>
              <lex:note>Reading: posts, beams and joists of a deck are load-bearing structures.</lex:note>
            </lex:source>
            <lex:source citation="N.C. Gen. Stat. § 160D-1110(a)(1)" section="160D-1110" subsection="a/1" code="N.C. Gen. Stat." jurisdiction="nc" grounding="explicit" url="https://www.ncleg.gov/EnactedLegislation/Statutes/HTML/BySection/Chapter_160D/GS_160D-1110.html" corpus="statutes" actId="STATE_NC_C160D_S160D-1110">
              <lex:quote>The construction, reconstruction, alteration, repair, movement to another site, removal, or demolition of any building or structure.</lex:quote>
            </lex:source>
            <lex:source citation="N.C. Gen. Stat. § 160D-1110(a)" section="160D-1110" subsection="a" code="N.C. Gen. Stat." jurisdiction="nc" grounding="implied" url="https://www.ncleg.gov/EnactedLegislation/Statutes/HTML/BySection/Chapter_160D/GS_160D-1110.html" corpus="statutes" actId="STATE_NC_C160D_S160D-1110">
              <lex:quote>no person shall commence or proceed with any of the following without first securing all permits required by the North Carolina State Building Code and any other State or local laws applicable to any of the following activities</lex:quote>
              <lex:note>Reading: the State Building Code's own permit section (not on disk) requires a permit for this work.</lex:note>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_permit_required_r47_in0">
          <text>"nc"</text>
        </inputEntry>

      <rule id="d_permit_required_r58">
        <description>DC: replacing deck boards or railings in a Flood Hazard Area</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="12-A DCMR 105.2.6" section="12-A DCMR 105" subsection="105.2.6" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile={64284980-8CFE-4134-BB96-94FBB25965E0}" corpus="regulations" actId="STATE_DC_DCMR_T12_A_C2017_12_A1_S105_EDConstruction_Codes_Supplement_of_2017">
              <lex:quote>and the work is to occur on premises wholly or partially within a Flood Hazard Area, an application for a permit subject only to review by the Floodplain Administrator shall be required.</lex:quote>
            </lex:source>
            <lex:source citation="12-A DCMR 105.2" section="12-A DCMR 105" subsection="105.2" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile={64284980-8CFE-4134-BB96-94FBB25965E0}" corpus="regulations" actId="STATE_DC_DCMR_T12_A_C2017_12_A1_S105_EDConstruction_Codes_Supplement_of_2017">
              <lex:quote>This Section 105.2 sets forth exemptions from permit requirements, subject to historic and Flood Hazard Area restrictions set forth in Sections 105.2.5 and 105.2.6 respectively.</lex:quote>
            </lex:source>
            <lex:source citation="12-A DCMR 105.2.2" section="12-A DCMR 105" subsection="105.2.2" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile={64284980-8CFE-4134-BB96-94FBB25965E0}" corpus="regulations" actId="STATE_DC_DCMR_T12_A_C2017_12_A1_S105_EDConstruction_Codes_Supplement_of_2017">
              <lex:quote>Permits are not required for ordinary repairs to buildings, other structures or equipment.</lex:quote>
            </lex:source>
            <lex:source citation="12-A DCMR 105.1" section="12-A DCMR 105" subsection="105.1" code="DCMR" jurisdiction="dc" grounding="explicit" url="https://dcregs.dc.gov/Common/DCMR/RuleList.aspx?DownloadFile={64284980-8CFE-4134-BB96-94FBB25965E0}" corpus="regulations" actId="STATE_DC_DCMR_T12_A_C2017_12_A1_S105_EDConstruction_Codes_Supplement_of_2017">
              <lex:quote>Construct, enlarge, alter, repair, move, demolish, raze, or change the occupancy of a building or other structure</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_permit_required_r58_in0">
          <text>"dc"</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r58_in1">
          <text>"deck_resurfacing"</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r58_in2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r58_in3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r58_in4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r58_in5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r58_in6">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r58_in7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r58_in8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r58_in9">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r58_in10">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r58_in11">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r58_in12">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r58_in13">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r58_in14">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r58_in15">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_permit_required_r58_in16">
          <text>-</text>
        </inputEntry>
        <outputEntry id="d_permit_required_r58_out0">
          <text>"yes"</text>
        </outputEntry>
        <outputEntry id="d_permit_required_r58_out1">
          <text>"12-A DCMR 105.2.2, not available under 105.2.6"</text>
        </outputEntry>
        <outputEntry id="d_permit_required_r58_out2">
          <text>"An application is required either way. If the work is an ordinary repair, its exemption is subject to 105.2.6, and in a Flood Hazard Area a permit application subject only to review by the Floodplain Administrator is required; if it is not, 105.1 requires a permit to repair a structure."</text>
        </outputEntry>
        <annotationEntry>
          <text>12-A DCMR 105.2.6; 12-A DCMR 105.2; 12-A DCMR 105.2.2; 12-A DCMR 105.1: “and the work is to occur on premises wholly or partially within a Flood Hazard Area, an application for a permit subject only to review by the Floodplain Administrator shall be required.”</text>
        </annotationEntry>
      </rule>

    <extensionElements>
      <lex:reference role="prerequisite_process" citation="Cal. PEN § 1203.4" direction="outgoing" key="lexflow:statute:ca:Cal. PEN § 1203.4" actId="STATE_CA_Cpen_P2_T8_C1_S1203.4" from="Cal. BPC § 480" span="Section 1203.4" start="4012" end="4026" goldRole="prerequisite_process"/>

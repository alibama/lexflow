        <extensionElements>
          <lex:grounding>
            <lex:source citation="Cal. BPC § 480(a)(1)(B)" section="480" subsection="a.1.B" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>The applicant was convicted of a financial crime currently classified as a felony that is directly and adversely related to the fiduciary qualifications, functions, or duties of the business or profession for which the application is made, pursuant to regulations adopted by the board</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_exception_b_r3_in0">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_exception_b_r3_in1">
          <text>-</text>
        </inputEntry>
        <outputEntry id="d_exception_b_r3_out0">
          <text>false</text>
        </outputEntry>
        <annotationEntry>
          <text>Cal. BPC § 480(a)(1)(B): “The applicant was convicted of a financial crime currently classified as a felony that is directly and adversely related to the fiduciary qualifications, functions, or duties of the business or profession for which the application is made, pursuant to regulations adopted by the board”</text>
        </annotationEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="d_lookback_lifted" name="lookback_lifted" label="(a)(1) 'However': is the seven-year limitation lifted?">
    <description>(a)(1) 'However': is the seven-year limitation lifted?</description>
    <extensionElements>
      <lex:governedBy key="lexflow:statute:ca:Cal. BPC § 480" pinpoint="(a)(1)"/>
    </extensionElements>
    <variable id="d_lookback_lifted_var" name="lookback_lifted" typeRef="boolean"/>
    <informationRequirement id="ir_d_lookback_lifted__d_exception_a">
      <requiredDecision href="#d_exception_a"/>
    </informationRequirement>
    <informationRequirement id="ir_d_lookback_lifted__d_exception_b">
      <requiredDecision href="#d_exception_b"/>
    </informationRequirement>
    <authorityRequirement id="ar_d_lookback_lifted__ks_480_a1">
      <requiredAuthority href="#ks_480_a1"/>
    </authorityRequirement>
    <decisionTable id="d_lookback_lifted_table" hitPolicy="UNIQUE">
      <input id="d_lookback_lifted_in0" label="(a)(1)(A) applies">
        <inputExpression id="d_lookback_lifted_in0_expr" typeRef="boolean">
          <text>exception_a</text>
        </inputExpression>
      </input>
      <input id="d_lookback_lifted_in1" label="(a)(1)(B) applies">
        <inputExpression id="d_lookback_lifted_in1_expr" typeRef="boolean">
          <text>exception_b</text>
        </inputExpression>
      </input>
      <output id="d_lookback_lifted_out0" label="Seven-year limitation lifted" typeRef="boolean"/>
      <annotation name="Source"/>
      <rule id="d_lookback_lifted_r1">
        <description>(A) and (B): same effect, so no conflict (Cal. BPC § 480(a)(1))</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Cal. BPC § 480(a)(1)" section="480" subsection="a.1" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>However, the preceding seven-year limitation shall not apply in either of the following situations:</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_lookback_lifted_r1_in0">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_lookback_lifted_r1_in1">
          <text>true</text>
        </inputEntry>
        <outputEntry id="d_lookback_lifted_r1_out0">
          <text>true</text>
        </outputEntry>
        <annotationEntry>
          <text>Cal. BPC § 480(a)(1): “However, the preceding seven-year limitation shall not apply in either of the following situations:”</text>
        </annotationEntry>
      </rule>
      <rule id="d_lookback_lifted_r2">
        <description>(A) (Cal. BPC § 480(a)(1))</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Cal. BPC § 480(a)(1)" section="480" subsection="a.1" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>However, the preceding seven-year limitation shall not apply in either of the following situations:</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_lookback_lifted_r2_in0">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_lookback_lifted_r2_in1">
          <text>false</text>
        </inputEntry>
        <outputEntry id="d_lookback_lifted_r2_out0">
          <text>true</text>
        </outputEntry>
        <annotationEntry>
          <text>Cal. BPC § 480(a)(1): “However, the preceding seven-year limitation shall not apply in either of the following situations:”</text>
        </annotationEntry>
      </rule>
      <rule id="d_lookback_lifted_r3">
        <description>(B) (Cal. BPC § 480(a)(1))</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Cal. BPC § 480(a)(1)" section="480" subsection="a.1" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>However, the preceding seven-year limitation shall not apply in either of the following situations:</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_lookback_lifted_r3_in0">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_lookback_lifted_r3_in1">
          <text>true</text>
        </inputEntry>
        <outputEntry id="d_lookback_lifted_r3_out0">
          <text>true</text>
        </outputEntry>
        <annotationEntry>
          <text>Cal. BPC § 480(a)(1): “However, the preceding seven-year limitation shall not apply in either of the following situations:”</text>
        </annotationEntry>
      </rule>
      <rule id="d_lookback_lifted_r4">
        <description>Neither situation: the limitation applies (Cal. BPC § 480(a)(1))</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Cal. BPC § 480(a)(1)" section="480" subsection="a.1" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>However, the preceding seven-year limitation shall not apply in either of the following situations:</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_lookback_lifted_r4_in0">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_lookback_lifted_r4_in1">
          <text>false</text>
        </inputEntry>
        <outputEntry id="d_lookback_lifted_r4_out0">
          <text>false</text>
        </outputEntry>
        <annotationEntry>
          <text>Cal. BPC § 480(a)(1): “However, the preceding seven-year limitation shall not apply in either of the following situations:”</text>
        </annotationEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="d_conviction_recent" name="conviction_recent" label="(a)(1) Convicted within the preceding seven years from the date of application?">
    <description>(a)(1) Convicted within the preceding seven years from the date of application?</description>
    <extensionElements>
      <lex:grounding>
        <lex:source citation="Cal. BPC § 480(a)(1)" section="480" subsection="a.1" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
          <lex:quote>within the preceding seven years from the date of application</lex:quote>
          <lex:note>Boundary: the anniversary itself counts as within (&gt;=), and a conviction after the date of application does not precede it (&lt;=).  The text settles neither; flag per Monat et al. 2024.</lex:note>
        </lex:source>
      </lex:grounding>
      <lex:governedBy key="lexflow:statute:ca:Cal. BPC § 480" pinpoint="(a)(1)"/>
    </extensionElements>
    <variable id="d_conviction_recent_var" name="conviction_recent" typeRef="boolean"/>
    <informationRequirement id="ir_d_conviction_recent__in_application_date">
      <requiredInput href="#in_application_date"/>
    </informationRequirement>
    <informationRequirement id="ir_d_conviction_recent__in_conviction_date">
      <requiredInput href="#in_conviction_date"/>
    </informationRequirement>
    <authorityRequirement id="ar_d_conviction_recent__ks_480_a1">
      <requiredAuthority href="#ks_480_a1"/>
    </authorityRequirement>
    <literalExpression id="d_conviction_recent_expr" typeRef="boolean">
      <text>conviction_date != null and conviction_date &gt;= application_date - duration("P7Y") and conviction_date &lt;= application_date</text>
    </literalExpression>
  </decision>
  <decision id="d_incarceration_recent" name="incarceration_recent" label="(a)(1) Presently incarcerated, or released within the preceding seven years?">
    <description>(a)(1) Presently incarcerated, or released within the preceding seven years?</description>
    <extensionElements>
      <lex:grounding>
        <lex:source citation="Cal. BPC § 480(a)(1)" section="480" subsection="a.1" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
          <lex:quote>for which the applicant is presently incarcerated or for which the applicant was released from incarceration within the preceding seven years from the date of application</lex:quote>
          <lex:note>Boundary as in conviction_recent: a release on the seventh anniversary counts as within (&gt;=), and a release after the date of application does not precede it (&lt;=).  'Presently incarcerated' is taken as the input states it: the text does not say whether it means on the date of application or when the board decides, and the two differ for an applicant who was incarcerated on the date of application and released before the decision, and for one first incarcerated after the date of application and still incarcerated when the board decides.</lex:note>
        </lex:source>
      </lex:grounding>
      <lex:governedBy key="lexflow:statute:ca:Cal. BPC § 480" pinpoint="(a)(1)"/>
    </extensionElements>
    <variable id="d_incarceration_recent_var" name="incarceration_recent" typeRef="boolean"/>
    <informationRequirement id="ir_d_incarceration_recent__in_application_date">
      <requiredInput href="#in_application_date"/>
    </informationRequirement>
    <informationRequirement id="ir_d_incarceration_recent__in_presently_incarcerated">
      <requiredInput href="#in_presently_incarcerated"/>
    </informationRequirement>
    <informationRequirement id="ir_d_incarceration_recent__in_release_date">
      <requiredInput href="#in_release_date"/>
    </informationRequirement>
    <authorityRequirement id="ar_d_incarceration_recent__ks_480_a1">
      <requiredAuthority href="#ks_480_a1"/>
    </authorityRequirement>
    <literalExpression id="d_incarceration_recent_expr" typeRef="boolean">
      <text>presently_incarcerated = true or (release_date != null and release_date &gt;= application_date - duration("P7Y") and release_date &lt;= application_date)</text>
    </literalExpression>
  </decision>
  <decision id="d_conviction_ground" name="conviction_ground" label="(a)(1) Conviction ground met?">
    <description>(a)(1) Conviction ground met?</description>
    <extensionElements>
      <lex:governedBy key="lexflow:statute:ca:Cal. BPC § 480" pinpoint="(a) (a)(1) (d) (h)"/>
    </extensionElements>
    <variable id="d_conviction_ground_var" name="conviction_ground" typeRef="boolean"/>
    <informationRequirement id="ir_d_conviction_ground__in_disposition">
      <requiredInput href="#in_disposition"/>
    </informationRequirement>
    <informationRequirement id="ir_d_conviction_ground__in_conviction_final">
      <requiredInput href="#in_conviction_final"/>
    </informationRequirement>
    <informationRequirement id="ir_d_conviction_ground__in_substantially_related">
      <requiredInput href="#in_substantially_related"/>
    </informationRequirement>
    <informationRequirement id="ir_d_conviction_ground__d_conviction_recent">
      <requiredDecision href="#d_conviction_recent"/>
    </informationRequirement>
    <informationRequirement id="ir_d_conviction_ground__d_incarceration_recent">
      <requiredDecision href="#d_incarceration_recent"/>
    </informationRequirement>
    <informationRequirement id="ir_d_conviction_ground__d_lookback_lifted">
      <requiredDecision href="#d_lookback_lifted"/>
    </informationRequirement>
    <authorityRequirement id="ar_d_conviction_ground__ks_480_a">
      <requiredAuthority href="#ks_480_a"/>
    </authorityRequirement>
    <authorityRequirement id="ar_d_conviction_ground__ks_480_a1">
      <requiredAuthority href="#ks_480_a1"/>
    </authorityRequirement>
    <authorityRequirement id="ar_d_conviction_ground__ks_480_d">
      <requiredAuthority href="#ks_480_d"/>
    </authorityRequirement>
    <authorityRequirement id="ar_d_conviction_ground__ks_480_h">
      <requiredAuthority href="#ks_480_h"/>
    </authorityRequirement>
    <authorityRequirement id="ar_d_conviction_ground__ks_bpc_7_5">
      <requiredAuthority href="#ks_bpc_7_5"/>
    </authorityRequirement>
    <authorityRequirement id="ar_d_conviction_ground__ks_bpc_481">
      <requiredAuthority href="#ks_bpc_481"/>
    </authorityRequirement>
    <decisionTable id="d_conviction_ground_table" hitPolicy="UNIQUE">
      <input id="d_conviction_ground_in0" label="Disposition">
        <inputExpression id="d_conviction_ground_in0_expr" typeRef="string">
          <text>disposition</text>
        </inputExpression>
        <inputValues id="d_conviction_ground_in0_values">
          <text>"conviction","other"</text>
        </inputValues>
      </input>
      <input id="d_conviction_ground_in1" label="Final for board action (§ 7.5(a))">
        <inputExpression id="d_conviction_ground_in1_expr" typeRef="boolean">
          <text>conviction_final</text>
        </inputExpression>
      </input>
      <input id="d_conviction_ground_in2" label="Substantially related">
        <inputExpression id="d_conviction_ground_in2_expr" typeRef="boolean">
          <text>substantially_related</text>
        </inputExpression>
      </input>
      <input id="d_conviction_ground_in3" label="Convicted within 7 years">
        <inputExpression id="d_conviction_ground_in3_expr" typeRef="boolean">
          <text>conviction_recent</text>
        </inputExpression>
      </input>
      <input id="d_conviction_ground_in4" label="Incarcerated, or released within 7 years">
        <inputExpression id="d_conviction_ground_in4_expr" typeRef="boolean">
          <text>incarceration_recent</text>
        </inputExpression>
      </input>
      <input id="d_conviction_ground_in5" label="Limitation lifted ((A) or (B))">
        <inputExpression id="d_conviction_ground_in5_expr" typeRef="boolean">
          <text>lookback_lifted</text>
        </inputExpression>
      </input>
      <output id="d_conviction_ground_out0" label="Conviction ground met" typeRef="boolean"/>
      <annotation name="Source"/>
      <rule id="d_conviction_ground_r1">
        <description>No conviction in the sense of § 7.5: an arrest alone is never a ground (Cal. BPC § 480(d); Cal. BPC § 480(h))</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Cal. BPC § 480(d)" section="480" subsection="d" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>a board shall not deny a license on the basis of an arrest that resulted in a disposition other than a conviction</lex:quote>
            </lex:source>
            <lex:source citation="Cal. BPC § 480(h)" section="480" subsection="h" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>as used in this section shall have the same meaning as defined in Section 7.5</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_conviction_ground_r1_in0">
          <text>not("conviction")</text>
        </inputEntry>
        <inputEntry id="d_conviction_ground_r1_in1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_conviction_ground_r1_in2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_conviction_ground_r1_in3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_conviction_ground_r1_in4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_conviction_ground_r1_in5">
          <text>-</text>
        </inputEntry>
        <outputEntry id="d_conviction_ground_r1_out0">
          <text>false</text>
        </outputEntry>
        <annotationEntry>
          <text>Cal. BPC § 480(d); Cal. BPC § 480(h): “a board shall not deny a license on the basis of an arrest that resulted in a disposition other than a conviction”</text>
        </annotationEntry>
      </rule>
      <rule id="d_conviction_ground_r2">
        <description>Not substantially related (Cal. BPC § 480(a)(1))</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Cal. BPC § 480(a)(1)" section="480" subsection="a.1" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>that is substantially related to the qualifications, functions, or duties of the business or profession for which the application is made</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_conviction_ground_r2_in0">
          <text>"conviction"</text>
        </inputEntry>
        <inputEntry id="d_conviction_ground_r2_in1">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_conviction_ground_r2_in2">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_conviction_ground_r2_in3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_conviction_ground_r2_in4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_conviction_ground_r2_in5">
          <text>-</text>
        </inputEntry>
        <outputEntry id="d_conviction_ground_r2_out0">
          <text>false</text>
        </outputEntry>
        <annotationEntry>
          <text>Cal. BPC § 480(a)(1): “that is substantially related to the qualifications, functions, or duties of the business or profession for which the application is made”</text>
        </annotationEntry>
      </rule>
      <rule id="d_conviction_ground_r3">
        <description>Substantially related conviction within seven years (Cal. BPC § 480(a)(1))</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Cal. BPC § 480(a)(1)" section="480" subsection="a.1" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>The applicant has been convicted of a crime within the preceding seven years from the date of application that is substantially related to the qualifications, functions, or duties of the business or profession for which the application is made, regardless of whether the applicant was incarcerated for that crime</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_conviction_ground_r3_in0">
          <text>"conviction"</text>
        </inputEntry>
        <inputEntry id="d_conviction_ground_r3_in1">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_conviction_ground_r3_in2">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_conviction_ground_r3_in3">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_conviction_ground_r3_in4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_conviction_ground_r3_in5">
          <text>-</text>
        </inputEntry>
        <outputEntry id="d_conviction_ground_r3_out0">
          <text>true</text>
        </outputEntry>
        <annotationEntry>
          <text>Cal. BPC § 480(a)(1): “The applicant has been convicted of a crime within the preceding seven years from the date of application that is substantially related to the qualifications, functions, or duties of the business or profession for which the application is made, regardless of whether the applicant was incarcerated for that crime”</text>
        </annotationEntry>
      </rule>
      <rule id="d_conviction_ground_r4">
        <description>Substantially related; incarcerated, or released within seven years (Cal. BPC § 480(a)(1))</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Cal. BPC § 480(a)(1)" section="480" subsection="a.1" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>for which the applicant is presently incarcerated or for which the applicant was released from incarceration within the preceding seven years from the date of application</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_conviction_ground_r4_in0">
          <text>"conviction"</text>
        </inputEntry>
        <inputEntry id="d_conviction_ground_r4_in1">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_conviction_ground_r4_in2">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_conviction_ground_r4_in3">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_conviction_ground_r4_in4">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_conviction_ground_r4_in5">
          <text>-</text>
        </inputEntry>
        <outputEntry id="d_conviction_ground_r4_out0">
          <text>true</text>
        </outputEntry>
        <annotationEntry>
          <text>Cal. BPC § 480(a)(1): “for which the applicant is presently incarcerated or for which the applicant was released from incarceration within the preceding seven years from the date of application”</text>
        </annotationEntry>
      </rule>
      <rule id="d_conviction_ground_r5">
        <description>Older, but the limitation does not apply ((A) or (B)) (Cal. BPC § 480(a)(1))</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Cal. BPC § 480(a)(1)" section="480" subsection="a.1" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>However, the preceding seven-year limitation shall not apply in either of the following situations:</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_conviction_ground_r5_in0">
          <text>"conviction"</text>
        </inputEntry>
        <inputEntry id="d_conviction_ground_r5_in1">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_conviction_ground_r5_in2">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_conviction_ground_r5_in3">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_conviction_ground_r5_in4">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_conviction_ground_r5_in5">
          <text>true</text>
        </inputEntry>
        <outputEntry id="d_conviction_ground_r5_out0">
          <text>true</text>
        </outputEntry>
        <annotationEntry>
          <text>Cal. BPC § 480(a)(1): “However, the preceding seven-year limitation shall not apply in either of the following situations:”</text>
        </annotationEntry>
      </rule>
      <rule id="d_conviction_ground_r6">
        <description>Older than seven years and no exception (Cal. BPC § 480(a))</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Cal. BPC § 480(a)" section="480" subsection="a" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>a board may deny a license regulated by this code on the grounds that the applicant has been convicted of a crime or has been subject to formal discipline only if either of the following conditions are met</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_conviction_ground_r6_in0">
          <text>"conviction"</text>
        </inputEntry>
        <inputEntry id="d_conviction_ground_r6_in1">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_conviction_ground_r6_in2">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_conviction_ground_r6_in3">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_conviction_ground_r6_in4">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_conviction_ground_r6_in5">
          <text>false</text>
        </inputEntry>
        <outputEntry id="d_conviction_ground_r6_out0">
          <text>false</text>
        </outputEntry>
        <annotationEntry>
          <text>Cal. BPC § 480(a): “a board may deny a license regulated by this code on the grounds that the applicant has been convicted of a crime or has been subject to formal discipline only if either of the following conditions are met”</text>
        </annotationEntry>
      </rule>
      <rule id="d_conviction_ground_r7">
        <description>Conviction not yet final for board action (Cal. BPC § 7.5(a); Cal. BPC § 480(h))</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Cal. BPC § 7.5(a)" section="7.5" subsection="a" code="Cal. BPC" jurisdiction="ca" grounding="implied" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=7.5.">
              <lex:quote>Any action which a board is permitted to take following the establishment of a conviction may be taken when the time for appeal has elapsed, or the judgment of conviction has been affirmed on appeal or when an order granting probation is made suspending the imposition of sentence.</lex:quote>
              <lex:note>Reading: 'may be taken when' fixes when a board may act on a conviction, so until the conviction is final in this sense the (a)(1) ground is not yet available.</lex:note>
            </lex:source>
            <lex:source citation="Cal. BPC § 480(h)" section="480" subsection="h" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>as used in this section shall have the same meaning as defined in Section 7.5</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_conviction_ground_r7_in0">
          <text>"conviction"</text>
        </inputEntry>
        <inputEntry id="d_conviction_ground_r7_in1">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_conviction_ground_r7_in2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_conviction_ground_r7_in3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_conviction_ground_r7_in4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_conviction_ground_r7_in5">
          <text>-</text>
        </inputEntry>
        <outputEntry id="d_conviction_ground_r7_out0">
          <text>false</text>
        </outputEntry>
        <annotationEntry>
          <text>Cal. BPC § 7.5(a) (reading); Cal. BPC § 480(h): “Any action which a board is permitted to take following the establishment of a conviction may be taken when the time for appeal has elapsed, or the judgment of conviction has been affirmed on appeal or when an order granting probation is made suspending the imposition of sentence.”</text>
        </annotationEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="d_discipline_recent" name="discipline_recent" label="(a)(2) Formal discipline within the preceding seven years?">
    <description>(a)(2) Formal discipline within the preceding seven years?</description>
    <extensionElements>
      <lex:grounding>
        <lex:source citation="Cal. BPC § 480(a)(2)" section="480" subsection="a.2" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
          <lex:quote>The applicant has been subjected to formal discipline by a licensing board in or outside California within the preceding seven years from the date of application</lex:quote>
          <lex:note>Boundary as in conviction_recent: the anniversary counts as within (&gt;=), and a date after the application does not precede it (&lt;=). A null date is false here and in discipline_older.</lex:note>
        </lex:source>
      </lex:grounding>
      <lex:governedBy key="lexflow:statute:ca:Cal. BPC § 480" pinpoint="(a)(2)"/>
    </extensionElements>
    <variable id="d_discipline_recent_var" name="discipline_recent" typeRef="boolean"/>
    <informationRequirement id="ir_d_discipline_recent__in_application_date">
      <requiredInput href="#in_application_date"/>
    </informationRequirement>
    <informationRequirement id="ir_d_discipline_recent__in_discipline_date">
      <requiredInput href="#in_discipline_date"/>
    </informationRequirement>
    <authorityRequirement id="ar_d_discipline_recent__ks_480_a2">
      <requiredAuthority href="#ks_480_a2"/>
    </authorityRequirement>
    <literalExpression id="d_discipline_recent_expr" typeRef="boolean">
      <text>discipline_date != null and discipline_date &gt;= application_date - duration("P7Y") and discipline_date &lt;= application_date</text>
    </literalExpression>
  </decision>
  <decision id="d_discipline_older" name="discipline_older" label="(a)(2) Formal discipline earlier than seven years preceding the date of application?">
    <description>(a)(2) Formal discipline earlier than seven years preceding the date of application?</description>
    <extensionElements>
      <lex:grounding>
        <lex:source citation="Cal. BPC § 480(a)(2)" section="480" subsection="a.2" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
          <lex:quote>Formal discipline that occurred earlier than seven years preceding the date of application may be grounds for denial of a license only if</lex:quote>
          <lex:note>Strictly earlier (&lt;) than the date seven years before the application, so the anniversary falls in discipline_recent, not here. A null date, or a date after the application, is neither recent nor older.</lex:note>
        </lex:source>
      </lex:grounding>
      <lex:governedBy key="lexflow:statute:ca:Cal. BPC § 480" pinpoint="(a)(2)"/>
    </extensionElements>
    <variable id="d_discipline_older_var" name="discipline_older" typeRef="boolean"/>
    <informationRequirement id="ir_d_discipline_older__in_application_date">
      <requiredInput href="#in_application_date"/>
    </informationRequirement>
    <informationRequirement id="ir_d_discipline_older__in_discipline_date">
      <requiredInput href="#in_discipline_date"/>
    </informationRequirement>
    <authorityRequirement id="ar_d_discipline_older__ks_480_a2">
      <requiredAuthority href="#ks_480_a2"/>
    </authorityRequirement>
    <literalExpression id="d_discipline_older_expr" typeRef="boolean">
      <text>discipline_date != null and discipline_date &lt; application_date - duration("P7Y")</text>
    </literalExpression>
  </decision>

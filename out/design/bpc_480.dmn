      <input id="d_discipline_ground_in7" label="BPC § 726 / § 729(a) conduct">
        <inputExpression id="d_discipline_ground_in7_expr" typeRef="boolean">
          <text>sexual_misconduct_726_729</text>
        </inputExpression>
      </input>
      <output id="d_discipline_ground_out0" label="Discipline ground met" typeRef="boolean"/>
      <annotation name="Source"/>
      <rule id="d_discipline_ground_r1">
        <description>No formal discipline (Cal. BPC § 480(a)(2))</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Cal. BPC § 480(a)(2)" section="480" subsection="a.2" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>The applicant has been subjected to formal discipline by a licensing board in or outside California within the preceding seven years from the date of application</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_discipline_ground_r1_in0">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r1_in1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r1_in2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r1_in3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r1_in4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r1_in5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r1_in6">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r1_in7">
          <text>-</text>
        </inputEntry>
        <outputEntry id="d_discipline_ground_r1_out0">
          <text>false</text>
        </outputEntry>
        <annotationEntry>
          <text>Cal. BPC § 480(a)(2): “The applicant has been subjected to formal discipline by a licensing board in or outside California within the preceding seven years from the date of application”</text>
        </annotationEntry>
      </rule>
      <rule id="d_discipline_ground_r2">
        <description>Not misconduct that would be cause for discipline here (Cal. BPC § 480(a)(2))</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Cal. BPC § 480(a)(2)" section="480" subsection="a.2" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>based on professional misconduct that would have been cause for discipline before the board for which the present application is made</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_discipline_ground_r2_in0">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r2_in1">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r2_in2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r2_in3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r2_in4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r2_in5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r2_in6">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r2_in7">
          <text>-</text>
        </inputEntry>
        <outputEntry id="d_discipline_ground_r2_out0">
          <text>false</text>
        </outputEntry>
        <annotationEntry>
          <text>Cal. BPC § 480(a)(2): “based on professional misconduct that would have been cause for discipline before the board for which the present application is made”</text>
        </annotationEntry>
      </rule>
      <rule id="d_discipline_ground_r3">
        <description>Not substantially related (Cal. BPC § 480(a)(2))</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Cal. BPC § 480(a)(2)" section="480" subsection="a.2" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>and that is substantially related to the qualifications, functions, or duties of the business or profession for which the present application is made</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_discipline_ground_r3_in0">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r3_in1">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r3_in2">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r3_in3">
          <text>-</text>

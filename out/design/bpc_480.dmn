          <text>-</text>
        </inputEntry>
        <outputEntry id="d_discipline_ground_r5_out0">
          <text>true</text>
        </outputEntry>
        <annotationEntry>
          <text>Cal. BPC § 480(a)(2): “The applicant has been subjected to formal discipline by a licensing board in or outside California within the preceding seven years from the date of application”</text>
        </annotationEntry>
      </rule>
      <rule id="d_discipline_ground_r6">
        <description>Discipline within seven years; its conviction is not dismissed (Cal. BPC § 480(a)(2))</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Cal. BPC § 480(a)(2)" section="480" subsection="a.2" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>The applicant has been subjected to formal discipline by a licensing board in or outside California within the preceding seven years from the date of application</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_discipline_ground_r6_in0">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r6_in1">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r6_in2">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r6_in3">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r6_in4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r6_in5">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r6_in6">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r6_in7">
          <text>-</text>
        </inputEntry>
        <outputEntry id="d_discipline_ground_r6_out0">
          <text>true</text>
        </outputEntry>
        <annotationEntry>
          <text>Cal. BPC § 480(a)(2): “The applicant has been subjected to formal discipline by a licensing board in or outside California within the preceding seven years from the date of application”</text>
        </annotationEntry>
      </rule>
      <rule id="d_discipline_ground_r7">
        <description>Discipline earlier than seven years preceding the application, for § 726 / § 729(a) conduct (Cal. BPC § 480(a)(2))</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Cal. BPC § 480(a)(2)" section="480" subsection="a.2" code="Cal. BPC" jurisdiction="ca" grounding="implied" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>Formal discipline that occurred earlier than seven years preceding the date of application may be grounds for denial of a license only if the formal discipline was for conduct that, if committed in this state by a physician and surgeon licensed pursuant to Chapter 5 (commencing with Section 2000) of Division 2, would have constituted an act of sexual abuse, misconduct, or relations with a patient pursuant to Section 726 or sexual exploitation as defined in subdivision (a) of Section 729.</lex:quote>
              <lex:note>Reading: 'only if' adds a necessary condition; the misconduct and substantial-relation requirements of (a)(2) still apply to older discipline.</lex:note>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_discipline_ground_r7_in0">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r7_in1">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r7_in2">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r7_in3">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r7_in4">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r7_in5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r7_in6">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r7_in7">
          <text>true</text>
        </inputEntry>
        <outputEntry id="d_discipline_ground_r7_out0">
          <text>true</text>
        </outputEntry>
        <annotationEntry>
          <text>Cal. BPC § 480(a)(2) (reading): “Formal discipline that occurred earlier than seven years preceding the date of application may be grounds for denial of a license only if the formal discipline was for conduct that, if committed in this state by a physician and surgeon licensed pursuant to Chapter 5 (commencing with Section 2000) of Division 2, would have constituted an act of sexual abuse, misconduct, or relations with a patient pursuant to Section 726 or sexual exploitation as defined in subdivision (a) of Section 729.”</text>
        </annotationEntry>
      </rule>
      <rule id="d_discipline_ground_r8">
        <description>Discipline earlier than seven years preceding the application, not for § 726 / § 729(a) conduct (Cal. BPC § 480(a)(2))</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Cal. BPC § 480(a)(2)" section="480" subsection="a.2" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>Formal discipline that occurred earlier than seven years preceding the date of application may be grounds for denial of a license only if</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_discipline_ground_r8_in0">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r8_in1">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r8_in2">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r8_in3">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r8_in4">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r8_in5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r8_in6">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r8_in7">
          <text>false</text>
        </inputEntry>
        <outputEntry id="d_discipline_ground_r8_out0">
          <text>false</text>
        </outputEntry>
        <annotationEntry>
          <text>Cal. BPC § 480(a)(2): “Formal discipline that occurred earlier than seven years preceding the date of application may be grounds for denial of a license only if”</text>
        </annotationEntry>
      </rule>
      <rule id="d_discipline_ground_r9">
        <description>Reading, not stated in the text: discipline with no date, or dated after the application, is neither within nor earlier than seven years preceding it, so no ground (Cal. BPC § 480(a)(2))</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Cal. BPC § 480(a)(2)" section="480" subsection="a.2" code="Cal. BPC" jurisdiction="ca" grounding="implied" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>The applicant has been subjected to formal discipline by a licensing board in or outside California within the preceding seven years from the date of application</lex:quote>
              <lex:note>Reading: discipline with no known date, or dated after the date of application, is neither 'within the preceding seven years' nor 'earlier than seven years preceding the date of application', so neither sentence makes it a ground. The board needs the date.</lex:note>
            </lex:source>
            <lex:source citation="Cal. BPC § 480(a)(2)" section="480" subsection="a.2" code="Cal. BPC" jurisdiction="ca" grounding="implied" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>Formal discipline that occurred earlier than seven years preceding the date of application may be grounds for denial of a license only if</lex:quote>
              <lex:note>Reading: discipline with no known date, or dated after the date of application, is neither 'within the preceding seven years' nor 'earlier than seven years preceding the date of application', so neither sentence makes it a ground. The board needs the date.</lex:note>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_discipline_ground_r9_in0">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r9_in1">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r9_in2">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r9_in3">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r9_in4">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r9_in5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r9_in6">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_discipline_ground_r9_in7">
          <text>-</text>
        </inputEntry>
        <outputEntry id="d_discipline_ground_r9_out0">
          <text>false</text>
        </outputEntry>
        <annotationEntry>
          <text>Cal. BPC § 480(a)(2) (reading): “The applicant has been subjected to formal discipline by a licensing board in or outside California within the preceding seven years from the date of application”</text>
        </annotationEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="d_rehabilitation_bar" name="rehabilitation_bar" label="(b) Rehabilitation bar applies?">
    <description>(b) Rehabilitation bar applies?</description>
    <extensionElements>
      <lex:governedBy key="lexflow:statute:ca:Cal. BPC § 480" pinpoint="(b)"/>
    </extensionElements>
    <variable id="d_rehabilitation_bar_var" name="rehabilitation_bar" typeRef="boolean"/>
    <informationRequirement id="ir_d_rehabilitation_bar__in_certificate_of_rehabilitation">
      <requiredInput href="#in_certificate_of_rehabilitation"/>
    </informationRequirement>
    <informationRequirement id="ir_d_rehabilitation_bar__in_pardon_or_clemency">
      <requiredInput href="#in_pardon_or_clemency"/>
    </informationRequirement>
    <informationRequirement id="ir_d_rehabilitation_bar__in_showing_of_rehabilitation">
      <requiredInput href="#in_showing_of_rehabilitation"/>
    </informationRequirement>
    <authorityRequirement id="ar_d_rehabilitation_bar__ks_480_b">
      <requiredAuthority href="#ks_480_b"/>
    </authorityRequirement>
    <authorityRequirement id="ar_d_rehabilitation_bar__ks_proc_certificate">
      <requiredAuthority href="#ks_proc_certificate"/>
    </authorityRequirement>
    <authorityRequirement id="ar_d_rehabilitation_bar__ks_bpc_482">
      <requiredAuthority href="#ks_bpc_482"/>
    </authorityRequirement>
    <authorityRequirement id="ar_d_rehabilitation_bar__ks_executive_clemency">
      <requiredAuthority href="#ks_executive_clemency"/>
    </authorityRequirement>
    <decisionTable id="d_rehabilitation_bar_table" hitPolicy="UNIQUE">
      <input id="d_rehabilitation_bar_in0" label="Certificate of rehabilitation">
        <inputExpression id="d_rehabilitation_bar_in0_expr" typeRef="boolean">
          <text>certificate_of_rehabilitation</text>
        </inputExpression>
      </input>
      <input id="d_rehabilitation_bar_in1" label="Clemency or pardon">
        <inputExpression id="d_rehabilitation_bar_in1_expr" typeRef="boolean">
          <text>pardon_or_clemency</text>
        </inputExpression>
      </input>
      <input id="d_rehabilitation_bar_in2" label="Showing of rehabilitation (§ 482)">
        <inputExpression id="d_rehabilitation_bar_in2_expr" typeRef="boolean">
          <text>showing_of_rehabilitation</text>
        </inputExpression>
      </input>
      <output id="d_rehabilitation_bar_out0" label="Rehabilitation bar applies" typeRef="boolean"/>
      <annotation name="Source"/>
      <rule id="d_rehabilitation_bar_r1">
        <description>Certificate of rehabilitation (Cal. BPC § 480(b))</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Cal. BPC § 480(b)" section="480" subsection="b" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>if that person has obtained a certificate of rehabilitation under Chapter 3.5 (commencing with Section 4852.01) of Title 6 of Part 3 of the Penal Code</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_rehabilitation_bar_r1_in0">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_rehabilitation_bar_r1_in1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_rehabilitation_bar_r1_in2">
          <text>-</text>
        </inputEntry>
        <outputEntry id="d_rehabilitation_bar_r1_out0">
          <text>true</text>
        </outputEntry>
        <annotationEntry>
          <text>Cal. BPC § 480(b): “if that person has obtained a certificate of rehabilitation under Chapter 3.5 (commencing with Section 4852.01) of Title 6 of Part 3 of the Penal Code”</text>
        </annotationEntry>
      </rule>
      <rule id="d_rehabilitation_bar_r2">
        <description>Clemency or pardon (Cal. BPC § 480(b))</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Cal. BPC § 480(b)" section="480" subsection="b" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>has been granted clemency or a pardon by a state or federal executive</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_rehabilitation_bar_r2_in0">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_rehabilitation_bar_r2_in1">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_rehabilitation_bar_r2_in2">
          <text>-</text>
        </inputEntry>
        <outputEntry id="d_rehabilitation_bar_r2_out0">
          <text>true</text>
        </outputEntry>
        <annotationEntry>
          <text>Cal. BPC § 480(b): “has been granted clemency or a pardon by a state or federal executive”</text>
        </annotationEntry>
      </rule>
      <rule id="d_rehabilitation_bar_r3">
        <description>Showing of rehabilitation under § 482 (Cal. BPC § 480(b))</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Cal. BPC § 480(b)" section="480" subsection="b" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>or has made a showing of rehabilitation pursuant to Section 482</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_rehabilitation_bar_r3_in0">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_rehabilitation_bar_r3_in1">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_rehabilitation_bar_r3_in2">
          <text>true</text>
        </inputEntry>
        <outputEntry id="d_rehabilitation_bar_r3_out0">
          <text>true</text>
        </outputEntry>
        <annotationEntry>
          <text>Cal. BPC § 480(b): “or has made a showing of rehabilitation pursuant to Section 482”</text>
        </annotationEntry>
      </rule>
      <rule id="d_rehabilitation_bar_r4">
        <description>None of the three (Cal. BPC § 480(b))</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Cal. BPC § 480(b)" section="480" subsection="b" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>Notwithstanding any other provision of this code, a person shall not be denied a license on the basis that the person has been convicted of a crime, or on the basis of acts underlying a conviction for a crime</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_rehabilitation_bar_r4_in0">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_rehabilitation_bar_r4_in1">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_rehabilitation_bar_r4_in2">
          <text>false</text>
        </inputEntry>
        <outputEntry id="d_rehabilitation_bar_r4_out0">
          <text>false</text>
        </outputEntry>
        <annotationEntry>
          <text>Cal. BPC § 480(b): “Notwithstanding any other provision of this code, a person shall not be denied a license on the basis that the person has been convicted of a crime, or on the basis of acts underlying a conviction for a crime”</text>
        </annotationEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="d_dismissal_bar" name="dismissal_bar" label="(c) Dismissal bar applies?">
    <description>(c) Dismissal bar applies?</description>
    <extensionElements>
      <lex:governedBy key="lexflow:statute:ca:Cal. BPC § 480" pinpoint="(c)"/>
    </extensionElements>
    <variable id="d_dismissal_bar_var" name="dismissal_bar" typeRef="boolean"/>
    <informationRequirement id="ir_d_dismissal_bar__in_conviction_dismissed">
      <requiredInput href="#in_conviction_dismissed"/>
    </informationRequirement>
    <authorityRequirement id="ar_d_dismissal_bar__ks_480_c">
      <requiredAuthority href="#ks_480_c"/>
    </authorityRequirement>
    <authorityRequirement id="ar_d_dismissal_bar__ks_proc_record_sealing">
      <requiredAuthority href="#ks_proc_record_sealing"/>
    </authorityRequirement>
    <decisionTable id="d_dismissal_bar_table" hitPolicy="UNIQUE">
      <input id="d_dismissal_bar_in0" label="Conviction dismissed (PEN § 1203.4 et al.)">
        <inputExpression id="d_dismissal_bar_in0_expr" typeRef="boolean">
          <text>conviction_dismissed</text>
        </inputExpression>
      </input>
      <output id="d_dismissal_bar_out0" label="Dismissal bar applies" typeRef="boolean"/>
      <annotation name="Source"/>
      <rule id="d_dismissal_bar_r1">
        <description>Dismissed (Cal. BPC § 480(c))</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Cal. BPC § 480(c)" section="480" subsection="c" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>Notwithstanding any other provision of this code, a person shall not be denied a license on the basis of any conviction, or on the basis of the acts underlying the conviction, that has been dismissed pursuant to Section 1203.4, 1203.4a, 1203.41, 1203.42, or 1203.425 of the Penal Code, or a comparable dismissal or expungement</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_dismissal_bar_r1_in0">
          <text>true</text>
        </inputEntry>
        <outputEntry id="d_dismissal_bar_r1_out0">
          <text>true</text>
        </outputEntry>
        <annotationEntry>
          <text>Cal. BPC § 480(c): “Notwithstanding any other provision of this code, a person shall not be denied a license on the basis of any conviction, or on the basis of the acts underlying the conviction, that has been dismissed pursuant to Section 1203.4, 1203.4a, 1203.41, 1203.42, or 1203.425 of the Penal Code, or a comparable dismissal or expungement”</text>
        </annotationEntry>
      </rule>
      <rule id="d_dismissal_bar_r2">
        <description>Not dismissed (Cal. BPC § 480(c))</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Cal. BPC § 480(c)" section="480" subsection="c" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>Notwithstanding any other provision of this code, a person shall not be denied a license on the basis of any conviction, or on the basis of the acts underlying the conviction, that has been dismissed pursuant to Section 1203.4, 1203.4a, 1203.41, 1203.42, or 1203.425 of the Penal Code, or a comparable dismissal or expungement</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_dismissal_bar_r2_in0">
          <text>false</text>
        </inputEntry>
        <outputEntry id="d_dismissal_bar_r2_out0">
          <text>false</text>
        </outputEntry>
        <annotationEntry>
          <text>Cal. BPC § 480(c): “Notwithstanding any other provision of this code, a person shall not be denied a license on the basis of any conviction, or on the basis of the acts underlying the conviction, that has been dismissed pursuant to Section 1203.4, 1203.4a, 1203.41, 1203.42, or 1203.425 of the Penal Code, or a comparable dismissal or expungement”</text>
        </annotationEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="d_conviction_barred" name="conviction_barred" label="(b), (c) 'Notwithstanding': is a denial on the conviction barred?">
    <description>(b), (c) 'Notwithstanding': is a denial on the conviction barred?</description>
    <extensionElements>
      <lex:governedBy key="lexflow:statute:ca:Cal. BPC § 480" pinpoint="(b) (c)"/>
    </extensionElements>
    <variable id="d_conviction_barred_var" name="conviction_barred" typeRef="boolean"/>
    <informationRequirement id="ir_d_conviction_barred__d_rehabilitation_bar">
      <requiredDecision href="#d_rehabilitation_bar"/>
    </informationRequirement>
    <informationRequirement id="ir_d_conviction_barred__d_dismissal_bar">
      <requiredDecision href="#d_dismissal_bar"/>
    </informationRequirement>
    <authorityRequirement id="ar_d_conviction_barred__ks_480_b">
      <requiredAuthority href="#ks_480_b"/>
    </authorityRequirement>
    <authorityRequirement id="ar_d_conviction_barred__ks_480_c">
      <requiredAuthority href="#ks_480_c"/>
    </authorityRequirement>
    <decisionTable id="d_conviction_barred_table" hitPolicy="UNIQUE">
      <input id="d_conviction_barred_in0" label="(b) applies">
        <inputExpression id="d_conviction_barred_in0_expr" typeRef="boolean">
          <text>rehabilitation_bar</text>
        </inputExpression>
      </input>
      <input id="d_conviction_barred_in1" label="(c) applies">
        <inputExpression id="d_conviction_barred_in1_expr" typeRef="boolean">
          <text>dismissal_bar</text>
        </inputExpression>
      </input>
      <output id="d_conviction_barred_out0" label="Denial on the conviction barred" typeRef="boolean"/>
      <annotation name="Source"/>
      <rule id="d_conviction_barred_r1">
        <description>(b) and (c): same effect, so no conflict (Cal. BPC § 480(b); Cal. BPC § 480(c))</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Cal. BPC § 480(b)" section="480" subsection="b" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>Notwithstanding any other provision of this code, a person shall not be denied a license on the basis that the person has been convicted of a crime, or on the basis of acts underlying a conviction for a crime</lex:quote>
            </lex:source>
            <lex:source citation="Cal. BPC § 480(c)" section="480" subsection="c" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>Notwithstanding any other provision of this code, a person shall not be denied a license on the basis of any conviction, or on the basis of the acts underlying the conviction, that has been dismissed pursuant to Section 1203.4, 1203.4a, 1203.41, 1203.42, or 1203.425 of the Penal Code, or a comparable dismissal or expungement</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_conviction_barred_r1_in0">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_conviction_barred_r1_in1">
          <text>true</text>
        </inputEntry>
        <outputEntry id="d_conviction_barred_r1_out0">
          <text>true</text>
        </outputEntry>
        <annotationEntry>
          <text>Cal. BPC § 480(b); Cal. BPC § 480(c): “Notwithstanding any other provision of this code, a person shall not be denied a license on the basis that the person has been convicted of a crime, or on the basis of acts underlying a conviction for a crime”</text>
        </annotationEntry>
      </rule>
      <rule id="d_conviction_barred_r2">
        <description>(b) (Cal. BPC § 480(b))</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Cal. BPC § 480(b)" section="480" subsection="b" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>Notwithstanding any other provision of this code, a person shall not be denied a license on the basis that the person has been convicted of a crime, or on the basis of acts underlying a conviction for a crime</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_conviction_barred_r2_in0">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_conviction_barred_r2_in1">
          <text>false</text>
        </inputEntry>
        <outputEntry id="d_conviction_barred_r2_out0">
          <text>true</text>
        </outputEntry>
        <annotationEntry>
          <text>Cal. BPC § 480(b): “Notwithstanding any other provision of this code, a person shall not be denied a license on the basis that the person has been convicted of a crime, or on the basis of acts underlying a conviction for a crime”</text>
        </annotationEntry>
      </rule>
      <rule id="d_conviction_barred_r3">
        <description>(c) (Cal. BPC § 480(c))</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Cal. BPC § 480(c)" section="480" subsection="c" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>Notwithstanding any other provision of this code, a person shall not be denied a license on the basis of any conviction, or on the basis of the acts underlying the conviction, that has been dismissed pursuant to Section 1203.4, 1203.4a, 1203.41, 1203.42, or 1203.425 of the Penal Code, or a comparable dismissal or expungement</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_conviction_barred_r3_in0">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_conviction_barred_r3_in1">
          <text>true</text>
        </inputEntry>
        <outputEntry id="d_conviction_barred_r3_out0">
          <text>true</text>
        </outputEntry>
        <annotationEntry>
          <text>Cal. BPC § 480(c): “Notwithstanding any other provision of this code, a person shall not be denied a license on the basis of any conviction, or on the basis of the acts underlying the conviction, that has been dismissed pursuant to Section 1203.4, 1203.4a, 1203.41, 1203.42, or 1203.425 of the Penal Code, or a comparable dismissal or expungement”</text>
        </annotationEntry>
      </rule>
      <rule id="d_conviction_barred_r4">
        <description>Neither bar (Cal. BPC § 480(b); Cal. BPC § 480(c))</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Cal. BPC § 480(b)" section="480" subsection="b" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>Notwithstanding any other provision of this code, a person shall not be denied a license on the basis that the person has been convicted of a crime, or on the basis of acts underlying a conviction for a crime</lex:quote>
            </lex:source>
            <lex:source citation="Cal. BPC § 480(c)" section="480" subsection="c" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>Notwithstanding any other provision of this code, a person shall not be denied a license on the basis of any conviction, or on the basis of the acts underlying the conviction, that has been dismissed pursuant to Section 1203.4, 1203.4a, 1203.41, 1203.42, or 1203.425 of the Penal Code, or a comparable dismissal or expungement</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_conviction_barred_r4_in0">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_conviction_barred_r4_in1">
          <text>false</text>
        </inputEntry>
        <outputEntry id="d_conviction_barred_r4_out0">
          <text>false</text>
        </outputEntry>
        <annotationEntry>
          <text>Cal. BPC § 480(b); Cal. BPC § 480(c): “Notwithstanding any other provision of this code, a person shall not be denied a license on the basis that the person has been convicted of a crime, or on the basis of acts underlying a conviction for a crime”</text>
        </annotationEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="d_may_deny" name="may_deny" label="May the board deny the license on the basis of a conviction or prior discipline?">
    <description>May the board deny the license on the basis of a conviction or prior discipline?</description>
    <extensionElements>
      <lex:decisionMaker actor="board" role="lexflow:role:ca:license_conviction:board" name="Licensing board (BPC § 477(a): includes bureau, commission, committee, department, division, examining committee, program, and agency)"/>
      <lex:governedBy key="lexflow:statute:ca:Cal. BPC § 480" pinpoint="(a) (b) (c)"/>
    </extensionElements>
    <question>May the board deny a license regulated by the Business and Professions Code on the grounds that the applicant was convicted of a crime or was subject to formal discipline (Cal. BPC § 480(a)-(c))?</question>
    <allowedAnswers>may_deny true: a permitted ground exists and no bar reaches it (the board may still grant); false: § 480 forbids denial on these grounds.</allowedAnswers>
    <variable id="d_may_deny_var" name="may_deny"/>
    <informationRequirement id="ir_d_may_deny__d_conviction_barred">
      <requiredDecision href="#d_conviction_barred"/>
    </informationRequirement>
    <informationRequirement id="ir_d_may_deny__d_conviction_ground">
      <requiredDecision href="#d_conviction_ground"/>
    </informationRequirement>
    <informationRequirement id="ir_d_may_deny__d_discipline_ground">
      <requiredDecision href="#d_discipline_ground"/>
    </informationRequirement>
    <informationRequirement id="ir_d_may_deny__in_discipline_rests_on_conviction">
      <requiredInput href="#in_discipline_rests_on_conviction"/>
    </informationRequirement>
    <authorityRequirement id="ar_d_may_deny__ks_480_a">
      <requiredAuthority href="#ks_480_a"/>
    </authorityRequirement>
    <authorityRequirement id="ar_d_may_deny__ks_480_b">
      <requiredAuthority href="#ks_480_b"/>
    </authorityRequirement>
    <authorityRequirement id="ar_d_may_deny__ks_480_c">
      <requiredAuthority href="#ks_480_c"/>
    </authorityRequirement>
    <usingProcess href="https://lexipedia.xyz/ns/process/ca_license_conviction#proc_ca_license_conviction"/>
    <usingTask href="https://lexipedia.xyz/ns/process/ca_license_conviction#decide_ground"/>
    <decisionTable id="d_may_deny_table" hitPolicy="UNIQUE">
      <input id="d_may_deny_in0" label="(b)/(c) bar">
        <inputExpression id="d_may_deny_in0_expr" typeRef="boolean">
          <text>conviction_barred</text>
        </inputExpression>
      </input>
      <input id="d_may_deny_in1" label="(a)(1) ground">
        <inputExpression id="d_may_deny_in1_expr" typeRef="boolean">
          <text>conviction_ground</text>
        </inputExpression>
      </input>
      <input id="d_may_deny_in2" label="(a)(2) ground">
        <inputExpression id="d_may_deny_in2_expr" typeRef="boolean">
          <text>discipline_ground</text>
        </inputExpression>
      </input>
      <input id="d_may_deny_in3" label="Discipline based on the conviction">
        <inputExpression id="d_may_deny_in3_expr" typeRef="boolean">
          <text>discipline_rests_on_conviction</text>
        </inputExpression>
      </input>
      <output id="d_may_deny_out0" label="May deny" name="may_deny" typeRef="boolean"/>
      <output id="d_may_deny_out1" label="Basis" name="basis" typeRef="string"/>
      <annotation name="Source"/>
      <rule id="d_may_deny_r1">
        <description>Override: the conviction ground is ignored (Cal. BPC § 480(b); Cal. BPC § 480(c))</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Cal. BPC § 480(b)" section="480" subsection="b" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>Notwithstanding any other provision of this code, a person shall not be denied a license on the basis that the person has been convicted of a crime, or on the basis of acts underlying a conviction for a crime</lex:quote>
            </lex:source>
            <lex:source citation="Cal. BPC § 480(c)" section="480" subsection="c" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>Notwithstanding any other provision of this code, a person shall not be denied a license on the basis of any conviction, or on the basis of the acts underlying the conviction, that has been dismissed pursuant to Section 1203.4, 1203.4a, 1203.41, 1203.42, or 1203.425 of the Penal Code, or a comparable dismissal or expungement</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_may_deny_r1_in0">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_may_deny_r1_in1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_may_deny_r1_in2">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_may_deny_r1_in3">
          <text>-</text>
        </inputEntry>
        <outputEntry id="d_may_deny_r1_out0">
          <text>false</text>
        </outputEntry>
        <outputEntry id="d_may_deny_r1_out1">
          <text>"Barred by 480(b) or (c); no discipline ground"</text>
        </outputEntry>
        <annotationEntry>
          <text>Cal. BPC § 480(b); Cal. BPC § 480(c): “Notwithstanding any other provision of this code, a person shall not be denied a license on the basis that the person has been convicted of a crime, or on the basis of acts underlying a conviction for a crime”</text>
        </annotationEntry>
      </rule>
      <rule id="d_may_deny_r2">
        <description>Override reaches the discipline (Cal. BPC § 480(b); Cal. BPC § 480(c))</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Cal. BPC § 480(b)" section="480" subsection="b" code="Cal. BPC" jurisdiction="ca" grounding="implied" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>or on the basis of acts underlying a conviction for a crime</lex:quote>
              <lex:note>Reading: a discipline that rests on the acts underlying a conviction is a denial 'on the basis of acts underlying' that conviction, so the (b)/(c) bar reaches it.  The text does not say so in terms.</lex:note>
            </lex:source>
            <lex:source citation="Cal. BPC § 480(c)" section="480" subsection="c" code="Cal. BPC" jurisdiction="ca" grounding="implied" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>or on the basis of the acts underlying the conviction</lex:quote>
              <lex:note>Reading: a discipline that rests on the acts underlying a conviction is a denial 'on the basis of acts underlying' that conviction, so the (b)/(c) bar reaches it.  The text does not say so in terms.</lex:note>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_may_deny_r2_in0">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_may_deny_r2_in1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_may_deny_r2_in2">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_may_deny_r2_in3">
          <text>true</text>
        </inputEntry>
        <outputEntry id="d_may_deny_r2_out0">
          <text>false</text>
        </outputEntry>
        <outputEntry id="d_may_deny_r2_out1">
          <text>"Barred: the discipline rests on the acts underlying the barred conviction"</text>
        </outputEntry>
        <annotationEntry>
          <text>Cal. BPC § 480(b) (reading); Cal. BPC § 480(c) (reading): “or on the basis of acts underlying a conviction for a crime”</text>
        </annotationEntry>
      </rule>
      <rule id="d_may_deny_r3">
        <description>Independent discipline ground (Cal. BPC § 480(a))</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Cal. BPC § 480(a)" section="480" subsection="a" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>a board may deny a license regulated by this code on the grounds that the applicant has been convicted of a crime or has been subject to formal discipline only if either of the following conditions are met</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_may_deny_r3_in0">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_may_deny_r3_in1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="d_may_deny_r3_in2">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_may_deny_r3_in3">
          <text>false</text>
        </inputEntry>
        <outputEntry id="d_may_deny_r3_out0">
          <text>true</text>
        </outputEntry>
        <outputEntry id="d_may_deny_r3_out1">
          <text>"May deny on prior discipline (480(a)(2)) only; the conviction is barred"</text>
        </outputEntry>
        <annotationEntry>
          <text>Cal. BPC § 480(a): “a board may deny a license regulated by this code on the grounds that the applicant has been convicted of a crime or has been subject to formal discipline only if either of the following conditions are met”</text>
        </annotationEntry>
      </rule>
      <rule id="d_may_deny_r4">
        <description>(a)(1) (Cal. BPC § 480(a))</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Cal. BPC § 480(a)" section="480" subsection="a" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>a board may deny a license regulated by this code on the grounds that the applicant has been convicted of a crime or has been subject to formal discipline only if either of the following conditions are met</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_may_deny_r4_in0">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_may_deny_r4_in1">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_may_deny_r4_in2">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_may_deny_r4_in3">
          <text>-</text>
        </inputEntry>
        <outputEntry id="d_may_deny_r4_out0">
          <text>true</text>
        </outputEntry>
        <outputEntry id="d_may_deny_r4_out1">
          <text>"May deny: conviction ground (480(a)(1))"</text>
        </outputEntry>
        <annotationEntry>
          <text>Cal. BPC § 480(a): “a board may deny a license regulated by this code on the grounds that the applicant has been convicted of a crime or has been subject to formal discipline only if either of the following conditions are met”</text>
        </annotationEntry>
      </rule>
      <rule id="d_may_deny_r5">
        <description>(a)(1) and (a)(2) (Cal. BPC § 480(a))</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Cal. BPC § 480(a)" section="480" subsection="a" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>a board may deny a license regulated by this code on the grounds that the applicant has been convicted of a crime or has been subject to formal discipline only if either of the following conditions are met</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_may_deny_r5_in0">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_may_deny_r5_in1">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_may_deny_r5_in2">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_may_deny_r5_in3">
          <text>-</text>
        </inputEntry>
        <outputEntry id="d_may_deny_r5_out0">
          <text>true</text>
        </outputEntry>
        <outputEntry id="d_may_deny_r5_out1">
          <text>"May deny: conviction (480(a)(1)) and discipline (480(a)(2)) grounds"</text>
        </outputEntry>
        <annotationEntry>
          <text>Cal. BPC § 480(a): “a board may deny a license regulated by this code on the grounds that the applicant has been convicted of a crime or has been subject to formal discipline only if either of the following conditions are met”</text>
        </annotationEntry>
      </rule>
      <rule id="d_may_deny_r6">
        <description>(a)(2) (Cal. BPC § 480(a))</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Cal. BPC § 480(a)" section="480" subsection="a" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>a board may deny a license regulated by this code on the grounds that the applicant has been convicted of a crime or has been subject to formal discipline only if either of the following conditions are met</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_may_deny_r6_in0">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_may_deny_r6_in1">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_may_deny_r6_in2">
          <text>true</text>
        </inputEntry>
        <inputEntry id="d_may_deny_r6_in3">
          <text>-</text>
        </inputEntry>
        <outputEntry id="d_may_deny_r6_out0">
          <text>true</text>
        </outputEntry>
        <outputEntry id="d_may_deny_r6_out1">
          <text>"May deny: prior discipline (480(a)(2))"</text>
        </outputEntry>
        <annotationEntry>
          <text>Cal. BPC § 480(a): “a board may deny a license regulated by this code on the grounds that the applicant has been convicted of a crime or has been subject to formal discipline only if either of the following conditions are met”</text>
        </annotationEntry>
      </rule>
      <rule id="d_may_deny_r7">
        <description>Neither condition is met (Cal. BPC § 480(a))</description>
        <extensionElements>
          <lex:grounding>
            <lex:source citation="Cal. BPC § 480(a)" section="480" subsection="a" code="Cal. BPC" jurisdiction="ca" grounding="explicit" url="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=BPC&amp;sectionNum=480.">
              <lex:quote>only if either of the following conditions are met</lex:quote>
            </lex:source>
          </lex:grounding>
        </extensionElements>
        <inputEntry id="d_may_deny_r7_in0">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_may_deny_r7_in1">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_may_deny_r7_in2">
          <text>false</text>
        </inputEntry>
        <inputEntry id="d_may_deny_r7_in3">
          <text>-</text>
        </inputEntry>
        <outputEntry id="d_may_deny_r7_out0">
          <text>false</text>
        </outputEntry>
        <outputEntry id="d_may_deny_r7_out1">
          <text>"No ground under 480(a)"</text>
        </outputEntry>
        <annotationEntry>
          <text>Cal. BPC § 480(a): “only if either of the following conditions are met”</text>
        </annotationEntry>
      </rule>
    </decisionTable>
  </decision>

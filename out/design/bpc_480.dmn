    <decisionTable id="d_discipline_ground_table" hitPolicy="UNIQUE">
      <input id="d_discipline_ground_in0" label="Formal discipline">
        <inputExpression id="d_discipline_ground_in0_expr" typeRef="boolean">
          <text>formal_discipline</text>
        </inputExpression>
      </input>
      <input id="d_discipline_ground_in1" label="Cause for discipline before this board">
        <inputExpression id="d_discipline_ground_in1_expr" typeRef="boolean">

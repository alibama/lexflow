From 26854d9dad9b2ca094fbe0e1239e390895f7b204 Mon Sep 17 00:00:00 2001
From: lexflow <lexflow@example.invalid>
Date: Tue, 6 Oct 2026 18:22:09 -0400
Subject: [PATCH] Add Ollama provider (LiteLLM ollama_chat), pass temperature,
 add required targetNamespace

- Provider.OLLAMA; models addressed as ollama_chat/<model> or ollama/<model>
- endpoint from OLLAMA_API_BASE, optional OLLAMA_NUM_CTX
- temperature was accepted but never forwarded to LiteLLM
- non-pool definitions lacked targetNamespace (required by BPMN20.xsd)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/bpmn_assistant/core/enums/providers.py    |  1 +
 src/bpmn_assistant/core/llm_facade.py         |  1 +
 .../core/provider_impl/litellm_provider.py    | 21 ++++++++++++++++++-
 .../services/bpmn_xml_generator.py            |  1 +
 src/bpmn_assistant/utils/utils.py             | 12 +++++++++++
 tests/services/test_bpmn_xml_generator.py     | 12 +++++------
 6 files changed, 41 insertions(+), 7 deletions(-)

diff --git a/src/bpmn_assistant/core/enums/providers.py b/src/bpmn_assistant/core/enums/providers.py
index d4a430a..a895f57 100644
--- a/src/bpmn_assistant/core/enums/providers.py
+++ b/src/bpmn_assistant/core/enums/providers.py
@@ -4,3 +4,4 @@ from enum import Enum
 class Provider(Enum):
     OPENAI = "openai"
     ANTHROPIC = "anthropic"
+    OLLAMA = "ollama"
diff --git a/src/bpmn_assistant/core/llm_facade.py b/src/bpmn_assistant/core/llm_facade.py
index e2c4187..94305d2 100644
--- a/src/bpmn_assistant/core/llm_facade.py
+++ b/src/bpmn_assistant/core/llm_facade.py
@@ -29,6 +29,7 @@ class LLMFacade:
         supported_providers = {
             Provider.OPENAI,
             Provider.ANTHROPIC,
+            Provider.OLLAMA,
         }
         if provider not in supported_providers:
             raise ValueError(f"Unsupported LLM provider: {provider}")
diff --git a/src/bpmn_assistant/core/provider_impl/litellm_provider.py b/src/bpmn_assistant/core/provider_impl/litellm_provider.py
index 6c76083..b7b6775 100644
--- a/src/bpmn_assistant/core/provider_impl/litellm_provider.py
+++ b/src/bpmn_assistant/core/provider_impl/litellm_provider.py
@@ -1,4 +1,5 @@
 import json
+import os
 from typing import Any, Generator
 
 from litellm import completion
@@ -57,7 +58,9 @@ class LiteLLMProvider(LLMProvider):
             "model": model,
             "messages": messages,
             "max_tokens": max_tokens,
+            "temperature": temperature,
         }
+        params.update(self._ollama_params(model))
 
         if structured_output is not None or self.output_mode == OutputMode.JSON:
             params["response_format"] = {"type": "json_object"}
@@ -94,7 +97,9 @@ class LiteLLMProvider(LLMProvider):
             model=model,
             messages=messages,
             max_tokens=max_tokens,
+            temperature=temperature,
             stream=True,
+            **self._ollama_params(model),
         )
 
         for chunk in response:
@@ -114,9 +119,23 @@ class LiteLLMProvider(LLMProvider):
             else []
         )
 
+    @staticmethod
+    def _is_ollama(model: str) -> bool:
+        return model.startswith(("ollama_chat/", "ollama/"))
+
+    def _ollama_params(self, model: str) -> dict[str, Any]:
+        if not self._is_ollama(model):
+            return {}
+        params: dict[str, Any] = {"api_base": os.getenv("OLLAMA_API_BASE", "http://localhost:11434")}
+        num_ctx = os.getenv("OLLAMA_NUM_CTX")
+        if num_ctx:
+            params["num_ctx"] = int(num_ctx)
+        return params
+
     def check_model_compatibility(self, model: str) -> bool:
         return (
-            model in [m.value for m in OpenAIModels]
+            self._is_ollama(model)
+            or model in [m.value for m in OpenAIModels]
             or model in [m.value for m in AnthropicModels]
         )
 
diff --git a/src/bpmn_assistant/services/bpmn_xml_generator.py b/src/bpmn_assistant/services/bpmn_xml_generator.py
index c99c710..f9fcc4f 100644
--- a/src/bpmn_assistant/services/bpmn_xml_generator.py
+++ b/src/bpmn_assistant/services/bpmn_xml_generator.py
@@ -42,6 +42,7 @@ class BpmnXmlGenerator:
         root.set("xmlns:dc", "http://www.omg.org/spec/DD/20100524/DC")
         root.set("xmlns:di", "http://www.omg.org/spec/DD/20100524/DI")
         root.set("id", "definitions_1")
+        root.set("targetNamespace", "https://bpmn-assistant.local/processes")  # required by BPMN20.xsd
 
         # Create the process element
         process_element = ET.SubElement(root, "process")
diff --git a/src/bpmn_assistant/utils/utils.py b/src/bpmn_assistant/utils/utils.py
index 7a24a68..3742502 100644
--- a/src/bpmn_assistant/utils/utils.py
+++ b/src/bpmn_assistant/utils/utils.py
@@ -36,6 +36,9 @@ def get_llm_facade(model: str, output_mode: OutputMode = OutputMode.JSON, api_ke
     elif is_anthropic_model(model):
         api_key = api_keys.get("anthropic_api_key") or os.getenv("ANTHROPIC_API_KEY")
         provider = Provider.ANTHROPIC
+    elif is_ollama_model(model):
+        api_key = "ollama"  # local server: no key; endpoint comes from OLLAMA_API_BASE
+        provider = Provider.OLLAMA
     else:
         raise Exception("Invalid model")
 
@@ -76,6 +79,7 @@ def get_available_providers(api_keys: dict[str, str] | None = None) -> dict:
     return {
         "openai": openai_present,
         "anthropic": anthropic_present,
+        "ollama": bool(os.getenv("OLLAMA_API_BASE")),
     }
 
 
@@ -87,6 +91,14 @@ def is_anthropic_model(model: str) -> bool:
     return model in [model.value for model in AnthropicModels]
 
 
+OLLAMA_PREFIXES = ("ollama_chat/", "ollama/")
+
+
+def is_ollama_model(model: str) -> bool:
+    """Any local model served by Ollama, e.g. 'ollama_chat/qwen3.6:27b'."""
+    return model.startswith(OLLAMA_PREFIXES) and len(model.split("/", 1)[1]) > 0
+
+
 def message_history_to_string(message_history: list[MessageItem]) -> str:
     """
     Convert a message history list into a formatted string.

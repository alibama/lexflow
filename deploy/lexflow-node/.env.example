# deploy/lexflow-node/.env  (copy to .env on the node)

NODE_NAME=shop

# This node's NetBird address, from `netbird status` after joining (10.231.x.y once the
# Network Range is 10.231.0.0/16). The status endpoint binds to it and nothing else.
NODE_OVERLAY_IP=

# Native Ollama as seen from the status container (Docker's host gateway). Leave as is.
OLLAMA_URL=http://host-gateway:11434

# What the Compute page reads from /status.json
LEXFLOW_NODE_MODELS=qwen3:1.7b,qwen3:8b
LEXFLOW_NODE_ACCEPT=1          # 0 = joined but not taking work
LEXFLOW_NODE_SLOTS=1
LEXFLOW_NODE_HOURS=            # e.g. 18-08

# Only for the optional "container-overlay" profile (native package is the default on shop):
NETBIRD_CLIENT_IMAGE_TAG=0.81.3
NB_MANAGEMENT_URL=https://net.lexipedia.xyz:8443
NB_SETUP_KEY=

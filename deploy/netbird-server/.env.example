# deploy/netbird-server/.env  (copy to .env on the droplet; compose reads it for the ${...} tags)
# No secrets live here: those are in config.yaml (mode 600). This file only pins versions.

# Verified on 19 Oct 2026 (see README.md "Pinned versions").
NETBIRD_SERVER_IMAGE_TAG=0.81.3
NETBIRD_DASHBOARD_IMAGE_TAG=v2.95.0
CADDY_IMAGE_TAG=2.11.7

# Memory cap for the server container (caddy and dashboard get 64m each => 512m total).
NETBIRD_SERVER_MEM=384m
